nt';\nimport { SupportCentreComponent } from '../support-centre/support-centre.component';\nimport { SideNavComponent } from '../support-centre/layout/side-nav/side-nav.component';\nimport { VmListComponent } from '../zone-cluster/zone-cluster-details/members/vm-list/vm-list.component';\nimport { SupportService } from '../_services/all-requests/support.service';\nimport { ApiRequestService } from '../_services/api-request-utility/api-request.service';\nimport { AllServicesModule } from '../all-services/all-services.module';\nimport { MatDialogModule } from '@angular/material/dialog';\nimport { MatTableModule } from '@angular/material/table';\nimport { MatPaginatorModule } from '@angular/material/paginator';\nimport { ShelfModule } from '../shared/shelf/shelf.module';\n\n@NgModule({\n  declarations: [\n    LayoutComponent, \n    HeaderComponent, \n    SidenavComponent, \n    SwitchAccountDialogComponent, \n    MenuComponent,\n    SwitchAccountDialogComponent, \n    RedirectLoaderComponent, SwitchAccountComponent,\n    ContactComponent,\n    TopnavComponent,\n    SupportCentreComponent,\n    SideNavComponent,\n    VmListComponent,\n  ],\n  imports: [\n    CommonModule,\n    LayoutRoutingModule,\n    FormsModule,\n    ReactiveFormsModule,\n    MatMenuModule,\n    MatButtonModule,\n    MatIconModule,\n    PipesModule,\n    SharedModule,\n    MatBadgeModule,\n    MatAutocompleteModule,\n    MatFormFieldModule,\n    MatSelectModule,\n    MatInputModule,\n    MatProgressSpinnerModule,\n    MatProgressBarModule,\n    MatTooltipModule,\n    CarouselModule,\n    MatDialogModule,\n    MatTableModule,\n    MatPaginatorModule,\n    ShelfModule,\n    AllServicesModule,\n  ],\n  providers: [SupportService, ApiRequestService]\n})\nexport class LayoutModule { }\n","import { Component, OnInit } from '@angular/core';\n\n@Component({\n  selector: 'redirect-loader',\n  templateUrl: './redirect-loader.component.html',\n  styleUrls: ['./redirect-loader.component.scss']\n})\nexport class RedirectLoaderComponent implements OnInit {\n\n  constructor() { }\n\n  ngOnInit(): void {\n  }\n\n}\n","<div class=\"load-spinner\">\n    <mat-spinner [diameter]=\"60\"></mat-spinner>\n</div>","import { Component } from '@angular/core';\nimport { OwlOptions } from 'ngx-owl-carousel-o';\nimport { appConstants } from '../../../../constants/app.constants';\nimport { navigateAfterAccountSwitch } from '../../account-switch-navigation';\nimport { Router } from '@angular/router';\nimport { LocalStorageService } from '../../../_services/utility/localstorage.service';\n@Component({\n  selector: 'switch-account',\n  templateUrl: './switch-account.component.html',\n  styleUrls: ['./switch-account.component.scss'],\n  providers : [LocalStorageService]\n})\nexport class SwitchAccountComponent {\n\n  customOptions: OwlOptions = {\n    loop: false,\n    mouseDrag: false,\n    touchDrag: false,\n    pullDrag: false,\n    dots: false,\n    navSpeed: 400,\n    navText: ['', ''],\n    slideBy : 6,\n    responsive: {\n      0: {\n        items: 1\n      },\n      400: {\n        items: 2\n      },\n      576: {\n        items: 3\n      },\n      940: {\n        items: 6\n      }\n    },\n    nav: true\n  };\n  printAccounts : any = [];\n  accountInfo : any = [];\n  accountsIconUrl : string;\n  search_value : string;\n  selectedAccount:any;\n  activeImage:any={};\n  displayText:any = {};\n  supportInformation : any = {};\n  supportInformationAllign : any = [];\n  // projectAccessCheckList : any = [];\n  // accountAccessCheckList : any = [];\n  supportHead : any = ['department','first contact','escalation contact','escalation contact (II)','escalation contact (III)']\n  account_info : any;\n\n  constructor(private router : Router,private lsService : LocalStorageService){\n    // private createServices:CreateServices,private commonService: CommonService,) { \n    // this.projectAccessCheckList = ['Server','Physical Server','Load Balancer','Elastic Load Balancer','Database Cluster', 'Cluster'];\n    // this.accountAccessCheckList = ['Volume','Service Request','Database Cluster','Autoscale Configuration','K8S Cluster','MinIO Bucket','Change Request', 'Alert Dashboard','CDN Config','Nginx Cluster', 'VPC'];\n    this.accountInfo =JSON.parse(localStorage.getItem('USER_ACCOUNTS')) ;\n      this.sortAccountInfo();\n      this.printAccounts = this.accountInfo;\n\n      if(!localStorage[\"SELECTED_ACCOUNT\"]){\n        this.selectedAccount=this.accountInfo[0];\n        localStorage.setItem('SELECTED_ACCOUNT',JSON.stringify(this.selectedAccount));\n      }\n      else\n        this.selectedAccount=this.lsService.getSelectedAccount();\n\n      this.accountsIconUrl=appConstants['s3AccountsIconUrl'];\n      this.activeImage[this.selectedAccount.account_name]=true;\n      this.assignSupportInformation();\n  }\n\n  assignSupportInformation(){\n    //setting priority of department\n    this.supportInformation = this.selectedAccount?.support;\n    if(this.supportInformation && this.selectedAccount?.support_priority){\n      for(const key in this.selectedAccount?.support_priority){\n        const index = this.selectedAccount?.support_priority[key];\n        this.supportInformationAllign[index] = {[key]: this.supportInformation[key]} \n      }\n    }\n  }\n\n  // sort accounts list by account_name\n  sortAccountInfo(){\n    function compare(a, b) {\n      // Use toUpperCase() to ignore character casing\n      const accA = a.account_name.toUpperCase();\n      const accB = b.account_name.toUpperCase();\n    \n      let comparison = 0;\n      if (accA > accB) {\n        comparison = 1;\n      } else if (accA < accB) {\n        comparison = -1;\n      }\n      return comparison;\n    }\n    \n    this.accountInfo.sort(compare);\n    this.changeIconName();\n  }\n\n  changeIconName(){\n    for(let i=0;i<this.accountInfo.length;i++){\n      this.accountInfo[i].icon = this.accountInfo[i].icon ? this.accountInfo[i].icon.replace(/ +/g, \"\") : '';\n    }\n    this.printAccounts = this.accountInfo;\n  }\n\n  changeAccount(account:any){\n    if(account == true){\n      localStorage.setItem(\"SELECTED_ACCOUNT\",JSON.stringify(this.selectedAccount));\n      navigateAfterAccountSwitch();\n    }\n    else\n    {\n      this.selectedAccount=account;\n      this.activeImage={};\n      this.activeImage[account.account_name]=true;\n      this.assignSupportInformation();\n    }\n  }\n\n  searchAccount(){\n    this.printAccounts = [];\n    if(this.search_value){\n      const allAcounts = this.accountInfo;\n      allAcounts.map(element => {\n        const accName = element.account_name.toLowerCase();\n        const includeAccount = accName.includes(this.search_value.toLocaleLowerCase());\n        if(includeAccount){\n          this.printAccounts.push(element);\n        }\n      })\n    }\n    else{\n      this.printAccounts = this.accountInfo;\n    }\n  }\n\n  // in case no image found\n  callOnErr(account){\n    this.displayText[account.account_name] = true;\n  }\n\n}\n","<div class=\"account-box\">\n    <div>\n        <mat-form-field class=\"search-input\">\n            <mat-label>Search Account</mat-label>\n            <mat-icon class=\"color-grey\" matPrefix aria-hidden=\"false\" aria-label=\"search\">search</mat-icon>\n            <input matInput type=\"search\" [(ngModel)]=\"search_value\" (keyup.enter)=\"searchAccount()\">\n        </mat-form-field>\n    </div>\n    <div>\n        <owl-carousel-o [options]=\"customOptions\">\n            <ng-template carouselSlide *ngFor=\"let account of printAccounts\">\n                <div class=\"slide\">\n                    <div class=\"col-2\">\n                        <div class=\"box\" (click)=\"changeAccount(account)\" [ngClass]=\"{'activeBox': activeImage[account.account_name]}\">\n                            <img height=\"auto\"  (error)=\"callOnErr(account)\" \n                                *ngIf=\"!activeImage[account.account_name] && !displayText[account.account_name]\" width=\"auto\"\n                                src=\"{{accountsIconUrl + account.icon + '.webp'}}\" alt=\"{{account.account_name}}\">\n                            <img height=\"auto\"  (error)=\"callOnErr(account)\" width=\"auto\"\n                                *ngIf=\"activeImage[account.account_name] && !displayText[account.account_name]\" \n                                src=\"{{accountsIconUrl +  account.icon + '_active.webp'}}\" alt=\"{{account.account_name}}\">\n                            <span *ngIf=\"displayText[account.account_name]\" class=\"imagetxt\">{{account.account_name}}</span>\n                        </div>\n                    </div>\n                </div>\n            </ng-template>\n        </owl-carousel-o>\n        <div  class=\"flex justify-content-end\">\n            <button *ngIf=\"printAccounts?.length > 0\" mat-flat-button class=\"actions-btns\" color=\"primary\"\n                (click)=\"changeAccount(true)\">Switch Account\n            </button>\n        </div>\n        <div *ngIf=\"accountInfo?.length == 0\" class=\"noaccess-title\">\n            <div class=\"space-icon space-noaccess\"></div>\n            <div class=\"space-title\">\n                You do not have access to any Business.\n            </div>\n        </div>  \n        <!-- no data image -->\n        <div *ngIf=\"printAccounts?.length == 0\">\n            <div class=\"space-icon space-nodata\">nodata</div>\n            <div class=\"space-title\">No Accounts Found</div>\n        </div>\n    </div>\n</div>\n<div class=\"account-box\">\n    <div class=\"support-info\">\n        <div class=\"support-head\">SUPPORT INFORMATION</div>\n        <div *ngIf=\"supportInformation\" class=\"support-content\">\n            <div class=\"ds-flex ml-15\">\n                <div class=\"sub-head mgt-1 col-size\" *ngFor=\"let head of supportHead\">{{head}}</div>\n            </div>\n\n            <ng-container *ngFor=\"let itemAllign of supportInformationAllign\">\n            \n                <div class=\"ml-15\" *ngFor=\"let item of itemAllign | keyvalue\">\n                    <div class=\"ds-flex\">\n                        <div class=\"ds-grid col-size\">\n                            <span class=\"dets\">{{item.key}}</span>\n                            <span class=\"muted\">{{item.value['service']}}</span>\n                        </div>\n                        <div class=\"ds-grid col-size info-border\" *ngIf=\"item.value['First Contact']; else noData\">\n                            <span class=\"dets\">{{item.value['First Contact']['name'] || 'N.A'}}</span>\n                            <span class=\"muted\">{{item.value['First Contact']['mobile'] || 'N.A'}}</span>\n                        </div>\n                        <div class=\"ds-grid col-size info-border\" *ngIf=\"item.value['Escalation Contact']; else noData\">\n                            <span class=\"dets\">{{item.value['Escalation Contact']['name'] || 'N.A'}}</span>\n                            <span class=\"muted\">{{item.value['Escalation Contact']['mobile'] || 'N.A'}}</span>\n                        </div>\n                        <div class=\"ds-grid col-size info-border\" *ngIf=\"item.value['Escalation Contact 2']; else noData\">\n                            <span class=\"dets\">{{item.value['Escalation Contact 2']['name'] || 'N.A'}}</span>\n                            <span class=\"muted\">{{item.value['Escalation Contact 2']['mobile'] || 'N.A'}}</span>\n                        </div>\n                        <div class=\"ds-grid col-size info-border\" *ngIf=\"item.value['Escalation Contact 3']; else noData\">\n                            <span class=\"dets\">{{item.value['Escalation Contact 3']['name'] || 'N.A'}}</span>\n                            <span class=\"muted\">{{item.value['Escalation Contact 3']['mobile'] || 'N.A'}}</span>\n                        </div>\n                    </div>\n                </div>\n            </ng-container>\n        </div>\n        <!-- no data image -->\n        <div *ngIf=\"!supportInformation\">\n            <div class=\"space-icon space-nodata\">nodata</div>\n            <div class=\"space-title\">No Information Found</div>\n        </div>\n    </div>\n</div>\n\n<ng-template #noData>\n    <div>'N.A'</div>\n</ng-template>\n","import { NgModule } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { MatIconModule } from '@angular/material/icon';\nimport { ShelfShellComponent } from './shelf-shell.component';\n\n@NgModule({\n  declarations: [ShelfShellComponent],\n  imports: [CommonModule, MatIconModule],\n  exports: [ShelfShellComponent],\n})\nexport class ShelfModule {}\n","import { Component, Input, Output, EventEmitter } from '@angular/core';\nimport { SupportNavCategory } from '../../support-centre.component';\n\n@Component({\n  selector: 'app-side-nav',\n  templateUrl: './side-nav.component.html',\n  styleUrls: ['./side-nav.component.scss']\n})\nexport class SideNavComponent {\n\n  @Input() navCategories: SupportNavCategory[] = [];\n  @Input() activeTeamId: number | null = null;\n  @Input() activeCategoryLabel = '';\n  @Output() navChanged = new EventEmitter<number>();\n\n  selectTeam(teamId: number): void {\n    if (teamId !== this.activeTeamId) {\n      this.navChanged.emit(teamId);\n    }\n  }\n}\n","<nav class=\"sc-sidenav\">\n\n  <div class=\"sc-sidenav__brand\">\n    <span class=\"sc-sidenav__brand-grid\">\n      <span></span><span></span><span></span><span></span>\n    </span>\n    <span class=\"sc-sidenav__brand-name\">Support Center</span>\n  </div>\n\n  <div\n    *ngFor=\"let category of navCategories\"\n    class=\"sc-sidenav__group\"\n    [class.sc-sidenav__group--active]=\"category.label === activeCategoryLabel\">\n\n    <div class=\"sc-sidenav__category\">{{ category.label }}</div>\n\n    <ul class=\"sc-sidenav__list\">\n      <li\n        *ngFor=\"let team of category.teams\"\n        class=\"sc-sidenav__item sc-sidenav__item--child\"\n        [class.sc-sidenav__item--active]=\"team.teamId === activeTeamId\"\n        [matTooltip]=\"team.label\"\n        [matTooltipPosition]=\"'right'\"\n        [matTooltipShowDelay]=\"300\"\n        (click)=\"selectTeam(team.teamId)\">\n        <mat-icon class=\"sc-sidenav__item-icon\">{{ team.icon }}</mat-icon>\n        <span class=\"sc-sidenav__item-label\">{{ team.label }}</span>\n      </li>\n    </ul>\n  </div>\n\n</nav>\n","/** Known shape of a VM row from GET /api/zone-cluster/members/vms */\nexport interface VmRecord {\n  ip: string;\n  cpu: number;\n  memory: number;\n  disk_size: number;\n  build_number: string;\n  location: string;\n  created_by: string;\n  project: string;\n  environment: string;\n  created_on: string;\n  zone: string;\n  support: string;\n  status: string;\n  account_name: string;\n  account_id: number;\n  cpu_utilization?: number | null;\n  memory_utilization?: number | null;\n  server_id?: number;\n  [key: string]: string | number | null | undefined;\n}\n\nexport interface VmColumnMeta {\n  display_name: string;\n  type?: string;\n}\n\nexport interface VmFilterOption {\n  id: number;\n  name: string;\n}\n\nexport interface VmListFilterOptions {\n  accounts: VmFilterOption[];\n  projects: VmFilterOption[];\n}\n\nexport interface VmListResponse {\n  status: number;\n  data?: VmRecord[] | VmListFilterOptions;\n  total_count?: number;\n  page?: number;\n  limit?: number;\n  accounts?: VmFilterOption[];\n  projects?: VmFilterOption[];\n  dynamic_columns_map?: Record<string, string | VmColumnMeta>;\n}\n\n/** Always-visible table columns (not in column picker). */\nexport const VM_STATIC_COLUMNS = [\n  'Summary',\n  'cpu_utilization',\n  'memory_utilization',\n  'Account name',\n  'Created by',\n  // 'Status',\n] as const;\n\nexport const VM_METRIC_COLUMN_LABELS: Record<string, string> = {\n  cpu_utilization: 'Consumed CPU',\n  memory_utilization: 'Consumed Memory',\n};\n\nexport const VM_LIST_COLUMN_STORAGE_KEY = 'vmListColumn';\n\n/** Keys allowed in `dynamic_columns_map` from the VM list API. */\nexport const VM_DYNAMIC_COLUMN_KEYS = ['zone', 'project', 'environment'] as const;\n\nconst VM_FILTER_GROUP_KEY = '1';\n\nexport function parseVmListFilterOptions(\n  res: VmListResponse | VmListFilterOptions | Record<string, unknown>,\n): VmListFilterOptions {\n  if (!res || typeof res !== 'object') {\n    return { accounts: [], projects: [] };\n  }\n\n  const body = res as VmListResponse;\n  if ('accounts' in body || 'projects' in body) {\n    return {\n      accounts: Array.isArray(body.accounts) ? body.accounts : [],\n      projects: Array.isArray(body.projects) ? body.projects : [],\n    };\n  }\n\n  const nested = body.data;\n  if (nested && !Array.isArray(nested)) {\n    const opts = nested as VmListFilterOptions;\n    return {\n      accounts: Array.isArray(opts.accounts) ? opts.accounts : [],\n      projects: Array.isArray(opts.projects) ? opts.projects : [],\n    };\n  }\n\n  return { accounts: [], projects: [] };\n}\n\n/** API may return display labels as strings or { display_name, type } objects. */\nexport function normalizeVmColumnsMap(\n  map: Record<string, string | VmColumnMeta> | undefined,\n): Record<string, VmColumnMeta> {\n  const normalized: Record<string, VmColumnMeta> = {};\n  if (!map) {\n    return normalized;\n  }\n  VM_DYNAMIC_COLUMN_KEYS.forEach((key) => {\n    const value = map[key];\n    if (value == null) {\n      return;\n    }\n    if (typeof value === 'string') {\n      normalized[key] = { display_name: value, type: 'string' };\n    } else if (typeof value === 'object') {\n      normalized[key] = {\n        display_name: value.display_name ?? key,\n        type: value.type ?? 'string',\n      };\n    }\n  });\n  return normalized;\n}\n\n/** Column keys available in the \"choose fields\" popover. */\nexport function getVmSelectableColumnKeys(\n  columnsMap: Record<string, VmColumnMeta>,\n): string[] {\n  return VM_DYNAMIC_COLUMN_KEYS.filter((key) => columnsMap[key] != null);\n}\n\n/** NewFilters nested `{ \"1\": [ids] }` → flat `number[]` for VM list API. */\nfunction flattenNestedIds(value: unknown): number[] | undefined {\n  if (value == null) {\n    return undefined;\n  }\n  if (Array.isArray(value)) {\n    const ids = value\n      .map((id) => Number(id))\n      .filter((id) => !Number.isNaN(id));\n    return ids.length > 0 ? ids : undefined;\n  }\n  if (typeof value === 'object') {\n    const ids: number[] = [];\n    Object.values(value as Record<string, unknown>).forEach((entry) => {\n      if (!Array.isArray(entry)) {\n        return;\n      }\n      entry.forEach((id) => {\n        const num = Number(id);\n        if (!Number.isNaN(num)) {\n          ids.push(num);\n        }\n      });\n    });\n    const unique = [...new Set(ids)];\n    return unique.length > 0 ? unique : undefined;\n  }\n  return undefined;\n}\n\n/** Maps popover filter shape to VM list API filter contract. */\nexport function buildVmListFilterPayload(\n  filterParams: Record<string, unknown>,\n): Record<string, unknown> {\n  const filter: Record<string, unknown> = { ...filterParams };\n\n  const projectIds = flattenNestedIds(filter['project']);\n  const accountIds = flattenNestedIds(filter['account']);\n  if (projectIds) {\n    filter['project'] = projectIds;\n  } else {\n    delete filter['project'];\n  }\n  delete filter['account'];\n  if (accountIds) {\n    filter['account_id'] = accountIds;\n  } else {\n    delete filter['account_id'];\n  }\n\n  if (Array.isArray(filter['search'])) {\n    const search = (filter['search'] as unknown[])\n      .map((v) => String(v).trim())\n      .filter(Boolean);\n    if (search.length > 0) {\n      filter['search'] = search;\n    } else {\n      delete filter['search'];\n    }\n  }\n\n  delete filter['column'];\n\n  return filter;\n}\n\nexport function buildVmFilterValues(\n  options: VmListFilterOptions,\n): Record<string, unknown> {\n  const accountList = {\n    [VM_FILTER_GROUP_KEY]: {\n      name: 'Accounts',\n      account: options.accounts,\n    },\n  };\n  const projectList = {\n    [VM_FILTER_GROUP_KEY]: {\n      name: 'Projects',\n      project_list: options.projects,\n    },\n  };\n  return {\n    account: {\n      list: [VM_FILTER_GROUP_KEY],\n      data: accountList,\n      filterKey: 'account',\n      group: 'accountList',\n      respKey: 'account',\n    },\n    project: {\n      list: [VM_FILTER_GROUP_KEY],\n      data: projectList,\n      filterKey: 'project_list',\n      group: 'projectList',\n      respKey: 'project',\n    },\n  };\n}\n\n/** Filter keys exposed in the vm-list Filters popover */\nexport const VM_FILTER_NAMES = [\n  'search',\n  'project',\n  'env_type',\n  'support_type',\n  'account',\n] as const;\n","import {\n  Component,\n  Input,\n  OnChanges,\n  OnDestroy,\n  OnInit,\n  SimpleChanges,\n} from '@angular/core';\nimport { PageEvent } from '@angular/material/paginator';\nimport { MatDialog } from '@angular/material/dialog';\nimport { Router } from '@angular/router';\nimport { Observable, Subject, Subscription } from 'rxjs';\nimport { ZoneClusterService } from 'src/app/_services/all-requests/zone-cluster.service';\nimport { CsvDownloadService } from 'src/app/_services/utility/csv-download.service';\nimport { LocalStorageService } from 'src/app/_services/utility/localstorage.service';\nimport { NotificationService } from 'src/app/_services/utility/notification.service';\nimport { Popover } from 'src/app/_services/utility/popover.service';\nimport { ConfirmDialogComponent } from 'src/app/shared/confirm-dialog/confirm-dialog.component';\nimport { FilterComponent } from 'src/app/shared/filter/filter.component';\nimport { ShelfService } from 'src/app/shared/shelf/shelf.service';\nimport { ShelfCancellable } from 'src/app/shared/shelf/shelf.models';\nimport { ACCOUNT_INFO, SELECTED_ACCOUNT } from 'src/constants/local.storage';\nimport { NewFiltersComponent } from 'src/app/shared/new-filters/new-filters.component';\nimport { appConstants } from 'src/constants/app.constants';\nimport {\n  VmListResponse,\n  VmRecord,\n  VmColumnMeta,\n  VM_STATIC_COLUMNS,\n  VM_METRIC_COLUMN_LABELS,\n  VM_LIST_COLUMN_STORAGE_KEY,\n  buildVmFilterValues,\n  buildVmListFilterPayload,\n  getVmSelectableColumnKeys,\n  normalizeVmColumnsMap,\n  parseVmListFilterOptions,\n  VM_FILTER_NAMES,\n} from '../../../_models/vm-list.model';\nimport { NavigationStateService } from 'src/app/_services/utility/navigation-state.service';\n\n@Component({\n  selector: 'app-vm-list',\n  templateUrl: './vm-list.component.html',\n  styleUrls: ['./vm-list.component.scss'],\n  providers: [\n    ZoneClusterService,\n    CsvDownloadService,\n    NotificationService,\n    Popover,\n    LocalStorageService,\n  ],\n})\nexport class VmListComponent implements OnInit, OnChanges, OnDestroy, ShelfCancellable {\n  @Input() member: any;\n  /** Zone cluster display name from parent route (`ip` query param). */\n  @Input() zoneClusterName = '';\n\n  loading = false;\n  refreshing = false;\n  exportSpin = false;\n  error: string | null = null;\n  vmList: VmRecord[] = [];\n  totalCount = 0;\n\n  readonly metricColumnLabels = VM_METRIC_COLUMN_LABELS;\n\n  staticDisplayedColumns: string[] = [...VM_STATIC_COLUMNS];\n  columnsTypeMap: Record<string, VmColumnMeta> = {};\n  dynamicDisplayedColumns: string[] = [];\n  displayedColumns: string[] = [...VM_STATIC_COLUMNS, 'column'];\n  selectedColumn: string[] = [];\n  chooseColumnList: string[] = [];\n\n  currentPage = 0;\n  pageParams = {\n    pageSize: 20,\n    pageSizeOptions: appConstants.pagination.pageSizeOptions,\n  };\n\n  filterParams: Record<string, unknown> = {};\n  appliedFilters: Record<string, unknown> = {};\n  filterValues: Record<string, unknown> = {};\n  filterCount = 0;\n  filterGroups = {\n    filters: [...VM_FILTER_NAMES],\n    column: ['column'],\n  };\n  filterNamesMap: Record<string, string> = {\n    search: 'IP Address',\n    project: 'Project',\n    env_type: 'Env',\n    support_type: 'Support',\n    account: 'Account',\n    column: 'Column',\n  };\n  accountType = 'server';\n  sortParams: { sort_by?: string; sort_order?: string } = {};\n\n  private listRequestSub?: Subscription;\n  private exportRequestSub?: Subscription;\n  private filterOptionsSub?: Subscription;\n\n  constructor(\n    private zoneClusterService: ZoneClusterService,\n    private csvDownloadService: CsvDownloadService,\n    private notificationService: NotificationService,\n    private popover: Popover,\n    private lsService: LocalStorageService,\n    private dialog: MatDialog,\n    private router: Router,\n    private shelf: ShelfService,\n    private navState: NavigationStateService,\n  ) {}\n\n  ngOnInit(): void {\n    this.getFinalColumns();\n  }\n\n  ngOnChanges(changes: SimpleChanges): void {\n    if (changes['member'] && this.member) {\n      this.currentPage = 0;\n      this.sortParams = {};\n      this.loadVmList();\n    }\n  }\n\n  ngOnDestroy(): void {\n    this.cancelShelfRequests();\n  }\n\n  cancelShelfRequests(): void {\n    this.listRequestSub?.unsubscribe();\n    this.listRequestSub = undefined;\n    this.exportRequestSub?.unsubscribe();\n    this.exportRequestSub = undefined;\n    this.filterOptionsSub?.unsubscribe();\n    this.filterOptionsSub = undefined;\n    this.loading = false;\n    this.exportSpin = false;\n    this.refreshing = false;\n  }\n\n  changePage(event: PageEvent): void {\n    this.currentPage = event.pageIndex;\n    this.pageParams.pageSize = event.pageSize;\n    this.loadVmList();\n  }\n\n  refreshList(): void {\n    if (this.loading || this.refreshing) {\n      return;\n    }\n    this.loadVmList(true);\n  }\n\n  showFilters(origin: HTMLElement): void {\n    const ip = this.getKvmHostIp();\n    if (!ip) {\n      return;\n    }\n\n    const filterOptionsUpdate$ = new Subject<Record<string, unknown>>();\n    const popoverRef = this.popover.open({\n      origin,\n      content: NewFiltersComponent,\n      data: {\n        displayNames: this.filterNamesMap,\n        filterNames: this.filterGroups.filters,\n        filterValues: this.filterValues,\n        appliedFilters: this.appliedFilters,\n        accountType: this.accountType,\n        filterOptionsUpdate$,\n      },\n    });\n\n    popoverRef.afterClosed$.subscribe(() => {\n      filterOptionsUpdate$.complete();\n    });\n\n    popoverRef.actionPerformed$.subscribe((res) => {\n      Object.assign(this.appliedFilters, res);\n      this.filterCount = this.getFilterAppliedCount(this.filterGroups.filters);\n      this.applyFilter(res);\n    });\n\n    this.filterOptionsSub?.unsubscribe();\n    this.filterOptionsSub = this.loadVmFilterOptions().subscribe({\n      next: (res) => {\n        const nested = buildVmFilterValues(parseVmListFilterOptions(res));\n        this.filterValues = { ...this.filterValues, ...nested };\n        filterOptionsUpdate$.next(nested);\n      },\n      error: (err) => {\n        filterOptionsUpdate$.complete();\n        this.notificationService.notify(err);\n      },\n    });\n  }\n\n  showColumnFilter(origin: HTMLElement, event: Event): void {\n    event.stopPropagation();\n    const popoverRef = this.popover.open({\n      origin,\n      content: FilterComponent,\n      data: {\n        displayNames: { column: 'Column' },\n        filterNames: this.filterGroups.column,\n        filterValues: this.filterValues,\n        appliedFilters: this.appliedFilters,\n        columnsTypeMap: this.columnsTypeMap,\n        noClear: true,\n      },\n    });\n    popoverRef.actionPerformed$.subscribe((res) => {\n      Object.assign(this.appliedFilters, res);\n      this.selectedColumn = (res['column'] as string[]) ?? [];\n      localStorage.setItem(\n        VM_LIST_COLUMN_STORAGE_KEY,\n        this.selectedColumn.join(','),\n      );\n      this.getFinalColumns();\n    });\n  }\n\n  applyFilter(params: Record<string, unknown>): void {\n    this.filterParams = params;\n    this.currentPage = 0;\n    this.sortParams = {};\n    this.loadVmList();\n  }\n\n  columnList(_keys: string[]): void {\n    this.chooseColumnList = getVmSelectableColumnKeys(this.columnsTypeMap);\n    this.filterValues['column'] = this.chooseColumnList;\n\n    const stored = localStorage.getItem(VM_LIST_COLUMN_STORAGE_KEY);\n    const savedColumns = stored\n      ? stored.split(',').map((c) => c.trim()).filter(Boolean)\n      : [];\n\n    if (savedColumns.length > 0) {\n      this.appliedFilters['column'] = savedColumns.filter((colName) =>\n        this.chooseColumnList.includes(colName),\n      );\n    } else {\n      this.appliedFilters['column'] = [];\n    }\n\n    this.selectedColumn = this.appliedFilters['column'] as string[];\n    this.getFinalColumns();\n  }\n\n  getFinalColumns(): void {\n    this.dynamicDisplayedColumns = [];\n    this.selectedColumn.forEach((key) => {\n      if (this.staticDisplayedColumns.indexOf(key) === -1) {\n        this.dynamicDisplayedColumns.push(key);\n      }\n    });\n    this.displayedColumns = [\n      ...this.staticDisplayedColumns,\n      ...this.dynamicDisplayedColumns,\n      'column',\n    ];\n  }\n\n  formatMetricValue(value: unknown): string {\n    if (value == null || value === '' || Number.isNaN(Number(value))) {\n      return '-';\n    }\n    return `${Number(value).toLocaleString(undefined, {\n      minimumFractionDigits: 0,\n      maximumFractionDigits: 2,\n    })}%`;\n  }\n\n  private getVmFilterForApi(): Record<string, unknown> {\n    return this.navState.cleanFilterObject(\n      buildVmListFilterPayload(this.filterParams),\n    );\n  }\n\n  private buildVmRequestParams(\n    extras: Record<string, unknown> = {},\n  ): { ip: string; filter?: string } & Record<string, unknown> {\n    const ip = this.getKvmHostIp();\n    const params: { ip: string; filter?: string } & Record<string, unknown> = {\n      ip,\n      ...extras,\n    };\n    const filterObj = this.getVmFilterForApi();\n    if (Object.keys(filterObj).length > 0) {\n      params.filter = JSON.stringify(filterObj);\n    }\n    return params;\n  }\n\n  private loadVmFilterOptions(): Observable<VmListResponse> {\n    return this.zoneClusterService.getVmList({\n      ...this.buildVmRequestParams({ return_filters: true }),\n    });\n  }\n\n  private getFilterAppliedCount(names: string[]): number {\n    let counter = 0;\n    names.forEach((name) => {\n      const value = this.appliedFilters[name];\n      if (!value) {\n        return;\n      }\n      if (name === 'project' || name === 'account') {\n        const nested = value as Record<string, number[]>;\n        Object.keys(nested).forEach((key) => {\n          const selected = nested[key];\n          if (Array.isArray(selected)) {\n            counter += selected.length;\n          }\n        });\n      } else if (name === 'search') {\n        const searchArr = value as string[];\n        if (searchArr[0]) {\n          counter += 1;\n        }\n      } else if (Array.isArray(value)) {\n        counter += value.length;\n      }\n    });\n    return counter;\n  }\n\n  trackByColumn = (_index: number, column: string): string => column;\n\n  toggleSort(sort_by: string, sort_order: string): void {\n    if (\n      this.sortParams.sort_by === sort_by &&\n      this.sortParams.sort_order === sort_order\n    ) {\n      this.sortParams = {};\n    } else {\n      this.sortParams = { sort_by, sort_order };\n    }\n    this.currentPage = 0;\n    this.loadVmList();\n  }\n\n  private loadVmList(refresh = false): void {\n    const ip = this.getKvmHostIp();\n    if (!ip) {\n      this.error = 'KVM host IP is missing for this member.';\n      this.resetTable();\n      return;\n    }\n\n    const listExtras: Record<string, unknown> = {\n      limit: this.pageParams.pageSize,\n      page: this.currentPage + 1,\n      metrics: true,\n    };\n    if (Object.keys(this.sortParams).length > 0) {\n      listExtras.sort_by = this.sortParams.sort_by;\n      listExtras.sort_order = this.sortParams.sort_order;\n    }\n\n    const params = {\n      ...this.buildVmRequestParams(listExtras),\n    };\n    this.listRequestSub?.unsubscribe();\n    if (refresh) {\n      this.refreshing = true;\n    } else {\n      this.loading = true;\n      this.error = null;\n      this.resetTable();\n    }\n\n    this.listRequestSub = this.zoneClusterService.getVmList(params).subscribe(\n      (res: VmListResponse) => {\n        if (res?.status) {\n          this.vmList = Array.isArray(res.data) ? res.data : [];\n          this.totalCount = res.total_count ?? this.vmList.length;\n          this.columnsTypeMap = normalizeVmColumnsMap(res.dynamic_columns_map);\n          this.columnList(Object.keys(this.columnsTypeMap));\n        } else {\n          this.error = 'Failed to load virtual machines.';\n        }\n        this.loading = false;\n        this.refreshing = false;\n        this.listRequestSub = undefined;\n      },\n      (err) => {\n        this.error =\n          typeof err === 'string' ? err : 'Failed to load virtual machines';\n        this.loading = false;\n        this.refreshing = false;\n        this.listRequestSub = undefined;\n      },\n    );\n  }\n\n  private resetTable(): void {\n    this.vmList = [];\n    this.totalCount = 0;\n    this.dynamicDisplayedColumns = [];\n    this.getFinalColumns();\n  }\n\n  getServerDetailsUrl(serverId: number): string {\n    const params = new URLSearchParams({\n      tabindex: 'monitoring',\n      id: String(serverId),\n    });\n    return `/dashboard/server/server-details?${params.toString()}`;\n  }\n\n  onServerIpClick(event: MouseEvent, row: VmRecord): void {\n    if (!row.server_id) {\n      event.preventDefault();\n      return;\n    }\n    if (event.ctrlKey || event.metaKey || event.shiftKey || event.button === 1) {\n      return;\n    }\n    event.preventDefault();\n\n    if (!this.needsAccountSwitch(row)) {\n      this.navigateToServer(row.server_id);\n      return;\n    }\n\n    const targetAccount = this.getRowAccount(row);\n    if (!targetAccount) {\n      this.notificationService.notify(\n        'Unable to switch account for this server.',\n      );\n      return;\n    }\n\n    this.openSwitchAccountDialog(row, targetAccount);\n  }\n\n  private needsAccountSwitch(row: VmRecord): boolean {\n    const current = this.lsService.getSelectedAccount();\n    if (!current?.account_id || row.account_id == null) {\n      return false;\n    }\n    return Number(row.account_id) !== Number(current.account_id);\n  }\n\n  private getRowAccount(\n    row: VmRecord,\n  ): { account_id: number; account_name: string } | null {\n    if (row.account_id == null) {\n      return null;\n    }\n    const accountList = JSON.parse(localStorage.getItem(ACCOUNT_INFO) || '[]');\n    const match = accountList.find(\n      (acc: { account_id: number }) =>\n        Number(acc.account_id) === Number(row.account_id),\n    );\n    if (!match) {\n      return null;\n    }\n    return {\n      account_id: match.account_id,\n      account_name: match.account_name,\n    };\n  }\n\n  private openSwitchAccountDialog(\n    row: VmRecord,\n    targetAccount: { account_id: number; account_name: string },\n  ): void {\n    const dialogRef = this.dialog.open(ConfirmDialogComponent, {\n      panelClass: 'sm-dialog',\n      width: '600px',\n      data: {\n        title: 'Switch Account',\n        modalContent: `Your Selected Account will be switched to ${targetAccount.account_name}`,\n      },\n    });\n\n    dialogRef.componentInstance.confirmAction.subscribe(() => {\n      const accountList = JSON.parse(localStorage.getItem(ACCOUNT_INFO) || '[]');\n      const accObj = accountList.find(\n        (acc: { account_id: number }) =>\n          Number(acc.account_id) === Number(targetAccount.account_id),\n      );\n      if (accObj) {\n        localStorage.setItem(SELECTED_ACCOUNT, JSON.stringify(accObj));\n      } else {\n        this.lsService.switchAccount(targetAccount.account_id);\n      }\n      dialogRef.close();\n      this.navigateToServer(row.server_id);\n    });\n  }\n\n  private navigateToServer(serverId: number): void {\n    this.shelf.close({ fromHistory: true });\n    this.router.navigateByUrl(this.getServerDetailsUrl(serverId));\n  }\n\n  getExportFilename(): string {\n    const host = 'vm-list';\n    const date = new Date();\n    return `${host}-${date.toISOString().split('T')[0]}-${date.toISOString().split('T')[1].split('.')[0]}`;\n  }\n\n  getKvmHostIp(): string {\n    if (!this.member) {\n      return '';\n    }\n    const raw = this.member.kvm_host ?? this.member[' kvm_host'] ?? '';\n    return String(raw).trim();\n  }\n\n  getSummaryTooltip(row: VmRecord): string {\n    const cpu = row['cpu'] ?? '-';\n    const memory = row['memory'] ?? '-';\n    const disk = row['disk_size'] ?? '-';\n    const build = row['build_number'] ?? '-';\n    return `${cpu} CPU / ${memory} GB / ${disk} GB / ${build}`;\n  }\n\n  exportToCsv(): void {\n    const ip = this.getKvmHostIp();\n    if (!ip || this.exportSpin) {\n      return;\n    }\n\n    this.exportRequestSub?.unsubscribe();\n    this.exportSpin = true;\n    const params = this.buildVmRequestParams();\n\n    this.exportRequestSub = this.zoneClusterService.exportVmList(params).subscribe(\n      (data) => {\n        if (data) {\n          this.csvDownloadService.textToCsv(data, this.getExportFilename());\n        }\n        this.exportSpin = false;\n        this.exportRequestSub = undefined;\n      },\n      (err) => {\n        this.notificationService.notify(err);\n        this.exportSpin = false;\n        this.exportRequestSub = undefined;\n      },\n    );\n  }\n}\n","<div class=\"vm-list\" *ngIf=\"member\">\n  <div class=\"vm-list__header\">\n    <h2 class=\"vm-list__title\">KVM Host — {{ getKvmHostIp() || \"-\" }}</h2>\n    <p class=\"vm-list__subtitle text-muted\">\n      Virtual machines connected to this KVM host\n      <span *ngIf=\"totalCount > 0\">({{ totalCount }})</span>\n    </p>\n  </div>\n\n  <div\n    class=\"filters-section vm-list__filters\"\n    *ngIf=\"(!loading || refreshing) && !error\"\n  >\n    <button\n      mat-stroked-button\n      class=\"filter-button vm-list__refresh\"\n      [disabled]=\"loading || refreshing\"\n      (click)=\"refreshList()\"\n    >\n      <mat-spinner *ngIf=\"refreshing\" [diameter]=\"16\"></mat-spinner>\n      <span *ngIf=\"!refreshing\" class=\"material-icons\">refresh</span>\n      {{ refreshing ? \"Refreshing\" : \"Refresh\" }}\n    </button>\n    <span #vmListFilters>\n      <button\n        mat-stroked-button\n        [ngClass]=\"{ applied: filterCount > 0 }\"\n        (click)=\"showFilters(vmListFilters)\"\n        class=\"filter-button\"\n      >\n        <span class=\"material-icons\">filter_alt</span>\n        Filters\n        <span\n          *ngIf=\"filterCount > 0\"\n          [matBadge]=\"filterCount\"\n          matBadgePosition=\"above after\"\n          matBadgeColor=\"warn\"\n          class=\"filter-counter\"\n        ></span>\n      </button>\n    </span>\n  </div>\n\n  <div class=\"responsive-table vm-list__table\">\n    <table\n      class=\"table-hover\"\n      mat-table\n      [dataSource]=\"vmList\"\n      *ngIf=\"!loading && !error && vmList.length > 0\"\n    >\n      <ng-container matColumnDef=\"Summary\">\n        <th mat-header-cell *matHeaderCellDef>Summary</th>\n        <td mat-cell *matCellDef=\"let element\">\n          <div class=\"summary_main\">\n            <div>\n              <a\n                *ngIf=\"element.server_id; else vmIpPlain\"\n                class=\"link-text ip-text-color-highlight\"\n                [href]=\"getServerDetailsUrl(element.server_id)\"\n                (click)=\"onServerIpClick($event, element)\"\n              >\n                {{ element.ip || \"-\" }}\n              </a>\n              <ng-template #vmIpPlain>\n                <span class=\"ip-text-color-highlight\">{{\n                  element.ip || \"-\"\n                }}</span> </ng-template\n              ><br />\n              <span\n                class=\"text-underline-content\"\n                [matTooltip]=\"getSummaryTooltip(element)\"\n              >\n                {{ element.cpu || \"-\" }} CPU / {{ element.memory || \"-\" }} GB /\n                {{ element.disk_size || \"-\" }} GB /\n                {{ (element.build_number | truncate: 12 : true) || \"-\" }}\n              </span>\n            </div>\n          </div>\n        </td>\n      </ng-container>\n\n      <ng-container matColumnDef=\"Created by\">\n        <th mat-header-cell *matHeaderCellDef>Created by</th>\n        <td mat-cell *matCellDef=\"let element\">\n          <span class=\"text-color-highlight\">{{\n            element.created_by || \"-\"\n          }}</span\n          ><br />\n          <span class=\"text-underline-content\">{{\n            element.created_on || \"-\"\n          }}</span>\n        </td>\n      </ng-container>\n\n      <ng-container matColumnDef=\"Account name\">\n        <th mat-header-cell *matHeaderCellDef>Account name</th>\n        <td\n          mat-cell\n          *matCellDef=\"let element\"\n          [matTooltip]=\"element.account_name\"\n        >\n          <span class=\"text-color-highlight\">{{\n            element.account_name || \"-\"\n          }}</span>\n        </td>\n      </ng-container>\n\n      <!-- <ng-container matColumnDef=\"Status\">\n                <th mat-header-cell *matHeaderCellDef>Status</th>\n                <td mat-cell *matCellDef=\"let element\">\n                    <span class=\"text-color-highlight\">{{ element.status || '-' }}</span>\n                </td>\n            </ng-container> -->\n\n      <ng-container matColumnDef=\"cpu_utilization\">\n        <th mat-header-cell *matHeaderCellDef>\n          <span class=\"sorting-header\">\n            {{ metricColumnLabels.cpu_utilization }}\n            <span class=\"sorting-icon\">\n              <span\n                class=\"arrow-up\"\n                [ngClass]=\"{ active: sortParams.sort_by === 'cpu_utilization' && sortParams.sort_order === 'asc' }\"\n                (click)=\"toggleSort('cpu_utilization', 'asc')\"\n              ></span>\n              <span\n                class=\"arrow-down\"\n                [ngClass]=\"{ active: sortParams.sort_by === 'cpu_utilization' && sortParams.sort_order === 'desc' }\"\n                (click)=\"toggleSort('cpu_utilization', 'desc')\"\n              ></span>\n            </span>\n          </span>\n        </th>\n        <td mat-cell *matCellDef=\"let element\" class=\"text-align-right\">\n          <div class=\"progress-bar-wrapper\">\n            <mat-progress-bar\n              class=\"progress-sm progress-md\"\n              [value]=\"element.cpu_utilization || 0\"\n              [matTooltip]=\"(element.cpu_utilization || 0) + '%'\"\n              [matTooltipPosition]=\"'right'\"\n            >\n            </mat-progress-bar>\n            {{ element.cpu_utilization || 0 }}%\n          </div>\n        </td>\n      </ng-container>\n\n      <ng-container matColumnDef=\"memory_utilization\">\n        <th mat-header-cell *matHeaderCellDef>\n          <span class=\"sorting-header\">\n            {{ metricColumnLabels.memory_utilization }}\n            <span class=\"sorting-icon\">\n              <span\n                class=\"arrow-up\"\n                [ngClass]=\"{ active: sortParams.sort_by === 'memory_utilization' && sortParams.sort_order === 'asc' }\"\n                (click)=\"toggleSort('memory_utilization', 'asc')\"\n              ></span>\n              <span\n                class=\"arrow-down\"\n                [ngClass]=\"{ active: sortParams.sort_by === 'memory_utilization' && sortParams.sort_order === 'desc' }\"\n                (click)=\"toggleSort('memory_utilization', 'desc')\"\n              ></span>\n            </span>\n          </span>\n        </th>\n        <td mat-cell *matCellDef=\"let element\" class=\"text-align-right\">\n          <div class=\"progress-bar-wrapper\">\n            <mat-progress-bar\n              class=\"progress-sm progress-md\"\n              [value]=\"element.memory_utilization || 0\"\n              [matTooltip]=\"(element.memory_utilization || 0) + '%'\"\n              [matTooltipPosition]=\"'right'\"\n            >\n            </mat-progress-bar>\n            {{ element.memory_utilization || 0 }}%\n          </div>\n        </td>\n      </ng-container>\n\n      <ng-container\n        *ngFor=\"let column of dynamicDisplayedColumns; trackBy: trackByColumn\"\n      >\n        <ng-container [matColumnDef]=\"column\">\n          <th class=\"nouppercase\" mat-header-cell *matHeaderCellDef>\n            {{ columnsTypeMap[column]?.display_name }}\n          </th>\n          <td\n            mat-cell\n            *matCellDef=\"let row\"\n            [ngClass]=\"{\n              'text-align-right': columnsTypeMap[column]?.type === 'number'\n            }\"\n            [matTooltip]=\"row[column]\"\n            [matTooltipPosition]=\"'right'\"\n          >\n            {{ (row[column] | truncate: 20) || \"-\" }}\n          </td>\n        </ng-container>\n      </ng-container>\n\n      <ng-container matColumnDef=\"column\">\n        <th mat-header-cell *matHeaderCellDef>\n          <span\n            #vmColumnFilter\n            class=\"material-icons-outlined dots-icon\"\n            (click)=\"showColumnFilter(vmColumnFilter, $event)\"\n            matTooltip=\"Choose more fields\"\n            >more_vert</span\n          >\n        </th>\n        <td mat-cell *matCellDef=\"let row\"></td>\n      </ng-container>\n\n      <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\n      <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\n    </table>\n\n    <div class=\"load-spinner\" *ngIf=\"loading\">\n      <mat-spinner [diameter]=\"60\"></mat-spinner>\n    </div>\n\n    <div class=\"no-data-found\" *ngIf=\"error && !loading\">\n      <div class=\"space-icon space-server\"></div>\n      <div class=\"space-title\">{{ error }}</div>\n    </div>\n\n    <div\n      class=\"no-data-found\"\n      *ngIf=\"!loading && !error && vmList.length === 0\"\n    >\n      <div class=\"space-icon space-server\"></div>\n      <div class=\"space-title\">No virtual machines found</div>\n    </div>\n  </div>\n\n  <div class=\"footer\" *ngIf=\"!loading && !error && totalCount > 0\">\n    <span\n      [ngClass]=\"{ disable: exportSpin }\"\n      class=\"badge-red1 export\"\n      (click)=\"exportToCsv()\"\n    >\n      Export<mat-spinner *ngIf=\"exportSpin\" [diameter]=\"13\"></mat-spinner>\n    </span>\n    <mat-paginator\n      class=\"float-right\"\n      [length]=\"totalCount\"\n      [pageIndex]=\"currentPage\"\n      [pageSize]=\"pageParams.pageSize\"\n      [pageSizeOptions]=\"pageParams.pageSizeOptions\"\n      (page)=\"changePage($event)\"\n      showFirstLastButtons\n    >\n    </mat-paginator>\n  </div>\n</div>\n"],"names":[],"sourceRoot":"webpack:///","x_google_ignoreList":[]}