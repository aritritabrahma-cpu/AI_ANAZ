vice.makeGetRequest({\n            path: '/api/elb/algorithm',\n            params: params\n        })\n    }\n\n    updateSettings(params) {\n        return this.apiRequestService.makePutRequest({\n            path: '/api/elb/settings',\n            params: params\n        })\n    }\n\n    updateServerOnLB(params) {\n        return this.apiRequestService.makePutRequest({\n            path: '/api/elb/server',\n            params: params\n        })\n    }\n\n    addServer(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/server',\n            params: params\n        })\n    }\n\n    deleteserver(params) {\n        return this.apiRequestService.makeDeleteRequest({\n            path: '/api/elb/server',\n            params: params\n        })\n    }\n\n    deletelb(params) {\n        return this.apiRequestService.makeDeleteRequest({\n            path: '/api/elb/lb',\n            params: params\n        })\n    }\n    \n    getTls(params?) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/tls',\n            params: params\n        })\n    }\n\n    getVpcNetworkData(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/vpc_network',\n            params: params\n        })\n    }\n\n    rollbackElb(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/revert',\n            params: params\n        })\n    }\n\n    getLBEvents(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/event_logs',\n            params: params\n        })\n    }\n\n    upgradeElb(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/upgrade',\n            params: params\n        })\n    }\n\n    exportToCsv(params){\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/export_csv',\n            params: params\n        })\n    }\n\n    getLBServerStatus(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/status',\n            params: params\n        })\n    }\n\n    getDrMap(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/dr_map',\n            params: params\n        })\n    }\n\n    migrateToELB(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/migrate',\n            params: params\n        })\n    }\n\n    marklegacy(params) {\n        return this.apiRequestService.makePutRequest({\n            path: '/api/elb/lb',\n            params: params\n        })\n    }\n\n    getWAFData(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/waf',\n            params: params\n        })\n    }\n\n    updateWAF(params) {\n        return this.apiRequestService.makePutRequest({\n            path: '/api/elb/waf',\n            params: params\n        })\n    }\n\n    createPool(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/loadbalancer/pool',\n            params: params\n        })\n    }\n\n    getResManagementData(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/lb_response_rules',\n            params: params\n        })\n    }\n\n    createResponseRule(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/lb_response_rules',\n            params: params\n        })\n    }\n\n    deleteResponseRule(params){\n        return this.apiRequestService.makeDeleteRequest({\n            path: '/api/elb/lb_response_rules',\n            params: params \n        })\n    }\n\n    getRateLimitingData(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/conn_rate',\n            params: params\n        })\n    }\n\n    createRateLimit(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/conn_rate',\n            params: params\n        })\n    }\n\n    deleteRateLimit(params){\n        return this.apiRequestService.makeDeleteRequest({\n            path: '/api/elb/conn_rate',\n            params: params \n        })\n    }\n\n    getHeadersData(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/header',\n            params: params\n        })\n    }\n\n    deleteHeader(params) {\n        return this.apiRequestService.makeDeleteRequest({\n            path: '/api/elb/header',\n            params: params\n        })\n    }\n\n    createHeader(params) {\n        return this.apiRequestService.makePostRequest({\n            path: '/api/elb/header',\n            params: params\n        })\n    }\n\n    tagDependencyData(params) {\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/elb/tag_group',\n            params: params\n        })\n    }\n}\n","import { Injectable } from '@angular/core';\nimport { ApiRequestService } from '../api-request-utility/api-request.service';\n\n\n@Injectable()\nexport class PhysicalServerService {\n\n\tconstructor(private apiRequestService: ApiRequestService,){\n\t}\n\n\tgetServerList(params){\n\t\treturn this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/physical/device',\n            params: params\n        });\n    }\n\n    deleteDevice(params: any){\n        return this.apiRequestService.makeDeleteRequest({\n            path: '/api/physical-server/physical/device',\n            params,\n        })\n    }\n\t\n\tgetServerDelete(param){\n\t\treturn this.apiRequestService.makeDeleteRequest({\n\t\t\tpath: '/api/servers/server',\n\t\t\tparams: param\n        });\n    }\n\n    getMiscellaneousData(params){\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/miscellaneous',\n            params: params\n        });\n    }\n\n    getGraphMetrics(params){\n\t\treturn this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/graph-metrics',\n            params: params\n        })\n    }\n\n    getGraphData(params){\n\t\treturn this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/graph-data',\n            params: params\n        })\n\t}\n\n    updateDeviceProject(params){\n        return this.apiRequestService.makePostRequest({\n            path: '/api/physical-server/project',\n            params: params\n        });\n    }\n\n    updateDeviceTags(params){\n        return this.apiRequestService.makePostRequest({\n            path: '/api/physical-server/tags',\n            params: params\n        });\n    }\n\n    updateDeviceServices(params){\n        return this.apiRequestService.makePostRequest({\n            path: '/api/physical-server/services',\n            params: params\n        });\n    }\n\n    updateDeviceMiscellaneous(params){\n        return this.apiRequestService.makePostRequest({\n            path: '/api/physical-server/miscellaneous',\n            params: params\n        });\n    }\n\n    exportToCsv(params){\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/export_csv',\n            params: params\n        })\n    }\n\n    markMaintenance(params){\n        return this.apiRequestService.makePutRequest({\n            path: '/api/physical-server/maintenance',\n            params: params\n        })\n    }\n\n    getNetworkData(params){\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/network',\n            params: params\n        })\n    }\n\n    getIPAddress(params){\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/ip-address',\n            params: params\n        })\n    }\n\n    addIPAddress(params){\n        return this.apiRequestService.makePostRequest({\n            path: '/api/physical-server/ip-address',\n            params: params\n        });\n    }\n\n    setDefaultIP(params){\n        return this.apiRequestService.makePostRequest({\n            path: '/api/physical-server/manage',\n            params: params\n        });\n    }\n\n    deleteIP(param){\n\t\treturn this.apiRequestService.makeDeleteRequest({\n\t\t\tpath: '/api/physical-server/manage',\n\t\t\tparams: param\n        });\n    }\n\n    updateProgress(params){\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/update-progress',\n            params: params\n        })\n    }\n\n    getInterfaceList(params){\n        return this.apiRequestService.makeGetRequest({\n            path: '/api/physical-server/interface-list',\n            params: params\n        })\n    }\n    addInterfaceMonitoring(params){\n        return this.apiRequestService.makePostRequest({\n            path: '/api/physical-server/monitor',\n            params: params\n        });\n    }\n}\n","import { Component, OnInit, OnDestroy } from '@angular/core';\nimport moment from 'moment';\nimport { Subject } from 'rxjs';\nimport { takeUntil } from 'rxjs/operators';\n\nimport { DashboardService } from 'src/app/_services/all-requests/dashboard.service';\nimport { LocalStorageService } from 'src/app/_services/utility/localstorage.service';\nimport { NotificationService } from 'src/app/_services/utility/notification.service';\n\n@Component({\n  selector: 'dashboard-active-alerts',\n  templateUrl: './active-alerts.component.html',\n  styleUrls: ['./active-alerts.component.scss'],\n  providers: [DashboardService, LocalStorageService, NotificationService]\n})\nexport class ActiveAlertsComponent implements OnInit, OnDestroy {\n  \n  selectedAccount: any;\n  alertsData: any = { data: [], total_count: 0 };\n  criticalCount: number = 0;\n  loader: boolean = false;\n  more: boolean = true;\n  message: string = '';\n\n  private destroy$ = new Subject<void>();\n\n  constructor(\n    private lsService: LocalStorageService,\n    private dashboardService: DashboardService,\n    private notificationService: NotificationService) {\n      this.selectedAccount = this.lsService.getSelectedAccount();\n  }\n\n  ngOnInit(): void {\n    this.getAlertsList(2);\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  getAlertsList(limit: number) {\n    this.loader = true;\n    this.message = '';\n    const params = {\n      page: 1,\n      limit: limit,\n      filter: JSON.stringify({ account: { 1: [this.selectedAccount.account_id] } }),\n      start_date: (moment as any)().subtract(60, 'm').unix(),\n      end_date: (moment as any)().unix()\n    };\n\n    this.dashboardService.getAllAlertsData(params)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe({\n        next: (result) => {\n          if (result && result.status) {\n            this.alertsData.data = result.data || [];\n            this.alertsData.total_count = result.total_count || 0;\n            this.criticalCount = result.data.filter((alert: any) =>\n              alert.severity === 'critical' || alert.alert_type === 'critical'\n            ).length || result.total_count;\n          } else if (result && !result.status) {\n            this.message = result.message;\n          }\n          this.loader = false;\n        },\n        error: (error) => {\n          this.loader = false;\n          this.message = typeof error === 'string' ? error : (error?.message || 'Failed to load recent alerts.');\n        }\n      });\n  }\n\n  showMore() {\n    this.getAlertsList(this.alertsData.total_count);\n    this.more = false;\n  }\n}\n","<div class=\"panel\">\n  <!-- Header -->\n  <div class=\"panel-header\">\n    <h2 class=\"title\">Recent Alerts (Last 1 hour)</h2>\n    <div class=\"badge-critical\" *ngIf=\"criticalCount > 0 && !message\">\n      {{ criticalCount }} CRITICAL\n    </div>\n    <div\n      class=\"badge-healthy\"\n      *ngIf=\"!loader && !message && alertsData.total_count === 0\"\n    >\n      HEALTHY\n    </div>\n  </div>\n\n  <!-- Alert Cards -->\n  <div [ngClass]=\"more ? 'cards' : 'cards cards-scroll'\">\n    <ng-container *ngIf=\"!message\">\n      <div *ngFor=\"let alert of alertsData.data; let i = index\">\n        <div *ngIf=\"!more || i < 2\" class=\"card\">\n          <!-- Header -->\n          <div class=\"card-header\">\n            <div class=\"text-critical text-sm text-upper\">\n              {{ alert.monitor_name | noUnderscoreAllCapitalCheck }}\n            </div>\n            <div class=\"icon-circle bg-critical\">\n              <mat-icon>error</mat-icon>\n            </div>\n          </div>\n\n          <!-- IP -->\n          <div class=\"text-lg text-bold mb-2\">{{ alert.ip || \"--\" }}</div>\n\n          <!-- Metrics -->\n          <div class=\"metrics\">\n            <div class=\"metric bg-critical-light\">\n              <div class=\"text-sm  text-upper\">CURRENT VALUE</div>\n              <div class=\"text-md text-bold\">\n                {{ alert.value || \"9.0\" }}\n                <span class=\"text-md text-danger\"\n                  >/ {{ alert.threshold || \"--\" }} Threshold</span\n                >\n              </div>\n            </div>\n            <div class=\"metric bg-info-light\">\n              <div class=\"text-sm  text-upper\">MONITOR</div>\n              <div class=\"text-md text-bold\">\n                {{ alert.monitor_name || \"--\" | noUnderscoreAllCapitalCheck }}\n              </div>\n            </div>\n          </div>\n\n          <!-- Details -->\n          <div class=\"details text-md\">\n            <div class=\"detail-row\">\n              <span>Project</span>\n              <span class=\"text-semibold\">{{ alert.project || \"--\" }}</span>\n            </div>\n            <div class=\"detail-row\">\n              <span>Env</span>\n              <span class=\"text-semibold text-primary text-upper\">{{\n                alert.env_type || \"--\"\n              }}</span>\n            </div>\n            <div class=\"detail-row\">\n              <span>Zone</span>\n              <span class=\"text-semibold\">{{ alert.zone || \"--\" }}</span>\n            </div>\n          </div>\n\n          <!-- Footer -->\n          <div class=\"card-footer\">\n            <div class=\"flex-center  text-sm\">\n              <mat-icon class=\"icon-sm\">schedule</mat-icon>\n              <span *ngIf=\"alert.started_on\">{{\n                alert.started_on | date: \"MMMM d, y\"\n              }}</span>\n            </div>\n            <div class=\"badge-info text-sm\">\n              TEMPLATE: {{ alert.template || \"--\" }}\n            </div>\n          </div>\n        </div>\n      </div>\n    </ng-container>\n\n    <!-- Loader -->\n    <div class=\"load-spinner\" *ngIf=\"loader\">\n      <div class=\"spinner\"></div>\n    </div>\n\n    <!-- Healthy state -->\n    <div\n      *ngIf=\"alertsData.total_count === 0 && !loader && !message\"\n      class=\"health-card\"\n    >\n      <div class=\"health-card__icon\">\n        <mat-icon>check_circle</mat-icon>\n      </div>\n      <div class=\"health-card__title\">All systems operational</div>\n      <div class=\"health-card__message\">\n        No alerts have been generated in the last hour. Your platform is running smoothly.\n      </div>\n    </div>\n\n    <!-- Error State: Simple message with icon (no static title, no refresh button) -->\n    <div\n      *ngIf=\"message && !loader\"\n      class=\"health-card error-card\"\n    >\n      <div class=\"health-card__icon error-card__icon\">\n        <mat-icon>warning</mat-icon>\n      </div>\n      <div class=\"health-card__message\">\n        {{ message }}\n      </div>\n    </div>\n  </div>\n\n  <!-- Show More/Less -->\n  <div\n    *ngIf=\"alertsData.total_count > 2 && more && !message\"\n    (click)=\"showMore()\"\n    class=\"text-center text-primary text-sm text-bold cursor-pointer mt-1\"\n  >\n    +{{ alertsData.total_count - 2 }} More\n  </div>\n  <div\n    *ngIf=\"alertsData.total_count > 2 && !more && !message\"\n    (click)=\"more = true\"\n    class=\"text-center text-primary text-sm text-bold cursor-pointer mt-1\"\n  >\n    Show Less\n  </div>\n</div>\n","import { Component, OnInit, OnDestroy } from '@angular/core';\nimport moment from 'moment';\nimport { LocalStorageService } from 'src/app/_services/utility/localstorage.service';\nimport { DashboardService } from 'src/app/_services/all-requests/dashboard.service';\nimport { ThemeService } from 'src/app/_services/utility/theme.service';\nimport { Subscription } from 'rxjs';\n\n@Component({\n  selector: 'dashboard-cloud-spend',\n  templateUrl: './cloud-spend.component.html',\n  styleUrls: ['./cloud-spend.component.scss'],\n  providers: [DashboardService, LocalStorageService]\n})\nexport class CloudSpendComponent implements OnInit, OnDestroy {\n\n  cloudSpendData: any = {};\n  contributors: any = {};\n  selectedAccount: any;\n  loader: boolean = false;\n  selectRange: boolean = false;\n  rangeOptions: any = ['Last 7 Days', 'Last 15 Days', 'Last 30 Days', 'Last 2 months', 'Last 3 months'];\n  rangeOptionMap: any = {\n    'Last 7 Days': 7, 'Last 15 Days': 15, 'Last 30 Days': 30,\n    'Last 2 months': 60, 'Last 3 months': 90\n  };\n  rangeLabelMap: any = {\n    'Last 7 Days': '7D', 'Last 15 Days': '15D', 'Last 30 Days': '30D',\n    'Last 2 months': '2M', 'Last 3 months': '3M'\n  };\n  timeRange: any = 'Last 30 Days';\n  total: number = 0;\n\n  // Raw API response — kept so theme changes can recolor without re-fetching\n  private rawSpend: any = null;\n  private rawContributors: any[] = [];\n\n  private themeSubscription: Subscription;\n\n  /** Read a CSS custom property value at runtime */\n  private cssVar(name: string): string {\n    return getComputedStyle(document.documentElement).getPropertyValue(name).trim();\n  }\n\n  /** Chart series colors — read from CSS variables so they switch with theme */\n  private getSeriesColors(): string[] {\n    return [\n      this.cssVar('--color-primary'),\n      this.cssVar('--color-warning'),\n      this.cssVar('--text-disabled'),\n      this.cssVar('--color-danger'),\n      this.cssVar('--color-info'),\n      this.cssVar('--text-subtle'),\n    ];\n  }\n\n  constructor(\n    private lsService: LocalStorageService,\n    private dashboardService: DashboardService,\n    private themeService: ThemeService\n  ) {\n    this.selectedAccount = this.lsService.getSelectedAccount();\n  }\n\n  ngOnInit(): void {\n    this.getCloudSpendData();\n\n    // Theme changed — recolor with existing data, no API call\n    this.themeSubscription = this.themeService.theme$.subscribe(() => {\n      if (this.rawSpend) {\n        this.buildChartData();\n      }\n    });\n  }\n\n  ngOnDestroy(): void {\n    if (this.themeSubscription) this.themeSubscription.unsubscribe();\n  }\n\n  rangeLabel(range: string): string {\n    return this.rangeLabelMap[range] || range;\n  }\n\n  getCloudSpendData() {\n    this.loader = true;\n    this.total = 0;\n\n    const param = {\n      account_id: this.selectedAccount.account_id,\n      start_time: moment().subtract(this.rangeOptionMap[this.timeRange], 'd').startOf('day').unix(),\n      end_time: moment().subtract(1, 'd').startOf('day').unix()\n    };\n\n    this.dashboardService.cloudSpendGraph(param).subscribe(\n      result => {\n        if (result && result.status) {\n          // Store raw response — reused on theme change\n          this.rawSpend = result.spend || {};\n          this.rawContributors = result.contributors || [];\n          this.buildChartData();\n        } else {\n          this.rawSpend = null;\n          this.rawContributors = [];\n          this.cloudSpendData = {};\n          this.contributors = {};\n        }\n        this.loader = false;\n      },\n      error => {\n        console.error('Cloud spend API error', error);\n        this.loader = false;\n        this.rawSpend = null;\n        this.rawContributors = [];\n        this.cloudSpendData = {};\n        this.contributors = {};\n      }\n    );\n  }\n\n  /** Build chart data from raw API response using current theme colors.\n   *  Called after API fetch AND on theme change — no API call on theme change. */\n  private buildChartData() {\n    const seriesColors = this.getSeriesColors();\n    const primaryColor = this.cssVar('--color-primary');\n    const spend = { ...this.rawSpend };\n    const data = spend['metricdata'] || {};\n    let metricdata: any[] = [];\n\n    Object.keys(data).forEach((ele, i) => {\n      const values = data[ele]['data'] || [];\n      const lineColor = seriesColors[i] || primaryColor;\n      const fillOpacity = i === 0 ? 0.15 : 0;\n\n      metricdata.push({\n        fillColor: {\n          linearGradient: { x1: 0, x2: 0, y1: 0, y2: 1 },\n          stops: [\n            [0, this.hexToRgba(lineColor, fillOpacity)],\n            [1, this.hexToRgba(lineColor, 0)],\n          ]\n        },\n        type: 'areaspline',\n        dashStyle: i === 0 ? 'Solid' : i === 1 ? 'Dash' : 'ShortDot',\n        color: lineColor,\n        lineWidth: i === 0 ? 2.5 : 1.8,\n        name: data[ele]['name'],\n        data: (spend.timedata || []).map((e: string, j: number) => {\n          return [moment(e).valueOf(), values[j] || 0];\n        })\n      });\n    });\n\n    spend['metricdata'] = metricdata;\n    spend['chart_type'] = 'areaspline';\n    spend['is_stack'] = false;\n    this.cloudSpendData = spend;\n\n    // contributors\n    this.contributors['metricpoints'] = this.rawContributors;\n    this.contributors['metricdata'] = [];\n    this.total = 0;\n    this.rawContributors.forEach((item: any, i: number) => {\n      const value = item.value || 0;\n      this.total += value;\n      this.contributors['metricdata'].push({\n        color: seriesColors[i % seriesColors.length],\n        y: value\n      });\n    });\n  }\n\n  /**\n   * Converts a hex color string to rgba with the given opacity.\n   * Falls back gracefully if the value is already an rgb/rgba string.\n   */\n  private hexToRgba(hex: string, opacity: number): string {\n    if (!hex || hex.startsWith('rgb')) {\n      return `rgba(0,0,0,${opacity})`;\n    }\n    const clean = hex.replace('#', '');\n    const r = parseInt(clean.substring(0, 2), 16);\n    const g = parseInt(clean.substring(2, 4), 16);\n    const b = parseInt(clean.substring(4, 6), 16);\n    if (isNaN(r) || isNaN(g) || isNaN(b)) return `rgba(0,0,0,${opacity})`;\n    return `rgba(${r},${g},${b},${opacity})`;\n  }\n\n  getContributorColor(index: number): string {\n    return this.contributors?.metricdata?.[index]?.color || this.cssVar('--color-primary');\n  }\n\n  rangeChange(event: any) {\n    this.getCloudSpendData();\n    this.selectRange = false;\n  }\n\n  refreshSelectedGraph(e: any) {\n    if (e.event.checked) {\n      this.getCloudSpendData();\n    }\n  }\n}\n","<div class=\"spends-card\">\n\n  <div class=\"spends-header\">\n    <div class=\"spends-title-block\">\n      <h3 class=\"spends-title\">Your Spend</h3>\n      <p class=\"spends-subtitle\">Monthly expenditure trends across primary services</p>\n    </div>\n    <div class=\"spends-range-toggle\">\n      <button\n        *ngFor=\"let range of rangeOptions\"\n        class=\"range-btn\"\n        [class.active]=\"timeRange === range\"\n        (click)=\"timeRange = range; rangeChange(null)\">\n        {{ rangeLabel(range) }}\n      </button>\n    </div>\n  </div>\n\n  <div *ngIf=\"!loader\" class=\"spends-chart-wrapper\">\n    <line-chart\n      [influxData]=\"cloudSpendData\"\n      [title]=\"'Your Cloud Spend'\"\n      [dashboard]=\"true\"\n      [showTitleBar]=\"false\"\n      (reloadGraph)=\"getCloudSpendData()\"\n      (refreshSelectedGraph)=\"refreshSelectedGraph($event)\">\n    </line-chart>\n  </div>\n\n  <div class=\"load-spinner\" *ngIf=\"loader\">\n    <mat-spinner [diameter]=\"30\"></mat-spinner>\n  </div>\n<!---------Diplay top contributors------------------------------>\n  <div class=\"spends-legend\" *ngIf=\"!loader && contributors?.metricpoints?.length\">\n    <div class=\"legend-item\" *ngFor=\"let item of contributors.metricpoints; let i = index\">\n      <span class=\"legend-dot\" [style.background]=\"getContributorColor(i)\"></span>\n      <div class=\"legend-info\">\n        <span class=\"legend-label\">{{ item.name | uppercase }}</span>\n        <span class=\"legend-value\">{{ item.value | currencyInr }}</span>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"spends-footer\">\n    <a class=\"cost-explorer-link\" routerLink=\"/dashboard/billing/cost\">Cost Explorer</a>\n  </div>\n\n</div>","import { NgModule } from '@angular/core';\nimport { Routes, RouterModule } from '@angular/router';\n\nimport { DashboardComponent } from './dashboard.component';\n\n\nconst routes: Routes = [{\n  path : '', component: DashboardComponent,\n  children: [\n    { path: '', component: DashboardComponent },\n]\n}];\n\n@NgModule({\n  imports: [RouterModule.forChild(routes)],\n  exports: [RouterModule]\n})\nexport class DashboardRoutingModule { }\n","import { Component, OnInit } from '@angular/core';\nimport { Router } from '@angular/router';\n\nimport { USER_INFO } from 'src/constants/local.storage'\nimport { urlMap, urlCreateMap } from 'src/constants/url.constants';\nimport { ElbService } from 'src/app/_services/all-requests/elb.service';\nimport { ElasticlbService } from 'src/app/_services/all-requests/elastic-lb.service';\nimport { ClusterService } from 'src/app/_services/all-requests/cluster.service';\nimport { ServersService } from 'src/app/_services/all-requests/servers.service';\nimport { K8sClusterService } from 'src/app/_services/all-requests/k8s-cluster.service';\nimport { LocalStorageService } from 'src/app/_services/utility/localstorage.service';\nimport { NotificationService } from 'src/app/_services/utility/notification.service';\nimport { PhysicalServerService } from 'src/app/_services/all-requests/physical-server.service';\n\n@Component({\n  s