bCluster',    link: this.urlMap['cluster'] },\n      { name: 'K8s CLUSTER',     css: 'k8',           link: this.urlMap['k8s-cluster'] },\n      { name: 'ELB',             css: 'elb',          link: this.urlMap['elastic-loadbalancer'] },\n      { name: 'SSL CERTIFICATE', css: 'sslCert',      link: this.urlMap['ssl-certificate'] }\n    ];\n\n    for (let row of this.displayFirstRow) {\n      this.count[row.css] = '--';\n    }\n\n    this.params = {\n      page: 1,\n      limit: 1,\n      account_id: this.selectedAccount.account_id,\n      filter: JSON.stringify({})\n    };\n  }\n\n  ngOnInit(): void {\n    this.getServerCount();\n    this.getBareMetalCount();\n    this.getDBClusterCount();\n    this.getK8sClusterCount();\n    this.getELBCount();\n    this.getCertificates();\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  getServerCount() {\n    const param = { ...this.params, filter: JSON.stringify({ server_type: ['cloud'] }) };\n    this.serversService.getServerList(param)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(\n        result => { if (result && result.status) this.count.cloudServers = result.total_count; },\n        error  => { this.notificationService.notify(error); }\n      );\n  }\n\n  getBareMetalCount() {\n    const param = { ...this.params, type: 'bare_metal' };\n    this.physicalServerService.getServerList(param)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(\n        result => { if (result && result.status) this.count.bareMetal = result.count; },\n        error  => { this.notificationService.notify(error); }\n      );\n  }\n\n  getDBClusterCount() {\n    this.clusterService.getDBClusterData(this.params)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(\n        result => { if (result && result.status) this.count.dbCluster = result.total_count; },\n        error  => { this.notificationService.notify(error); }\n      );\n  }\n\n  getK8sClusterCount() {\n    const params = { page: 1, pageSize: 1, account_id: this.selectedAccount.account_id, filter: JSON.stringify({}) };\n    this.k8sClusterService.getClusters(params)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(\n        result => { if (result && result.status) this.count.k8 = result.total_count; },\n        error  => { this.notificationService.notify(error); }\n      );\n  }\n\n  getELBCount() {\n    this.elbService.getLoadBalancerData(this.params)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(\n        result => { if (result && result.status) this.count.elb = result.total_count; },\n        error  => { this.notificationService.notify(error); }\n      );\n  }\n\n  getCertificates() {\n    const params = { ...this.params, expire: 'true' };\n    this.lbService.getCertificates(params)\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(\n        result => { if (result && result.status) this.count.sslCert = result.total_count; },\n        error  => { this.notificationService.notify(error); }\n      );\n  }\n\n  redirectToService(element: any) {\n    if (element.link) this.router.navigateByUrl(element.link);\n  }\n}","<div class=\"infra-cards\">\n  <div\n    *ngFor=\"let element of displayFirstRow\"\n    class=\"infra-card\"\n    (click)=\"redirectToService(element)\"\n  >\n    <div class=\"infra-icon\">\n      <span class=\"sprite-sc sc-icons {{ element.css }}\"></span>\n      <span class=\"infra-count-value\">{{ count[element.css] }}</span>\n    </div>\n    <div class=\"infra-label\">{{ element.name }}</div>\n  </div>\n</div>\n","import {\n  ChangeDetectionStrategy,\n  ChangeDetectorRef,\n  Component,\n  OnInit,\n  OnDestroy,\n} from \"@angular/core\";\nimport { Router } from \"@angular/router\";\nimport { Subject } from \"rxjs\";\nimport { takeUntil } from \"rxjs/operators\";\n\nimport { DashboardService } from \"src/app/_services/all-requests/dashboard.service\";\nimport { NotificationService } from \"src/app/_services/utility/notification.service\";\nimport { LocalStorageService } from \"src/app/_services/utility/localstorage.service\";\n\n@Component({\n  selector: \"app-dashboard-pending-actions\",\n  templateUrl: \"./pending-actions.component.html\",\n  styleUrls: [\"./pending-actions.component.scss\"],\n  providers: [DashboardService, NotificationService, LocalStorageService],\n  changeDetection: ChangeDetectionStrategy.OnPush,\n})\nexport class PendingActionsComponent implements OnInit, OnDestroy {\n  more = true;\n  pendingTasksData: any[] = [];\n  loading = true;\n\n  private destroy$ = new Subject<void>();\n\n  get visibleTasks(): any[] {\n    return this.more\n      ? this.pendingTasksData.slice(0, 2)\n      : this.pendingTasksData;\n  }\n\n  private readonly deviceListAccountIds = new Set([76, 77, 79, 92]);\n\n  private readonly categoryConfig: Record<\n    string,\n    { route: string; badgeLabel: string; queryParams?: Record<string, any> }\n  > = {\n    server: { route: \"/dashboard/server/server-list\", badgeLabel: \"SERVERS\" },\n    natgateway: {\n      route: \"/dashboard/nat-gateway/nat-gateway-list\",\n      badgeLabel: \"NAT GATEWAYS\",\n    },\n    k8scluster: {\n      route: \"/dashboard/k8s-cluster/k8s-cluster-list\",\n      badgeLabel: \"CLUSTERS\",\n    },\n    sslcertificate: {\n      route: \"/dashboard/ssl-certificate/ssl-certificate-list\",\n      badgeLabel: \"SSL CERTIFICATES\",\n    },\n    user: {\n      route: \"/dashboard/admin/admin-details\",\n      badgeLabel: \"USERS\",\n      queryParams: { activeTabName: \"users\" },\n    },\n    project: {\n      route: \"/dashboard/admin/admin-details\",\n      badgeLabel: \"PROJECTS\",\n      queryParams: { activeTabName: \"projects\" },\n    },\n    tag: {\n      route: \"/dashboard/admin/admin-details\",\n      badgeLabel: \"TAGS\",\n      queryParams: { activeTabName: \"tags\" },\n    },\n    accesspolicy: {\n      route: \"/dashboard/admin/admin-details\",\n      badgeLabel: \"ACCESS POLICIES\",\n      queryParams: { activeTabName: \"access_policy\" },\n    },\n    dbcluster: {\n      route: \"/dashboard/cluster/cluster-list\",\n      badgeLabel: \"DB CLUSTERS\",\n    },\n    zonecluster: {\n      route: \"/dashboard/zone-cluster/zone-cluster-list\",\n      badgeLabel: \"ZONE CLUSTERS\",\n    },\n    device: {\n      route: \"/dashboard/device/device-list\",\n      badgeLabel: \"DEVICES\",\n    },\n  };\n\n  constructor(\n    private dashboardService: DashboardService,\n    private notificationService: NotificationService,\n    private localStorageService: LocalStorageService,\n    private router: Router,\n    private cdr: ChangeDetectorRef,\n  ) {}\n\n  ngOnInit(): void {\n    this.getPendingTasks();\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  getPendingTasks(): void {\n    const selectedAccount = this.localStorageService.getSelectedAccount();\n    this.loading = true;\n    this.dashboardService\n      .getPendingTasks({ account_id: selectedAccount.account_id })\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(\n        (result) => {\n          this.loading = false;\n          if (result && result.status) {\n            this.pendingTasksData = result.data ?? [];\n          }\n          this.cdr.markForCheck();\n        },\n        (error) => {\n          this.loading = false;\n          this.notificationService.notify(error);\n          this.cdr.markForCheck();\n        },\n      );\n  }\n\n  getCategoryLabel(category: string): string {\n    const map: Record<string, string> = {\n      server: \"Server\",\n      k8scluster: \"Kubernetes\",\n      sslcertificate: \"SSL Certificate\",\n      user: \"User\",\n      natgateway: \"NAT Gateway\",\n      project: \"Project\",\n      tag: \"Tag\",\n      accesspolicy: \"Access Policy\",\n      zonecluster: \"Zone Cluster\",\n      dbcluster: \"DB Cluster\",\n      device: \"Device\",\n    };\n    return map[category?.toLowerCase()] ?? category?.toUpperCase() ?? \"TASK\";\n  }\n\n  getBadgeLabel(task: any): string {\n    const config = this.getCategoryConfig(\n      task?.category?.toLowerCase(),\n      task?.filters || {},\n    );\n    return config?.badgeLabel ;\n  }\n\n  getProgress(data: any): number {\n    const total = +data?.total || 0;\n    const latest = +data?.latest || 0;\n    return total > 0 ? Math.round((latest / total) * 100) : 0;\n  }\n\n  redirect(element: any): void {\n    const category = element?.category?.toLowerCase();\n    const filters = element?.filters || {};\n    const config = this.getCategoryConfig(category, filters);\n\n    if (!config) {\n      return;\n    }\n\n    const filterJson =\n      Object.keys(filters).length > 0 ? JSON.stringify(filters) : undefined;\n\n    this.router.navigate([config.route], {\n      queryParams: {\n        ...config.queryParams,\n        ...(filterJson ? { filter: filterJson } : {}),\n        ...element?.query_params,\n      },\n    });\n  }\n\n  private getCategoryConfig(\n    category: string,\n    filters: Record<string, any>,\n  ): { route: string; badgeLabel: string; queryParams?: Record<string, any> } | undefined {\n    const resolvedCategory = this.resolveCategory(category, filters);\n\n    if (resolvedCategory === \"device\") {\n      const accountId = Number(\n        this.localStorageService.getSelectedAccount()?.account_id,\n      );\n      return this.deviceListAccountIds.has(accountId)\n        ? this.categoryConfig.device\n        : {\n            route: \"/dashboard/bare-metal/bare-metal-list\",\n            badgeLabel: \"BARE METAL\",\n          };\n    }\n\n    return this.categoryConfig[resolvedCategory];\n  }\n\n  private resolveCategory(\n    category: string,\n    filters: Record<string, any>,\n  ): string {\n    if (category === \"server\") {\n      const serverTypes = Array.isArray(filters?.server_type)\n        ? filters.server_type\n        : [];\n      if (\n        serverTypes.map((type) => String(type).toLowerCase()).includes(\"natgw\")\n      ) {\n        return \"natgateway\";\n      }\n    }\n    return category;\n  }\n}\n","<div class=\"pa-page\">\n  <!---Page header-->\n  <div class=\"pa-header\">\n    <div class=\"pa-header_row\">\n      <div class=\"pa-header_title\">Pending Tasks</div>\n      <span class=\"pa-header__pill\" *ngIf=\"pendingTasksData.length > 0\">\n        PRIORITY ACTION\n      </span>\n    </div>\n    <p class=\"pa-header_sub\">Action items requiring administrator attention</p>\n  </div>\n\n  <!-- Cards -->\n  <div class=\"pa-content\">\n    <div\n      [ngClass]=\"more ? 'pa-list' : 'pa-list pa-list--scroll'\"\n      *ngIf=\"!loading && pendingTasksData.length > 0\"\n    >\n      <ng-container *ngFor=\"let task of visibleTasks\">\n        <div class=\"pa-card\">\n          <div class=\"pa-card__top\">\n            <div class=\"pa-card__info\">\n              <div class=\"pa-card__category\">\n                <span class=\"pa-card__dot\"></span>\n                {{ getCategoryLabel(task.category) | uppercase }}\n              </div>\n\n              <div class=\"pa-card__title\" [matTooltip]=\"task.title\">\n                {{ task.title | truncate: 60 : true }}\n              </div>\n              <div class=\"pa-card__desc\">\n                {{ task.description }}\n              </div>\n\n              <!-- Progress bar (only when has_progress_bar is true) -->\n              <div *ngIf=\"task.has_progress_bar\" class=\"pa-card__progress-wrap\">\n                <div class=\"pa-card__progress-meta\">\n                  <span>{{ task.data?.latest }} up-to-date</span>\n                  <span\n                    >{{ task.data?.outdated }} centos /\n                    {{ task.data?.total }} total</span\n                  >\n                </div>\n                <div class=\"pa-card__progress-bar\">\n                  <div\n                    class=\"pa-card__progress-fill\"\n                    [style.width.%]=\"getProgress(task.data)\"\n                  ></div>\n                </div>\n              </div>\n            </div>\n\n            <div\n              class=\"pa-card__badge\"\n              (click)=\"redirect(task)\"\n              matTooltip=\"View details\"\n              role=\"button\"\n              tabindex=\"0\"\n              (keydown.enter)=\"redirect(task)\"\n            >\n              <span class=\"pa-card__badge-number\">{{\n                task.data?.outdated\n              }}</span>\n              <span class=\"pa-card__badge-label\">{{\n                getBadgeLabel(task)\n              }}</span>\n            </div>\n          </div>\n\n          <!-- ── Footer: avatar + open details ──────────────────────── -->\n          <div class=\"pa-card__footer\">\n            <!-- Type label -->\n            <span class=\"pa-card__type\">{{ task.action | uppercase }}</span>\n\n            <!-- Open Details — navigates to detail page -->\n            <button\n              class=\"pa-card__open-details\"\n              type=\"button\"\n              (click)=\"redirect(task)\"\n            >\n              Open Details\n              <span class=\"pa-card__arrow\">&#8594;</span>\n            </button>\n          </div>\n          <!-- /.pa-card__footer -->\n        </div>\n        <!-- /.pa-card -->\n      </ng-container>\n    </div>\n    <!-- /.pa-list -->\n\n    <!-- ── Empty state ──────────────────────────────────────────── -->\n    <div *ngIf=\"!loading && pendingTasksData.length === 0\" class=\"pa-empty\">\n      <div class=\"flex no-dashboard-data\">\n        <div>No Pending Tasks</div>\n      </div>\n    </div>\n\n    <!-- ── Loading state ─────────────────────────────────────────── -->\n    <div *ngIf=\"loading\" class=\"pa-loading\">\n      <mat-spinner diameter=\"32\"></mat-spinner>\n    </div>\n\n    <!-- ── Show more / less ─────────────── -->\n    <div\n      class=\"pa-more\"\n      *ngIf=\"pendingTasksData.length > 2 && more\"\n      (click)=\"more = false\"\n    >\n      +{{ pendingTasksData.length - 2 }} More\n    </div>\n    <div\n      class=\"pa-more\"\n      *ngIf=\"pendingTasksData.length > 2 && !more\"\n      (click)=\"more = true\"\n    >\n      Show Less\n    </div>\n  </div>\n</div>\n<!-- /.pa-page -->\n","import { Component, OnInit, OnDestroy, ViewChild, ElementRef, AfterViewInit } from '@angular/core';\nimport { Subject } from 'rxjs';\nimport { takeUntil } from 'rxjs/operators';\nimport { DashboardService } from 'src/app/_services/all-requests/dashboard.service';\nimport { LocalStorageService } from 'src/app/_services/utility/localstorage.service';\nimport { Router } from '@angular/router';\n\nexport interface MetricItem {\n  name: string;\n  count: number;\n  color: string;\n}\n\nexport interface BarItem {\n  name: string;\n  label: string;\n  value: number;\n  color: string;\n  barWidth: string;\n  project_name: string;\n  tags: string[];\n  server_id: number | null;\n  metrics: MetricItem[];\n}\n\n@Component({\n  selector: 'dashboard-top-alerts',\n  templateUrl: './top-alerts.component.html',\n  styleUrls: ['./top-alerts.component.scss'],\n  providers: [DashboardService, LocalStorageService]\n})\nexport class TopAlertsComponent implements OnInit, AfterViewInit, OnDestroy {\n\n  @ViewChild('alertsWrap') alertsWrapRef: ElementRef<HTMLElement>;\n\n  selectedAccount: any;\n\n  alertItems: BarItem[] = [];\n  alertsLoading = true;\n  alertsShowAll = false;\n  alertsLockedHeight: string = 'none';\n  message: string = '';\n  readonly ALERTS_LIMIT = 4;\n\n  private readonly ALERT_COLORS = ['#c0392b', '#8B4513', '#2563eb', '#9ca3af', '#16a34a', '#7c3aed'];\n  private readonly METRIC_TYPE_COLORS: { [key: string]: string } = {\n    'K8_Pod_Status':    '#e74c3c',\n    'SYSTEMD_UNITS':    '#3498db',\n    'SWAP':             '#f39c12',\n    'RABBITMQ_SERVICE': '#9b59b6',\n    'LOAD':             '#1abc9c',\n    'CPU':              '#e67e22',\n    'MEMORY':           '#2ecc71',\n    'DISK':             '#34495e',\n    'NETWORK':          '#16a085',\n    'DEFAULT':          '#95a5a6'\n  };\n\n  private destroy$ = new Subject<void>();\n\n  constructor(\n    private dashboardService: DashboardService,\n    private lsService: LocalStorageService,\n    private router: Router\n  ) {\n    this.selectedAccount = this.lsService.getSelectedAccount();\n  }\n\n  ngOnInit(): void {\n    this.loadTopAlerts();\n  }\n\n  ngAfterViewInit(): void {}\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  // Lock the height after the collapsed 4-card list renders\n  private lockAlertsHeight(): void {\n    setTimeout(() => {\n      if (this.alertsWrapRef?.nativeElement) {\n        const h = this.alertsWrapRef.nativeElement.scrollHeight;\n        this.alertsLockedHeight = `${h}px`;\n      }\n    }, 0);\n  }\n\n  get visibleAlerts(): BarItem[] {\n    return this.alertsShowAll ? this.alertItems : this.alertItems.slice(0, this.ALERTS_LIMIT);\n  }\n\n  private loadTopAlerts(): void {\n    this.alertsLoading = true;\n    this.message = '';\n    this.dashboardService.topAlertsGraph({\n      account_id: this.selectedAccount?.account_id\n    })\n      .pipe(takeUntil(this.destroy$))\n      .subscribe({\n        next: (res) => {\n          this.alertsLoading = false;\n          if (res?.status && res.data?.length) {\n            this.alertItems = this.buildBarItems(res.data, this.ALERT_COLORS);\n            this.lockAlertsHeight();\n          } else if (res && !res.status) {\n            this.message = res.message;\n          }\n        },\n        error: (err) => {\n          this.alertsLoading = false;\n          this.message = typeof err === 'string' ? err : (err?.message || 'Failed to load top open alerts.');\n        }\n      });\n  }\n\n  private buildBarItems(data: any[], colors: string[]): BarItem[] {\n    const max = Math.max(...data.map((d: any) => d.value ?? 0), 1);\n    return data.map((item: any, i: number) => ({\n      name:         item.name,\n      label:        this.formatLabel(item.name),\n      value:        item.value ?? 0,\n      color:        colors[i % colors.length],\n      barWidth:     `${Math.round(((item.value ?? 0) / max) * 100)}%`,\n      project_name: item.project_name ?? '',\n      tags:         Array.isArray(item.tags) ? item.tags : [],\n      server_id:    item.server_id ?? null,\n      metrics:      this.buildMetricItems(item.metrics ?? [])\n    }));\n  }\n\n  private buildMetricItems(metrics: any[]): MetricItem[] {\n    if (!Array.isArray(metrics)) return [];\n    return metrics.map((metric: any) => ({\n      name: metric.name ?? '',\n      count: metric.count ?? 0,\n      color: this.getMetricColor(metric.name)\n    }));\n  }\n\n  private getMetricColor(metricName: string): string {\n    return this.METRIC_TYPE_COLORS[metricName] || this.METRIC_TYPE_COLORS['DEFAULT'];\n  }\n\n  navigateToServer(item: BarItem): void {\n    if (!item.server_id) return;\n    this.router.navigate(['/dashboard/server/server-details'], {\n      queryParams: { \n        tabindex: 'alerts', \n        id: item.server_id,\n        filter: JSON.stringify({ open_alerts: true })\n      }\n    });\n  }\n\n\n  formatLabel(raw: string): string {\n    if (!raw) return '';\n    return raw\n      .replace(/_+/g, ' ')\n      .trim()\n      .split(' ')\n      .filter(w => w.length > 0)\n      .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase())\n      .join(' ');\n  }\n\n  \n  padValue(v: number): string {\n    return v < 10 ? `0${v}` : `${v}`;\n  }\n}\n","<div class=\"bar-panel\">\n\n  <!-- Header -->\n  <div class=\"bar-panel__header\">\n    <span class=\"bar-panel__title\">Top Open Alerts</span>\n  </div>\n\n  <!-- Loading -->\n  <div class=\"bar-panel__loading\" *ngIf=\"alertsLoading\">\n    <div class=\"spinner\"></div>\n  </div>\n\n  <!-- Empty -->\n  <div class=\"bar-panel__empty\" *ngIf=\"!alertsLoading && !message && alertItems.length === 0\">\n    No top alerts found.\n  </div>\n\n  <!-- Error State: Simple message with icon (no static title, no refresh button) -->\n  <div class=\"bar-panel__error\" *ngIf=\"!alertsLoading && message\">\n    <mat-icon class=\"bar-panel__error-icon\">warning</mat-icon>\n    <div class=\"bar-panel__error-message\">{{ message }}</div>\n  </div>\n\n  <div class=\"bar-list-wrap\"\n       #alertsWrap\n       *ngIf=\"!alertsLoading && alertItems.length > 0\"\n       [class.bar-list-wrap--expanded]=\"alertsShowAll\"\n       [style.max-height]=\"alertsLockedHeight\">\n    <div class=\"bar-list\">\n      <div class=\"alert-card\"\n           *ngFor=\"let item of visibleAlerts\"\n           [class.alert-card--clickable]=\"item.server_id\"\n           (click)=\"navigateToServer(item)\">\n\n        <!-- Row 1: dot + IP + count -->\n        <div class=\"alert-card__top\">\n          <span class=\"alert-card__dot\" [style.background]=\"item.color\"></span>\n          <span class=\"alert-card__name\">{{ item.label }}</span>\n          <span class=\"alert-card__count\" [style.color]=\"item.color\" *ngIf=\"item.metrics && item.metrics.length > 1\">{{ padValue(item.value) }}</span>\n        </div>\n\n        <!-- Row 2: project name + tags -->\n        <div class=\"alert-card__meta\">\n          <span class=\"alert-card__project\" *ngIf=\"item.project_name\">\n            <svg width=\"10\" height=\"10\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <path d=\"M2 3a1 1 0 011-1h10a1 1 0 011 1v2a1 1 0 01-1 1H3a1 1 0 01-1-1V3zm0 6a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H3a1 1 0 01-1-1V9zm8 0a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2a1 1 0 01-1-1V9z\" fill=\"currentColor\"/>\n            </svg>\n            {{ item.project_name }}\n          </span>\n          <div class=\"alert-card__tags\" *ngIf=\"item.tags.length > 0\">\n            <span class=\"alert-card__tag\" *ngFor=\"let tag of item.tags\">{{ tag }}</span>\n          </div>\n        </div>\n\n        <!-- Row 3: metrics -->\n        <div class=\"alert-card__metrics\" *ngIf=\"item.metrics && item.metrics.length > 0\">\n          <div class=\"alert-card__metric\" *ngFor=\"let metric of item.metrics\">\n            <span class=\"alert-card__metric-name\">{{ formatLabel(metric.name) }}</span>\n            <span class=\"alert-card__metric-count\">{{ metric.count }}</span>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  </div>\n\n  <!-- Show more / less -->\n  <div class=\"bar-panel__more\"\n       *ngIf=\"!alertsLoading && alertItems.length > ALERTS_LIMIT && !alertsShowAll\"\n       (click)=\"alertsShowAll = true\">\n    +{{ alertItems.length - ALERTS_LIMIT }} More\n  </div>\n  <div class=\"bar-panel__more\"\n       *ngIf=\"!alertsLoading && alertItems.length > ALERTS_LIMIT && alertsShowAll\"\n       (click)=\"alertsShowAll = false\">\n    Show Less\n  </div>\n\n</div>\n"],"names":[],"sourceRoot":"webpack:///","x_google_ignoreList":[]}