t.account_id,filter:JSON.stringify({})}\n    this.k8sClusterService.getClusters(params).subscribe(result => {\n      if (result && result.status) {\n        this.count.k8 = result.total_count;\n      }\n    }, error => {\n      this.notificationService.notify(error)\n    })\n  }\n\n  getELBCount() {\n    this.elbService.getLoadBalancerData(this.params).subscribe(result => {\n      if (result && result.status) {\n        this.count.elb = result.total_count;\n      }\n    }, error => {\n      this.notificationService.notify(error)\n    })\n  }\n\n  getCertificates() {\n    let params = {...this.params, expire : 'true' }\n    this.lbService.getCertificates(params).subscribe(result => {\n      if (result && result.status) {\n        this.count.sslCert = result.total_count;\n      }\n    }, error => {\n        this.notificationService.notify(error)\n    })\n  }\n\n  redirectToService(element) {\n    if (element.link)\n      this.router.navigateByUrl(element.link);\n  }\n\n  getGreeting() {\n    var today = new Date()\n    var curHr = today.getHours()\n    if (curHr < 12) {\n     return 'Good Morning'\n    } else if (curHr < 18) {\n      return 'Good Afternoon'\n    } else {\n      return 'Good Evening'\n    }\n  }\n}*/\n\n\n \n\n \n","<div class=\"greeting-banner\">\n  <div>\n    <h1 class=\"greeting-title\">{{ getGreeting() }}, {{ userInfo.fullname.split(' ')[0] }}!</h1>\n    <p class=\"greeting-sub\">Welcome back to your central cloud architect cockpit.</p>\n  </div>\n</div>\n\n<div class=\"split-row\">\n  <div class=\"split-left\">\n    <dashboard-infra-cards></dashboard-infra-cards>\n    <app-dashboard-pending-actions></app-dashboard-pending-actions>\n    <dashboard-cloud-spend></dashboard-cloud-spend>\n  </div>\n  <div class=\"split-right\">\n    <dashboard-active-alerts></dashboard-active-alerts>\n    <dashboard-top-alerts></dashboard-top-alerts>\n  </div>\n</div>","import { NgModule } from '@angular/core';\nimport { CommonModule } from '@angular/common';\n\nimport