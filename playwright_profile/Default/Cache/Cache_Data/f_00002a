   </div>\n\n</div>\n<div mat-dialog-actions>\n    <button *ngIf=\"!data.onlyDisplay\" mat-flat-button class=\"actions-btns\" color=\"primary\" (click)=\"confirm()\"\n    cdkFocusInitial [disabled]=\"spin || (showComment && !displayComment?.trim())\">Confirm\n    <span>\n        <mat-spinner *ngIf=\"spin\" [diameter]=\"20\"></mat-spinner>\n    </span>\n</button>\n    <button *ngIf=\"!data.onlyDisplay\" class=\"actions-btns cancel\" mat-flat-button (click)=\"onNoClick()\"> Cancel</button>\n   \n    <button *ngIf=\"data.onlyDisplay\" class=\"actions-btns cancel\" (click)=\"download()\"  mat-flat-button > Download </button>\n    <button *ngIf=\"data.onlyDisplay\" mat-flat-button class=\"actions-btns \" color=\"primary\" (click)=\"confirm()\">OK</button>\n</div>","import { Component } from '@angular/core';\nimport { ShelfService } from '../shelf/shelf.service';\nimport { SupportCentreComponent } from '../../support-centre/support-centre.component';\n\n@Component({\n  selector: 'app-contact',\n  templateUrl: './contact.component.html',\n  styleUrls: ['./contact.component.scss'],\n})\nexport class ContactComponent {\n\n  constructor(private shelf: ShelfService) {}\n\n  goToSupport(): void {\n    this.shelf.open(SupportCentreComponent);\n  }\n}\n","<!-- ── Support Center Direct Link ───────────────────────────── -->\n<button\n  class=\"header-icon-btn support-trigger\"\n  (click)=\"goToSupport()\"\n  matTooltip=\"Support Center\"\n  matTooltipPosition=\"below\"\n  aria-label=\"Support Center\"\n  type=\"button\"\n>\n  <span class=\"gr-sprite gr-sprite-gr-icons gr-sprite-support-header\"></span>\n</button>\n","import { NgModule } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { NoLeadingSpaceDirective } from './no-leading-space/no-leading-space.directive';\n\n@NgModule({\n  declarations: [NoLeadingSpaceDirective],\n  imports: [CommonModule],\n  exports: [NoLeadingSpaceDirective],\n})\nexport class DirectivesModule {}\n","import {\n  Directive,\n  ElementRef,\n  HostListener,\n  OnDestroy,\n  OnInit,\n  Optional,\n  Renderer2,\n  Self,\n} from '@angular/core';\nimport { NgControl } from '@angular/forms';\nimport {\n  LEADING_SPACE_ERROR_KEY,\n  LEADING_SPACE_ERROR_MESSAGE,\n  noLeadingSpaceValidator,\n} from './no-leading-space.validator';\n\n@Directive({\n  selector:\n    'input[matInput]:not([noLeadingSpaceOff]), input[type=\"text\"]:not([noLeadingSpaceOff]), input[type=\"search\"]:not([noLeadingSpaceOff]), input[type=\"email\"]:not([noLeadingSpaceOff]), input:not([type]):not([noLeadingSpaceOff]), textarea:not([noLeadingSpaceOff])',\n})\nexport class NoLeadingSpaceDirective implements OnInit, OnDestroy {\n  private errorElement: HTMLElement | null = null;\n  private formField: HTMLElement | null = null;\n  private hideErrorTimer: ReturnType<typeof setTimeout> | null = null;\n  private isNormalizing = false;\n\n  constructor(\n    private el: ElementRef<HTMLInputElement | HTMLTextAreaElement>,\n    private renderer: Renderer2,\n    @Optional() @Self() private ngControl: NgControl\n  ) {}\n\n  ngOnInit(): void {\n    this.ngControl?.control?.addValidators(noLeadingSpaceValidator());\n    this.ngControl?.control?.updateValueAndValidity({ emitEvent: false });\n  }\n\n  ngOnDestroy(): void {\n    this.clearHideErrorTimer();\n    this.removeErrorElement();\n  }\n\n  @HostListener('keydown', ['$event'])\n  onKeyDown(event: KeyboardEvent): void {\n    if (!this.isSpaceKey(event)) {\n      return;\n    }\n\n    const input = this.el.nativeElement;\n    const start = input.selectionStart ?? 0;\n\n    if (start === 0) {\n      event.preventDefault();\n      this.setLeadingSpaceError(true);\n    }\n  }\n\n  @HostListener('paste', ['$event'])\n  onPaste(event: ClipboardEvent): void {\n    const pastedText = event.clipboardData?.getData('text') ?? '';\n    if (!pastedText) {\n      return;\n    }\n\n    const input = this.el.nativeElement;\n    const start = input.selectionStart ?? 0;\n    const end = input.selectionEnd ?? 0;\n    const nextValue =\n      input.value.slice(0, start) + pastedText + input.value.slice(end);\n\n    if (!nextValue.startsWith(' ')) {\n      return;\n    }\n\n    event.preventDefault();\n\n    const cleanedPaste = start === 0 ? pastedText.replace(/^\\s+/, '') : pastedText;\n    const cleanedValue = (\n      input.value.slice(0, start) +\n      cleanedPaste +\n      input.value.slice(end)\n    ).replace(/^\\s+/, '');\n\n    input.value = cleanedValue;\n    input.dispatchEvent(new Event('input', { bubbles: true }));\n    this.setLeadingSpaceError(true);\n  }\n\n  @HostListener('input')\n  onInput(): void {\n    if (this.isNormalizing) {\n      return;\n    }\n\n    const input = this.el.nativeElement;\n    if (!input.value.startsWith(' ')) {\n      if (!this.hideErrorTimer) {\n        this.setLeadingSpaceError(false);\n      }\n      return;\n    }\n\n    this.isNormalizing = true;\n    input.value = input.value.replace(/^\\s+/, '');\n    input.dispatchEvent(new Event('input', { bubbles: true }));\n    this.isNormalizing = false;\n    this.setLeadingSpaceError(true);\n  }\n\n  private isSpaceKey(event: KeyboardEvent): boolean {\n    return event.key === ' ' || event.code === 'Space';\n  }\n\n  private setLeadingSpaceError(hasError: boolean): void {\n    if (this.ngControl?.control) {\n      const control = this.ngControl.control;\n      const errors = { ...(control.errors || {}) };\n\n      if (hasError) {\n        errors[LEADING_SPACE_ERROR_KEY] = true;\n        control.setErrors(errors);\n        this.showErrorElement();\n        this.scheduleHideError();\n        return;\n      }\n\n      delete errors[LEADING_SPACE_ERROR_KEY];\n      control.setErrors(Object.keys(errors).length ? errors : null);\n    }\n\n    if (hasError) {\n      this.showErrorElement();\n      this.scheduleHideError();\n    } else {\n      this.removeErrorElement();\n      this.clearHideErrorTimer();\n    }\n  }\n\n  private showErrorElement(): void {\n    if (this.hasExistingMatError()) {\n      return;\n    }\n\n    if (!this.formField) {\n      this.formField = this.el.nativeElement.closest('mat-form-field');\n    }\n\n    if (!this.formField || this.errorElement) {\n      return;\n    }\n\n    const subscriptWrapper = this.formField.querySelector(\n      '.mat-form-field-subscript-wrapper'\n    );\n\n    if (!subscriptWrapper) {\n      return;\n    }\n\n    this.errorElement = this.renderer.createElement('div');\n    this.renderer.addClass(this.errorElement, 'mat-error');\n    this.renderer.addClass(this.errorElement, 'no-leading-space-error');\n    const text = this.renderer.createText(LEADING_SPACE_ERROR_MESSAGE);\n    this.renderer.appendChild(this.errorElement, text);\n    this.renderer.appendChild(subscriptWrapper, this.errorElement);\n    this.renderer.addClass(this.formField, 'mat-form-field-invalid');\n  }\n\n  private removeErrorElement(): void {\n    if (!this.errorElement || !this.formField) {\n      return;\n    }\n\n    const subscriptWrapper = this.formField.querySelector(\n      '.mat-form-field-subscript-wrapper'\n    );\n\n    if (subscriptWrapper?.contains(this.errorElement)) {\n      this.renderer.removeChild(subscriptWrapper, this.errorElement);\n    }\n\n    this.errorElement = null;\n\n    if (\n      this.formField &&\n      !this.formField.querySelector('.mat-error:not(.no-leading-space-error)')\n    ) {\n      this.renderer.removeClass(this.formField, 'mat-form-field-invalid');\n    }\n  }\n\n  private hasExistingMatError(): boolean {\n    const formField = this.el.nativeElement.closest('mat-form-field');\n    return !!formField?.querySelector('mat-error');\n  }\n\n  private scheduleHideError(): void {\n    this.clearHideErrorTimer();\n    this.hideErrorTimer = setTimeout(() => {\n      this.setLeadingSpaceError(false);\n    }, 3000);\n  }\n\n  private clearHideErrorTimer(): void {\n    if (this.hideErrorTimer) {\n      clearTimeout(this.hideErrorTimer);\n      this.hideErrorTimer = null;\n    }\n  }\n}\n","import { AbstractControl, ValidationErrors, ValidatorFn } from '@angular/forms';\n\nexport const LEADING_SPACE_ERROR_KEY = 'leadingSpace';\nexport const LEADING_SPACE_ERROR_MESSAGE = 'Empty space not allowed';\n\nexport function noLeadingSpaceValidator(): ValidatorFn {\n  return (control: AbstractControl): ValidationErrors | null => {\n    const value = control.value;\n    if (value == null || value === '') {\n      return null;\n    }\n    return typeof value === 'string' && value.startsWith(' ')\n      ? { [LEADING_SPACE_ERROR_KEY]: true }\n      : null;\n  };\n}\n","import { Component, OnInit, HostListener, ChangeDetectorRef } from '@angular/core';\nimport { UntypedFormBuilder, UntypedFormGroup, Validators } from '@angular/forms';\nimport { MatDialogRef } from '@angular/material/dialog';\nimport { HttpClient } from '@angular/common/http';\nimport { Observable, throwError } from 'rxjs';\nimport { catchError, map } from 'rxjs/operators';\n\nexport type FeedbackType =\n  | 'General feedback'\n  | 'Feature request'\n  | 'Report an issue'\n  | 'Support/Account/Billing'\n  | 'UI feedback';\n\nexport const FEEDBACK_TYPES: FeedbackType[] = [\n  'General feedback',\n  'Feature request',\n  'Report an issue',\n  'Support/Account/Billing',\n  'UI feedback',\n];\n\nexport interface FeedbackPayload {\n  type: FeedbackType;\n  satisfied: boolean | null;\n  email?: string;\n  attachments?: File[];\n}\n\nexport interface FeedbackResponse {\n  success: boolean;\n  message: string;\n  id?: string;\n}\n\ntype SubmitState = 'idle' | 'submitting' | 'success' | 'error';\n\n@Component({\n  selector: 'app-feedback-modal',\n  templateUrl: './feedback-modal.component.html',\n  styleUrls: ['./feedback-modal.component.scss']\n})\nexport class FeedbackModalComponent implements OnInit {\n  \n  private readonly API_BASE = 'https://your-api.example.com/api';\n  \n  feedbackForm!: UntypedFormGroup;\n  feedbackTypes: FeedbackType[] = FEEDBACK_TYPES;\n  typeDropdownOpen = false;\n  selectedFiles: File[] = [];\n  submitState: SubmitState = 'idle';\n  errorMessage = 'Please fill entries!';\n  successMessage = 'Feedback submitted successfully!';\n\n  constructor(\n    private fb: UntypedFormBuilder,\n    private http: HttpClient,\n    private dialogRef: MatDialogRef<FeedbackModalComponent>,\n    private cdr: ChangeDetectorRef\n  ) {}\n\n  ngOnInit(): void {\n    this.buildForm();\n  }\n\n  @HostListener('document:click', ['$event'])\n  onDocumentClick(event: MouseEvent): void {\n    const target = event.target as HTMLElement;\n    if (!target.closest('.hw-select')) {\n      this.typeDropdownOpen = false;\n      this.cdr.markForCheck();\n    }\n  }\n\n  @HostListener('document:keydown.escape')\n  onEscape(): void {\n    this.typeDropdownOpen = false;\n    this.close();\n  }\n\n  close(): void {\n    this.dialogRef.close();\n  }\n\n  stopPropagation(event: MouseEvent): void {\n    event.stopPropagation();\n  }\n\n  toggleTypeDropdown(event: MouseEvent): void {\n    event.stopPropagation();\n    this.typeDropdownOpen = !this.typeDropdownOpen;\n  }\n\n  selectType(type: FeedbackType, event: MouseEvent): void {\n    event.stopPropagation();\n    this.feedbackForm.get('type')!.setValue(type);\n    this.typeDropdownOpen = false;\n  }\n\n  get selectedType(): FeedbackType {\n    return this.feedbackForm.get('type')!.value;\n  }\n\n  onFileSelected(event: Event): void {\n    const input = event.target as HTMLInputElement;\n    if (input.files?.length) {\n      this.selectedFiles = [...this.selectedFiles, ...Array.from(input.files)];\n      input.value = '';\n      this.cdr.markForCheck();\n    }\n  }\n\n  removeFile(index: number): void {\n    this.selectedFiles = this.selectedFiles.filter((_, i) => i !== index);\n    this.cdr.markForCheck();\n  }\n\n  formatFileSize(bytes: number): string {\n    if (bytes === 0) return '0 B';\n    const k = 1024;\n    const sizes = ['B', 'KB', 'MB', 'GB'];\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\n    return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`;\n  }\n\n  onSubmit(): void {\n    if (this.feedbackForm.invalid || this.submitState === 'submitting') return;\n\n    this.submitState = 'submitting';\n    this.errorMessage = '';\n    this.cdr.markForCheck();\n\n    const { type, satisfied, email } = this.feedbackForm.value;\n    const payload: FeedbackPayload = {\n      type,\n      satisfied,\n      email: email || undefined,\n      attachments: this.selectedFiles,\n    };\n\n    this.submitFeedback(payload).subscribe({\n      next: () => {\n        this.submitState = 'success';\n        this.successMessage = 'Feedback submitted successfully! Thank you for your input.';\n        this.cdr.markForCheck();\n        setTimeout(() => {\n          this.close();\n        }, 3000);\n      },\n      error: () => {\n        this.submitState = 'error';\n        this.errorMessage = 'Please fill Entries.';\n        this.cdr.markForCheck();\n      },\n    });\n  }\n\n  private submitFeedback(payload: FeedbackPayload): Observable<FeedbackResponse> {\n    const form = new FormData();\n    form.append('type', payload.type);\n    form.append('satisfied', payload.satisfied !== null ? String(payload.satisfied) : '');\n    form.append('createdAt', new Date().toISOString());\n\n    if (payload.email) {\n      form.append('email', payload.email);\n    }\n\n    payload.attachments?.forEach((file) => {\n      form.append('attachments', file, file.name);\n    });\n\n    return this.http\n      .post<FeedbackResponse>(`${this.API_BASE}/feedback`, form)\n      .pipe(\n        map((res) => res),\n        catchError((err) => {\n          console.error('[FeedbackModal] API error:', err);\n          const msg = err?.error?.message ?? 'Submission failed. Please try again.';\n          return throwError(() => new Error(msg));\n        })\n      );\n  }\n\n  get isSubmitting(): boolean {\n    return this.submitState === 'submitting';\n  }\n\n  get isSuccess(): boolean {\n    return this.submitState === 'success';\n  }\n\n  private buildForm(): void {\n    this.feedbackForm = this.fb.group({\n      type: [this.feedbackTypes[0], Validators.required],\n      satisfied: [null],\n      email: ['', [Validators.email]],\n    });\n  }\n}\n","<div class=\"feedback-modal-container\">\n  <!-- Header -->\n  <div class=\"hw-modal__header\">\n    <h2 class=\"hw-modal__title\" id=\"hw-modal-title\">Feedback for Console Home</h2>\n    <button class=\"hw-modal__close\" type=\"button\"\n            aria-label=\"Close\" (click)=\"close()\">\n      <mat-icon>close</mat-icon>\n    </button>\n  </div>\n\n  <p class=\"hw-modal__subtitle\">Thank you for taking time to provide feedback.</p>\n\n  <!-- Success State -->\n  <div *ngIf=\"isSuccess\" class=\"hw-success\">\n    <div class=\"hw-success__circle\">\n      <mat-icon>check</mat-icon>\n    </div>\n    <p class=\"hw-success__msg\">{{ successMessage }}</p>\n  </div>\n\n  <!-- Form -->\n  <form *ngIf=\"!isSuccess\" [formGroup]=\"feedbackForm\"\n        (ngSubmit)=\"onSubmit()\" novalidate>\n\n    <!-- Type -->\n    <div class=\"hw-field\">\n      <label class=\"hw-label hw-label--req\">Type</label>\n      <p class=\"hw-hint\">Choose the type of feedback you are submitting.</p>\n\n      <div class=\"hw-select\" [class.hw-select--open]=\"typeDropdownOpen\">\n        <button type=\"button\" class=\"hw-select__trigger\"\n                (click)=\"toggleTypeDropdown($event)\"\n                [attr.aria-expanded]=\"typeDropdownOpen\">\n          <span>{{ selectedType }}</span>\n          <mat-icon class=\"hw-select__arrow\">expand_more</mat-icon>\n        </button>\n\n        <ul class=\"hw-select__list\" *ngIf=\"typeDropdownOpen\" role=\"listbox\">\n          <li *ngFor=\"let ft of feedbackTypes\"\n              class=\"hw-select__option\"\n              [class.hw-select__option--active]=\"ft === selectedType\"\n              role=\"option\"\n              (click)=\"selectType(ft, $event)\">\n            <span>{{ ft }}</span>\n            <mat-icon *ngIf=\"ft === selectedType\" class=\"hw-check\">check</mat-icon>\n          </li>\n        </ul>\n      </div>\n    </div>\n\n    <!-- Satisfaction -->\n    <div class=\"hw-field\">\n      <label class=\"hw-label\">Are you satisfied with your experience?</label>\n      <div class=\"hw-radios\">\n        <label class=\"hw-radio\">\n          <input type=\"radio\" formControlName=\"satisfied\" [value]=\"true\" />\n          <span class=\"hw-radio__dot\"></span>\n          Yes\n        </label>\n        <label class=\"hw-radio\">\n          <input type=\"radio\" formControlName=\"satisfied\" [value]=\"false\" />\n          <span class=\"hw-radio__dot\"></span>\n          No\n        </label>\n      </div>\n    </div>\n\n    <!-- Email -->\n    <div class=\"hw-field\">\n      <label class=\"hw-label\" for=\"hw-email\">\n        We may want to contact you about your feedback. If you agree, provide your\n        email address. <span class=\"hw-optional\">– optional</span>\n      </label>\n      <input id=\"hw-email\" type=\"email\" class=\"hw-input\"\n             [class.hw-input--err]=\"feedbackForm.get('email').invalid &&\n                                    feedbackForm.get('email').touched\"\n             formControlName=\"email\" autocomplete=\"email\" />\n      <span class=\"hw-err-msg\"\n            *ngIf=\"feedbackForm.get('email').invalid && feedbackForm.get('email').touched\">\n        Please enter a valid email address.\n      </span>\n      <p class=\"hw-hint hw-hint--xs\">\n        Personal information you provide will be handled per our Privacy Notice.\n      </p>\n    </div>\n\n    <!-- File Attachment -->\n    <div class=\"hw-field\">\n      <label class=\"hw-label\">File attachment</label>\n\n      <label class=\"hw-file-btn\" for=\"hw-file-input\">\n        <mat-icon>upload</mat-icon>\n        Choose files\n      </label>\n      <input id=\"hw-file-input\" type=\"file\" multiple\n             class=\"hw-file-hidden\" (change)=\"onFileSelected($event)\" />\n\n      <p class=\"hw-hint hw-hint--xs\">Please don't attach images with PII information</p>\n\n      <ul class=\"hw-files\" *ngIf=\"selectedFiles.length\">\n        <li *ngFor=\"let f of selectedFiles; let i = index\" class=\"hw-files__item\">\n          <mat-icon>insert_drive_file</mat-icon>\n          <span class=\"hw-files__name\">{{ f.name }}</span>\n          <span class=\"hw-files__size\">{{ formatFileSize(f.size) }}</span>\n          <button type=\"button\" class=\"hw-files__remove\"\n                  [attr.aria-label]=\"'Remove ' + f.name\" (click)=\"removeFile(i)\">\n            <mat-icon>close</mat-icon>\n          </button>\n        </li>\n      </ul>\n    </div>\n\n    <!-- Error Banner -->\n    <div class=\"hw-err-banner\" *ngIf=\"submitState === 'error'\" role=\"alert\">\n      <mat-icon>error_outline</mat-icon>\n      {{ errorMessage }}\n    </div>\n\n    <!-- Footer Actions -->\n    <div class=\"hw-modal__footer\">\n      <button type=\"button\" class=\"hw-btn hw-btn--ghost\"\n              (click)=\"close()\" [disabled]=\"isSubmitting\">\n        Cancel\n      </button>\n      <button type=\"submit\" class=\"hw-btn hw-btn--primary\"\n              [disabled]=\"isSubmitting || feedbackForm.invalid\">\n        <span *ngIf=\"!isSubmitting\">Submit</span>\n        <span *ngIf=\"isSubmitting\" class=\"hw-spinner\" aria-hidden=\"true\"></span>\n      </button>\n    </div>\n\n  </form>\n</div>\n","import { Component, Inject, OnInit } from '@angular/core';\nimport { MatDialogRef, MAT_DIALOG_DATA } from '@angular/material/dialog';\n\nexport interface DialogData {\n  message : string;\n  heading : string;\n}\n\n@Component({\n  selector: 'app-message-dialog',\n  templateUrl: './message-dialog.component.html',\n  styleUrls: ['./message-dialog.component.scss']\n})\nexport class MessageDialogComponent {\n\n  constructor(public dialogRef: MatDialogRef<MessageDialogComponent>,\n    @Inject(MAT_DIALOG_DATA) public data: DialogData) { }\n\n    onClose(){\n      this.dialogRef.close();\n    }\n\n}\n","<div mat-dialog-title>\n    <mat-icon class=\"close\" (click)=\"onClose()\" title=\"Close\">close</mat-icon>\n    <h4>{{data.heading}}</h4>\n</div>\n\n<div mat-dialog-content>\n    <div class=\"modal-content\">\n        <p>{{data.message}}</p>\n    </div>\n</div>\n\n<div mat-dialog-actions>\n    <button mat-flat-button class=\"actions-btns ok-btn\" color=\"primary\" (click)=\"onClose()\">OK</button>\n</div>","import { Component, Inject } from '@angular/core';\nimport { MatDialogRef, MAT_DIALOG_DATA } from '@angular/material/dialog';\nimport { Router } from '@angular/router';\n\nexport interface DialogData {\n  msg : any;\n}\n\n@Component({\n  selector: 'app-no-access',\n  templateUrl: './no-access.component.html',\n  styleUrls: ['./no-access.component.scss']\n})\nexport class NoAccessComponent {\n\n  constructor(public dialogRef: MatDialogRef<NoAccessComponent>,\n    @Inject(MAT_DIALOG_DATA) public data: DialogData, private router: Router) { }\n\n  onLogout(){\n    localStorage.clear();\n    this.router.navigateByUrl(\"/login\");\n    this.dialogRef.close();\n  }\n\n}\n\n\n","<div mat-dialog-content>\n    <div class=\"modal-content\">\n        <div class=\"space-icon space-noaccess\"></div>\n        <div class=\"space-title\">\n            Look's Like you do not have access to any Business. Please contact support team.\n        </div>\n        <p class=\"text-center hyper-link\" (click)=\"onLogout()\">Logout</p>\n    </div>\n\n</div>","import {\n  AfterViewChecked,\n  Component,\n  ComponentRef,\n  HostListener,\n  OnDestroy,\n  OnInit,\n  SimpleChange,\n  SimpleChanges,\n  Type,\n  ViewChild,\n  ViewContainerRef,\n} from '@angular/core';\nimport { Subscription } from 'rxjs';\nimport { Popover } from 'src/app/_services/utility/popover.service';\nimport { ShelfService } from './shelf.service';\nimport { SHELF_OPEN_DELAY_MS, SHELF_TRANSITION_MS, ShelfCancellable, ShelfSize, DEFAULT_SHELF_SIZE } from './shelf.models';\n\n@Component({\n  selector: 'app-shelf-shell',\n  templateUrl: './shelf-shell.component.html',\n  styleUrls: ['./shelf-shell.component.scss'],\n})\nexport class ShelfShellComponent implements OnInit, OnDestroy, AfterViewChecked {\n  @ViewChild('contentHost', { read: ViewContainerRef })\n  contentHost!: ViewContainerRef;\n\n  shelfOpen = false;\n  shelfMounted = false;\n  shelfSize: ShelfSize = DEFAULT_SHELF_SIZE;\n\n  private shelfSub?: Subscription;\n  private closeTimer?: ReturnType<typeof setTimeout>;\n  private componentRef: ComponentRef<unknown> | null = null;\n  private pendingMount: {\n    component: Type<unknown>;\n    inputs?: Record<string, unknown>;\n  } | null = null;\n\n  constructor(\n    private shelf: ShelfService,\n    private popover: Popover,\n  ) {}\n\n  ngOnInit(): void {\n    this.shelfSub = this.shelf.state$.subscribe((state) => {\n      this.shelfSize = state.size;\n      if (state.open && state.component) {\n        this.shelfMounted = true;\n        document.body.style.overflow = 'hidden';\n        this.pendingMount = {\n          component: state.component!,\n          inputs: state.inputs,\n        };\n        setTimeout(() => {\n          this.flushPendingMount();\n          this.shelfOpen = true;\n        }, SHELF_OPEN_DELAY_MS);\n      } else {\n        this.cancelShelfContentRequests();\n        this.shelfOpen = false;\n        document.body.style.overflow = '';\n        clearTimeout(this.closeTimer);\n        this.closeTimer = setTimeout(() => {\n          this.clearContent();\n          this.shelfMounted = false;\n        }, SHELF_TRANSITION_MS);\n      }\n    });\n  }\n\n  ngAfterViewChecked(): void {\n    if (this.pendingMount && this.contentHost && !this.componentRef) {\n      this.flushPendingMount();\n    }\n  }\n\n  ngOnDestroy(): void {\n    document.body.style.overflow = '';\n    this.shelfSub?.unsubscribe();\n    clearTimeout(this.closeTimer);\n    this.clearContent();\n  }\n\n  @HostListener('document:keydown.escape')\n  onEscape(): void {\n    if (this.popover.closeActive()) {\n      return;\n    }\n    if (this.shelfOpen) {\n      this.close();\n    }\n  }\n\n  close(): void {\n    this.shelf.close();\n  }\n\n  private flushPendingMount(): void {\n    if (!this.pendingMount || !this.contentHost) {\n      return;\n    }\n    const { component, inputs } = this.pendingMount;\n    this.pendingMount = null;\n    this.mountContent(component, inputs);\n  }\n\n  private mountContent(component: Type<unknown>, inputs?: Record<string, unknown>): void {\n    if (!this.contentHost) {\n      return;\n    }\n    this.clearContent();\n    this.componentRef = this.contentHost.createComponent(component);\n    if (inputs) {\n      this.applyInputs(this.componentRef.instance as object, inputs);\n    }\n    this.componentRef.changeDetectorRef.detectChanges();\n  }\n\n  /** Assigns @Input values and triggers ngOnChanges when present (required for dynamic createComponent). */\n  private applyInputs(instance: object, inputs: Record<string, unknown>): void {\n    const changes: SimpleChanges = {};\n    for (const [key, value] of Object.entries(inputs)) {\n      (instance as Record<string, unknown>)[key] = value;\n      changes[key] = new SimpleChange(undefined, value, true);\n    }\n    const onChanges = (instance as { ngOnChanges?: (c: SimpleChanges) => void }).ngOnChanges;\n    if (typeof onChanges === 'function') {\n      onChanges.call(instance, changes);\n    }\n  }\n\n  private clearContent(): void {\n    this.cancelShelfContentRequests();\n    this.componentRef?.destroy();\n    this.componentRef = null;\n    this.contentHost?.clear();\n  }\n\n  private cancelShelfContentRequests(): void {\n    const instance = this.componentRef?.instance as ShelfCancellable | undefined;\n    instance?.cancelShelfRequests?.();\n  }\n}\n","<div\n    class=\"shelf-backdrop\"\n    *ngIf=\"shelfMounted\"\n    [class.shelf-backdrop--visible]=\"shelfOpen\"\n    (click)=\"close()\"\n    aria-hidden=\"true\">\n</div>\n\n<aside\n    class=\"shelf-drawer\"\n    [class.shelf-drawer--open]=\"shelfOpen\"\n    [class.shelf-drawer--narrow]=\"shelfSize === 'narrow'\"\n    [class.shelf-drawer--wide]=\"shelfSize === 'wide'\"\n    [class.shelf-drawer--full]=\"shelfSize === 'full'\"\n    *ngIf=\"shelfMounted\"\n    role=\"dialog\"\n    aria-modal=\"true\"\n    aria-label=\"Side panel\">\n    <button\n        class=\"shelf-drawer__close\"\n        type=\"button\"\n        (click)=\"close()\"\n        aria-label=\"Close panel\">\n        <mat-icon>close</mat-icon>\n    </button>\n    <ng-container #contentHost></ng-container>\n</aside>\n","import { Type } from '@angular/core';\n\n/** Drawer width preset — set per `shelf.open()` call. */\nexport type ShelfSize = 'narrow' | 'default' | 'wide' | 'full';\n\nexport const DEFAULT_SHELF_SIZE: ShelfSize = 'default';\n\nexport interface ShelfOpenConfig<T = unknown> {\n  component: Type<T>;\n  inputs?: Partial<T> & Record<string, unknown>;\n  size?: ShelfSize;\n}\n\nexport interface ShelfState {\n  open: boolean;\n  component: Type<unknown> | null;\n  inputs?: Record<string, unknown>;\n  size: ShelfSize;\n}\n\n/** Optional hook for dynamically mounted shelf content to abort in-flight work on close. */\nexport interface ShelfCancellable {\n  cancelShelfRequests?: () => void;\n}\n\nexport const SHELF_TRANSITION_MS = 320;\nexport const SHELF_OPEN_DELAY_MS = 10;\n","import { Location } from '@angular/common';\nimport { Injectable, Type } from '@angular/core';\nimport { NavigationStart, Router } from '@angular/router';\nimport { BehaviorSubject } from 'rxjs';\nimport { filter, map } from 'rxjs/operators';\nimport { Popover } from 'src/app/_services/utility/popover.service';\nimport { ShelfOpenConfig, ShelfSize, ShelfState, DEFAULT_SHELF_SIZE } from './shelf.models';\n\nconst SHELF_HISTORY_STATE_KEY = 'guardrailShelf';\n\n@Injectable({ providedIn: 'root' })\nexport class ShelfService {\n  private readonly _state = new BehaviorSubject<ShelfState>({\n    open: false,\n    component: null,\n    size: DEFAULT_SHELF_SIZE,\n  });\n\n  /** True when open() pushed a history entry for back-to-close. */\n  private historyPushed = false;\n\n  readonly state$ = this._state.asObservable();\n  readonly isOpen$ = this.state$.pipe(map((s) => s.open));\n\n  constructor(\n    private location: Location,\n    private router: Router,\n    private popover: Popover,\n  ) {\n    // Same mechanism as MatDialog (CDK overlay disposeOnNavigation + Location).\n    this.location.subscribe(() => {\n      if (this.isOpen()) {\n        this.close({ fromHistory: true });\n      }\n    });\n\n    this.router.events\n      .pipe(filter((e): e is NavigationStart => e instanceof NavigationStart))\n      .subscribe(() => {\n        if (this.isOpen()) {\n          this.close({ fromHistory: true });\n        }\n      });\n  }\n\n  get snapshot(): ShelfState {\n    return this._state.value;\n  }\n\n  open<T>(\n    component: Type<T>,\n    inputs?: Partial<T> & Record<string, unknown>,\n    size?: ShelfSize,\n  ): void;\n  open<T>(config: ShelfOpenConfig<T>): void;\n  open<T>(\n    configOrComponent: ShelfOpenConfig<T> | Type<T>,\n    inputs?: Partial<T> & Record<string, unknown>,\n    size?: ShelfSize,\n  ): void {\n    const resolved = this.resolveOpenConfig(configOrComponent, inputs, size);\n    const wasOpen = this.isOpen();\n\n    this._state.next({\n      open: true,\n      component: resolved.component,\n      inputs: resolved.inputs,\n      size: resolved.size ?? DEFAULT_SHELF_SIZE,\n    });\n\n    if (!wasOpen) {\n      history.pushState({ [SHELF_HISTORY_STATE_KEY]: true }, '');\n      this.historyPushed = true;\n    }\n  }\n\n  close(options?: { fromHistory?: boolean }): void {\n    this.popover.closeActive();\n\n    if (!this.isOpen()) {\n      return;\n    }\n\n    const shouldPopHistory = this.historyPushed && !options?.fromHistory;\n    this.historyPushed = false;\n\n    this._state.next({\n      open: false,\n      component: null,\n      inputs: undefined,\n      size: DEFAULT_SHELF_SIZE,\n    });\n\n    if (shouldPopHistory) {\n      history.back();\n    }\n  }\n\n  isOpen(): boolean {\n    return this._state.value.open;\n  }\n\n  isShowing(component: Type<unknown>): boolean {\n    const state = this._state.value;\n    return state.open && state.component === component;\n  }\n\n  private resolveOpenConfig<T>(\n    configOrComponent: ShelfOpenConfig<T> | Type<T>,\n    inputs?: Partial<T> & Record<string, unknown>,\n    size?: ShelfSize,\n  ): ShelfOpenConfig<T> {\n    if (typeof configOrComponent === 'function') {\n      return {\n        component: configOrComponent,\n        inputs,\n        size: size ?? DEFAULT_SHELF_SIZE,\n      };\n    }\n    return {\n      ...configOrComponent,\n      size: configOrComponent.size ?? DEFAULT_SHELF_SIZE,\n    };\n  }\n}\n","import { Location } from '@angular/common';\nimport { Component, EventEmitter, Input, OnChanges, Output } from '@angular/core';\n\n@Component({\n  selector: 'app-sub-heading',\n  templateUrl: './sub-heading.component.html',\n  styleUrls: ['./sub-heading.component.scss']\n})\nexport class SubHeadingComponent implements OnChanges {\n  @Input() title_main ?: any = {};\n  @Input() desc_main ?: string='no description available'; \n  @Input() title_create?:string;\n  @Output() navLink = new EventEmitter<void>();\n  @Input() desc_create?:string='no description available';\n  @Input() main_title ?: boolean=true;\n  @Input() selectedIP ?:string;\n\n  constructor(private location: Location) { }\n\n  ngOnInit(): void {\n  }\n\n  ngOnChanges() {\n   \n  }\n\n  linkToMain(): void {\n    this.location.back();\n  }\n\n}\n","<div *ngIf=\"main_title\" class=\"flex-column\">\n        <span>{{title_main}}</span>\n        <small>{{desc_main}} </small>\n</div>\n\n<!-- subheading for  -->\n<div *ngIf=\"!main_title\" class=\"flex-column\">\n    <div class=\"flex\">\n        <span *ngIf=\"selectedIP\" class=\"tab-name\" (click)=\"linkToMain()\"><u>{{title_create}}</u> > </span>\n        <span *ngIf=\"!selectedIP\">&nbsp;{{title_create}}</span>\n        <div>&nbsp;{{selectedIP}}</div>\n    </div>\n    <!-- <small matTooltip=\"{{desc_create}}\">&nbsp;{{desc_create || \"-\"}} </small> -->\n    <small>&nbsp;{{desc_create || \"-\"}} </small>\n</div>","import { Component, OnInit, OnDestroy } from '@angular/core';\nimport { Subject } from 'rxjs';\nimport { takeUntil } from 'rxjs/operators';\nimport { SupportService } from '../_services/all-requests/support.service';\nimport { ThemeService } from '../_services/utility/theme.service';\n\n// ── Interfaces ────────────────────────────────────────────────\nexport interface SupportNavItem {\n  label: string;\n  icon: string;\n  teamId: number;\n}\n\nexport interface SupportNavCategory {\n  label: string;\n  teams: SupportNavItem[];\n}\n\nexport interface TeamMember {\n  _id: string;\n  name: string;\n  email: string;\n  title?: string;\n  image?: string;\n  mobile?: string | number;\n  status?: string;\n  color?: string;\n}\n\nexport interface Team {\n  id: number;\n  team_id: string;\n  name: string;\n  category?: string;\n  order?: number;\n  description?: string;\n  icon?: string;\n}\n\nexport interface TeamDetail {\n  on_call_users: TeamMember[];\n  start: number;   // Unix timestamp\n  end: number;     // Unix timestamp\n  name: string;\n  description?: string;\n}\n\nexport interface EscalationTier {\n  level: number;\n  members: TeamMember[];\n}\n\n// ── Component ─────────────────────────────────────────────────\n@Component({\n  selector: 'app-support-centre',\n  templateUrl: './support-centre.component.html',\n  styleUrls: ['./support-centre.component.scss'],\n  providers: [SupportService]\n})\nexport class SupportCentreComponent implements OnInit, OnDestroy {\n\n  // ── Nav / teams ───────────────────────────────────────────────\n  activeNavLabel = '';\n  activeTeamId: number | null = null;\n  activeCategoryLabel = '';\n  teams: Team[] = [];\n  navCategories: SupportNavCategory[] = [];\n\n  // ── Escalation tiers ─────────────────────────────────────────\n  tiers: EscalationTier[] = [];\n  loading = true;\n  error: string | null = null;\n\n  // ── On-call shift window ──────────────────────────────────────\n  shiftStart = '--';\n  shiftEnd   = '--';\n  teamDescription = '';\n\n  isDark = false;\n\n  // ── Copy feedback ─────────────────────────────────────────────\n  copiedKey: string | null = null;\n\n  private destroy$ = new Subject<void>();\n\n  constructor(private supportService: SupportService, private themeService: ThemeService) {}\n\n  ngOnInit(): void {\n    this.themeService.theme$\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(() => {\n        this.isDark = this.themeService.isDarkTheme();\n      });\n\n    this.loadTeams();\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  // ── Side-nav callback ─────────────────────────────────────────\n  onNavChanged(teamId: number): void {\n    const team = this.teams.find(t => t.id === teamId);\n    if (!team) {\n      this.tiers   = [];\n      this.loading = false;\n      this.error   = 'Team not found.';\n      return;\n    }\n\n    this.activeTeamId        = team.id;\n    this.activeNavLabel      = team.name;\n    this.activeCategoryLabel = team.category?.trim();\n    this.loadTeamMembers(team.id);\n  }\n\n  // ── Step 1: load all teams → build side-nav ───────────────────\n  private loadTeams(): void {\n    this.supportService.getTeams().subscribe(\n      (res: any) => {\n        const apiTeams: Team[] = (res && res.data && res.data.length)\n          ? res.data\n          : [];\n\n        if (apiTeams.length) {\n          this.teams         = apiTeams;\n          this.navCategories = this.buildNavCategories(apiTeams);\n          this.onNavChanged(apiTeams[0].id);\n        } else {\n          this.navCategories = [];\n          this.tiers         = [];\n          this.loading       = false;\n          this.error         = 'No teams available.';\n        }\n      },\n      () => {\n        this.navCategories = [];\n        this.tiers         = [];\n        this.loading       = false;\n        this.error         = 'Failed to load teams.';\n      }\n    );\n  }\n\n  // ── Step 2: load members for a specific team ──────────────────\n  private loadTeamMembers(teamId: number): void {\n    this.loading        = true;\n    this.error          = null;\n    this.shiftStart     = '--';\n    this.shiftEnd       = '--';\n    this.teamDescription = '';\n\n    this.supportService.getTeamMembers({ id: teamId }).subscribe(\n      (res: any) => {\n        const detail: TeamDetail | null =\n          (res && res.data && res.data.on_call_users) ? res.data : null;\n\n        if (detail) {\n          this.tiers           = this.buildTiers(detail.on_call_users || []);\n          this.shiftStart      = this.formatUnix(detail.start);\n          this.shiftEnd        = this.formatUnix(detail.end);\n          this.teamDescription = detail.description || '';\n        } else {\n          this.tiers = [];\n        }\n\n        this.loading = false;\n      },\n      () => {\n        this.tiers   = [];\n        this.loading = false;\n        this.error   = 'Failed to load team members.';\n      }\n    );\n  }\n\n  private buildNavCategories(teams: Team[]): SupportNavCategory[] {\n    const categories: SupportNavCategory[] = [];\n    const indexByCategory = new Map<string, number>();\n\n    for (const team of teams) {\n      const categoryLabel = team.category?.trim();\n      let index = indexByCategory.get(categoryLabel);\n\n      if (index === undefined) {\n        index = categories.length;\n        indexByCategory.set(categoryLabel, index);\n        categories.push({ label: categoryLabel, teams: [] });\n      }\n\n      categories[index].teams.push({\n        label: team.name,\n        icon: team.icon || 'group',\n        teamId: team.id,\n      });\n    }\n\n    return categories;\n  }\n\n  // ── Build escalation tiers (1 member per tier, in API order) ──\n  private buildTiers(members: TeamMember[]): EscalationTier[] {\n    if (!members.length) { return []; }\n    return members\n      .slice(0, 3)\n      .map((member, i) => ({ level: i + 1, members: [member] }));\n  }\n\n  // ── Format Unix timestamp → HH:MM DD MMM ─────────────────────\n  formatUnix(ts: number): string {\n    if (!ts) { return '--'; }\n    const d   = new Date(ts * 1000);\n    const hh  = String(d.getHours()).padStart(2, '0');\n    const mm  = String(d.getMinutes()).padStart(2, '0');\n    const day = String(d.getDate()).padStart(2, '0');\n    const mon = d.toLocaleString('default', { month: 'short' });\n    return `${hh}:${mm}, ${day} ${mon}`;\n  }\n\n  // ── Helpers ───────────────────────────────────────────────────\n  copyToClipboard(value: string, key: string): void {\n    if (!value) { return; }\n    navigator.clipboard.writeText(value).then(() => {\n      this.copiedKey = key;\n      setTimeout(() => { this.copiedKey = null; }, 2000);\n    }).catch(() => {\n      // fallback for older browsers\n      const el = document.createElement('textarea');\n      el.value = value;\n      document.body.appendChild(el);\n      el.select();\n      document.execCommand('copy');\n      document.body.removeChild(el);\n      this.copiedKey = key;\n      setTimeout(() => { this.copiedKey = null; }, 2000);\n    });\n  }\n\n  getInitials(name: string): string {\n    if (!name) { return '--'; }\n    return name.split(' ').slice(0, 2).map(w => w[0].toUpperCase()).join('');\n  }\n\n  tierColor(level: number): string {\n    const map: Record<number, string> = { 1: '#2563eb', 2: '#9333ea', 3: '#ea580c' };\n    return map[level] || '#2563eb';\n  }\n\n  isDarkTier(level: number): boolean {\n    // Apply dark styling to the last tier in the array\n    return this.tiers.length > 0 && level === this.tiers[this.tiers.length - 1].level;\n  }\n}\n","<div class=\"sc-layout\">\n\n  <!-- Side nav -->\n  <app-side-nav\n    [navCategories]=\"navCategories\"\n    [activeTeamId]=\"activeTeamId\"\n    [activeCategoryLabel]=\"activeCategoryLabel\"\n    (navChanged)=\"onNavChanged($event)\">\n  </app-side-nav>\n\n  <!-- Main content -->\n  <main class=\"sc-content\">\n\n    <!-- Header -->\n    <div class=\"sc-content-header\">\n      <div class=\"sc-content-header__left\">\n        <span class=\"sc-live-badge\">LIVE RESPONSE</span>\n        <h1 class=\"sc-content-header__title\">{{ activeNavLabel || '--' }}</h1>\n        <p class=\"sc-content-header__subtitle\">\n          {{ teamDescription || '--' }}\n        </p>\n      </div>\n\n      <!-- On-call shift window -->\n      <div class=\"sc-shift-block\">\n        <span class=\"sc-shift-block__label\">ON-CALL WINDOW</span>\n        <span class=\"sc-shift-block__value\">{{ shiftStart }} – {{ shiftEnd }}</span>\n      </div>\n    </div>\n\n    <!-- Loading -->\n    <div class=\"sc-loading\" *ngIf=\"loading\">\n      <mat-icon class=\"sc-loading__icon\">hourglass_top</mat-icon>\n      <span>Loading</span>\n    </div>\n\n    <!-- Error -->\n    <div class=\"sc-error\" *ngIf=\"error && !loading\">\n      <mat-icon>error_outline</mat-icon>\n      <span>{{ error }}</span>\n    </div>\n\n    <!-- No members -->\n    <div class=\"sc-error\" *ngIf=\"!loading && !error && tiers.length === 0\">\n      <mat-icon>group_off</mat-icon>\n      <span>No members found for this team.</span>\n    </div>\n\n    <!-- All tiers in one row -->\n    <ng-container *ngIf=\"!loading && !error && tiers.length > 0\">\n      <div class=\"sc-tiers-row\">\n\n        <div *ngFor=\"let tier of tiers\" class=\"sc-tier\">\n\n          <!-- Tier header: badge + rule -->\n          <div class=\"sc-tier__header\">\n            <span class=\"sc-tier__badge\" [style.background]=\"tierColor(tier.level)\">\n              {{ tier.level }}\n            </span>\n            <div class=\"sc-tier__rule\"></div>\n          </div>\n\n          <!-- ID cards -->\n          <div class=\"sc-tier__cards\">\n            <div\n              *ngFor=\"let member of tier.members\"\n              class=\"sc-id-card\"\n              [class.sc-id-card--dark]=\"isDarkTier(tier.level)\"\n              [class.sc-id-card--dark-theme]=\"isDarkTier(tier.level) && isDark\"\n              [class.sc-id-card--light-theme]=\"isDarkTier(tier.level) && !isDark\"\n            >\n\n              <!-- Top colour band -->\n              <div class=\"sc-id-card__band\" [style.background]=\"tierColor(tier.level)\"></div>\n\n              <!-- Avatar -->\n              <div class=\"sc-id-card__avatar-wrap\">\n                <img\n                  *ngIf=\"member.image\"\n                  [src]=\"member.image\"\n                  [alt]=\"member.name\"\n                  class=\"sc-id-card__avatar\"\n                  (error)=\"member.image = null\" />\n                <div\n                  *ngIf=\"!member.image\"\n                  class=\"sc-id-card__avatar sc-id-card__avatar--initials\"\n                  [style.background]=\"member.color || '#6b7fa3'\">\n                  {{ getInitials(member.name) }}\n                </div>\n              </div>\n\n              <!-- Info -->\n              <div class=\"sc-id-card__body\">\n                <span class=\"sc-id-card__name\">{{ member.name || '--' }}</span>\n                <span class=\"sc-id-card__title\">{{ member.title || '--' }}</span>\n                <div class=\"sc-id-card__divider\"></div>\n\n                <!-- Phone -->\n                <div class=\"sc-id-card__row\">\n                  <mat-icon class=\"sc-id-card__row-icon\">phone_iphone</mat-icon>\n                  <span class=\"sc-id-card__row-text\">{{ member.mobile || '--' }}</span>\n                  <button\n                    *ngIf=\"member.mobile\"\n                    class=\"sc-id-card__copy-btn\"\n                    [class.sc-id-card__copy-btn--copied]=\"copiedKey === member._id + '_mobile'\"\n                    (click)=\"copyToClipboard(member.mobile?.toString(), member._id + '_mobile')\"\n                    matTooltip=\"Copy\"\n                    type=\"button\">\n                    <mat-icon>{{ copiedKey === member._id + '_mobile' ? 'check' : 'content_copy' }}</mat-icon>\n                  </button>\n                </div>\n\n                <!-- Email -->\n                <div class=\"sc-id-card__row\">\n                  <mat-icon class=\"sc-id-card__row-icon\">mail_outline</mat-icon>\n                  <span class=\"sc-id-card__row-text\">{{ member.email || 'No Email Available' }}</span>\n                  <button\n                    *ngIf=\"member.email\"\n                    class=\"sc-id-card__copy-btn\"\n                    [class.sc-id-card__copy-btn--copied]=\"copiedKey === member._id + '_email'\"\n                    (click)=\"copyToClipboard(member.email, member._id + '_email')\"\n                    matTooltip=\"Copy\"\n                    type=\"button\">\n                    <mat-icon>{{ copiedKey === member._id + '_email' ? 'check' : 'content_copy' }}</mat-icon>\n                  </button>\n                </div>\n              </div>\n\n            </div>\n          </div>\n\n        </div><!-- /sc-tier -->\n\n      </div><!-- /sc-tiers-row -->\n    </ng-container>\n\n  </main>\n\n</div>\n","import { Component, OnInit, OnDestroy, ElementRef, HostListener } from '@angular/core';\nimport { Router } from '@angular/router';\nimport { Subject } from 'rxjs';\nimport { takeUntil } from 'rxjs/operators';\nimport { CommonService } from 'src/app/_services/all-requests/common.service';\nimport { HeaderPanelService } from 'src/app/_services/utility/header-panel.service';\nimport { allRoutesMap } from 'src/constants/url.constants';\nimport { mapProductUpdate, ProductUpdate } from '../product-update.model';\n\nconst POPUP_LIMIT = 5;\n\n@Component({\n  selector: 'app-new-updates',\n  templateUrl: './new-updates.component.html',\n  styleUrls: ['./new-updates.component.scss'],\n  providers: [CommonService],\n})\nexport class NewUpdatesComponent implements OnInit, OnDestroy {\n\n  isOpen = false;\n  updates: ProductUpdate[] = [];\n  loading = false;\n  error = false;\n\n  private destroy$ = new Subject<void>();\n  private readonly panelId = 'whats-new';\n\n  constructor(\n    private elRef: ElementRef,\n    private commonService: CommonService,\n    private headerPanelService: HeaderPanelService,\n    private router: Router,\n  ) {}\n\n  ngOnInit(): void {\n    this.headerPanelService.close$\n      .pipe(takeUntil(this.destroy$))\n      .subscribe((exceptPanelId) => {\n        if (exceptPanelId !== this.panelId) {\n          this.isOpen = false;\n        }\n      });\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  trackByUpdateId(index: number, update: ProductUpdate): number {\n    return update.id;\n  }\n\n  private loadUpdates(): void {\n    if (this.updates.length || this.loading) {\n      return;\n    }\n\n    this.loading = true;\n    this.error = false;\n\n    this.commonService.getProductUpdates({ limit: POPUP_LIMIT, page: 1 })\n      .pipe(takeUntil(this.destroy$))\n      .subscribe({\n        next: (res: any) => {\n          this.loading = false;\n          if (res?.status === 1 && res.data?.length) {\n            this.updates = res.data\n              .filter((item: any) => item.display !== false)\n              .map((item: any) => mapProductUpdate(item));\n          }\n        },\n        error: () => {\n          this.loading = false;\n          this.error = true;\n        },\n      });\n  }\n\n  @HostListener('document:click', ['$event'])\n  onDocumentClick(event: MouseEvent): void {\n    if (!this.elRef.nativeElement.contains(event.target as Node)) {\n      this.isOpen = false;\n    }\n  }\n\n  @HostListener('document:keydown.escape')\n  onEscape(): void {\n    this.headerPanelService.requestClose();\n  }\n\n  toggle(event: MouseEvent): void {\n    event.stopPropagation();\n    this.headerPanelService.requestClose(this.panelId);\n    this.isOpen = !this.isOpen;\n    if (this.isOpen) {\n      this.loadUpdates();\n    }\n  }\n\n  viewReleaseLog(event: MouseEvent): void {\n    event.stopPropagation();\n    this.isOpen = false;\n    this.router.navigateByUrl(allRoutesMap['product-updates']);\n  }\n}\n","<div class=\"updates-wrapper\">\n  <button\n    class=\"header-icon-btn updates-trigger\"\n    [class.updates-trigger--active]=\"isOpen\"\n    (click)=\"toggle($event)\"\n    matTooltip=\"What's New\"\n    matTooltipPosition=\"below\"\n    aria-label=\"What's New\"\n    [attr.aria-expanded]=\"isOpen\"\n    aria-haspopup=\"true\"\n    type=\"button\"\n  >\n    <span class=\"gr-sprite gr-sprite-gr-icons gr-sprite-whats-new\"></span>\n  </button>\n\n  <div\n    class=\"updates-dropdown\"\n    [class.updates-dropdown--open]=\"isOpen\"\n    role=\"menu\"\n    (click)=\"$event.stopPropagation()\"\n  >\n    <div class=\"updates-container\">\n      <div class=\"updates-header\">\n        <div class=\"updates-header__title\">\n          <mat-icon class=\"updates-header__icon\">celebration</mat-icon>\n          <h3>What's New</h3>\n        </div>\n        <div class=\"updates-header__subtitle\">\n          Latest updates and improvements\n        </div>\n      </div>\n\n      <div class=\"updates-list\">\n        <div class=\"updates-empty\" *ngIf=\"loading\">\n          <mat-spinner [diameter]=\"28\"></mat-spinner>\n        </div>\n\n        <div\n          *ngFor=\"let update of updates; trackBy: trackByUpdateId\"\n          class=\"update-item\"\n          [ngClass]=\"update.typeClass\"\n        >\n          <div class=\"update-item__icon\">\n            <mat-icon>{{ update.displayIcon }}</mat-icon>\n          </div>\n          <div class=\"update-item__content\">\n            <div class=\"update-item__header\">\n              <h4 class=\"update-item__title\">{{ update.title }}</h4>\n              <span class=\"update-item__badge\">{{\n                update.category || update.type\n              }}</span>\n            </div>\n            <p class=\"update-item__description\">{{ update.description }}</p>\n            <span class=\"update-item__date\">{{ update.relativeDate }}</span>\n          </div>\n        </div>\n\n        <div\n          class=\"updates-empty\"\n          *ngIf=\"!loading && !updates.length && !error\"\n        >\n          No recent updates\n        </div>\n\n        <div class=\"updates-empty\" *ngIf=\"error\">Failed to load updates</div>\n      </div>\n\n      <div class=\"updates-footer\">\n        <a class=\"updates-footer__link\" (click)=\"viewReleaseLog($event)\">\n          View release log\n          <mat-icon>arrow_forward</mat-icon>\n        </a>\n      </div>\n    </div>\n  </div>\n</div>\n","export const CR_DETAIL_BASE_URL = 'https://times.spog.ai/change-request/details?id=';\n\nexport type ProductUpdateType = 'feature' | 'improvement' | 'bugfix';\n\nexport interface ProductUpdateParticipant {\n  user_id: number;\n  role: string;\n  user_name: string;\n  user_email: string;\n  user_avatar: string;\n  title: string;\n  location: string;\n  department: string;\n  organization: string;\n}\n\nexport interface ParticipantGroup {\n  key: string;\n  label: string;\n  icon: string;\n  members: ProductUpdateParticipant[];\n}\n\nconst PARTICIPANT_ROLE_ORDER = ['developer', 'qa', 'approver'] as const;\n\nconst PARTICIPANT_GROUP_META: Record<string, { label: string; icon: string }> = {\n  developer: { label: 'Developers', icon: 'groups' },\n  qa: { label: 'QA', icon: 'person' },\n  approver: { label: 'Approvers', icon: 'shield' },\n};\n\n\n\nexport function groupParticipants(participants: ProductUpdateParticipant[]): ParticipantGroup[] {\n  const grouped = new Map<string, ProductUpdateParticipant[]>();\n\n  for (const participant of participants) {\n    const roleKey = participant.role.toLowerCase();\n    const members = grouped.get(roleKey) ?? [];\n    members.push(participant);\n    grouped.set(roleKey, members);\n  }\n\n  const ordered: ParticipantGroup[] = PARTICIPANT_ROLE_ORDER\n    .filter((role) => grouped.has(role))\n    .map((role) => ({\n      key: role,\n      label: PARTICIPANT_GROUP_META[role].label,\n      icon: PARTICIPANT_GROUP_META[role].icon,\n      members: grouped.get(role) ?? [],\n    }));\n\n  for (const [roleKey, members] of grouped.entries()) {\n    if (!PARTICIPANT_ROLE_ORDER.includes(roleKey as typeof PARTICIPANT_ROLE_ORDER[number])) {\n      ordered.push({\n        key: roleKey,\n        label: members[0]?.role || roleKey,\n        icon: 'person',\n        members,\n      });\n    }\n  }\n\n  return ordered;\n}\n\nexport interface ProductUpdate {\n  id: number;\n  title: string;\n  description: string;\n  category: string;\n  type: ProductUpdateType;\n  display: boolean;\n  date: string;\n  cr_number: string;\n  participants: ProductUpdateParticipant[];\n  icon?: string;\n  relativeDate?: string;\n  formattedDate?: string;\n  displayDate?: string;\n  typeClass?: string;\n  displayIcon?: string;\n  participantGroups: ParticipantGroup[];\n  crUrl: string;\n}\n\nexport interface ProductUpdateMonthGroup {\n  key: string;\n  label: string;\n  updates: ProductUpdate[];\n}\n\nconst UNDATED_MONTH_KEY = 'undated';\n\nexport function groupUpdatesByMonth(updates: ProductUpdate[]): ProductUpdateMonthGroup[] {\n  const grouped = new Map<string, ProductUpdateMonthGroup>();\n\n  for (const update of updates) {\n    const date = new Date(update.date);\n    let key: string;\n    let label: string;\n\n    if (!update.date || isNaN(date.getTime())) {\n      key = UNDATED_MONTH_KEY;\n      label = 'Undated';\n    } else {\n      key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;\n      label = date.toLocaleString('default', { month: 'long', year: 'numeric' });\n    }\n\n    const existing = grouped.get(key);\n    if (existing) {\n      existing.updates.push(update);\n    } else {\n      grouped.set(key, { key, label, updates: [update] });\n    }\n  }\n\n  const groups = Array.from(grouped.values());\n\n  for (const group of groups) {\n    group.updates.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\n  }\n\n  groups.sort((a, b) => {\n    if (a.key === UNDATED_MONTH_KEY) { return 1; }\n    if (b.key === UNDATED_MONTH_KEY) { return -1; }\n    return b.key.localeCompare(a.key);\n  });\n\n  return groups;\n}\n\nexport function mapProductUpdate(item: any): ProductUpdate {\n  const category = (item.category || '').toLowerCase();\n  let type: ProductUpdateType = 'feature';\n\n  if (category === 'improvment' || category === 'improvement') {\n    type = 'improvement';\n  } else if (category === 'bugfix') {\n    type = 'bugfix';\n  }\n\n  const participants = Array.isArray(item.participants) ? item.participants : [];\n  const cr_number = item.cr_number || '';\n\n  return {\n    id: item.id,\n    title: item.title || '',\n    description: item.description || '',\n    date: item.date || '',\n    category: item.category || '',\n    type,\n    display: item.display !== false,\n    cr_number,\n    participants,\n    icon: item.icon || undefined,\n    relativeDate: formatRelativeDate(item.date),\n    formattedDate: formatDisplayDate(item.date),\n    displayDate: formatDisplayDateOnly(item.date),\n    typeClass: getUpdateColorClass(type),\n    displayIcon: item.icon || getUpdateIcon(type),\n    participantGroups: groupParticipants(participants),\n    crUrl: cr_number ? `${CR_DETAIL_BASE_URL}${encodeURIComponent(cr_number)}` : '',\n  };\n}\n\nexport function getUpdateIcon(type: ProductUpdateType): string {\n  switch (type) {\n    case 'feature':     return 'new_releases';\n    case 'improvement': return 'trending_up';\n    case 'bugfix':      return 'build';\n    default:            return 'info';\n  }\n}\n\nexport function getUpdateColorClass(type: ProductUpdateType): string {\n  switch (type) {\n    case 'feature':     return 'update-feature';\n    case 'improvement': return 'update-improvement';\n    case 'bugfix':      return 'update-bugfix';\n    default:            return '';\n  }\n}\n\nexport function formatDisplayDate(dateString: string): string {\n  if (!dateString) { return '-'; }\n\n  const date = new Date(dateString);\n  if (isNaN(date.getTime())) { return '-'; }\n\n  return date.toLocaleString('default', {\n    day: '2-digit',\n    month: 'short',\n    year: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n  });\n}\n\nexport function formatDisplayDateOnly(dateString: string): string {\n  if (!dateString) { return '-'; }\n\n  const date = new Date(dateString);\n  if (isNaN(date.getTime())) { return '-'; }\n\n  return date.toLocaleString('default', {\n    day: '2-digit',\n    month: 'short',\n    year: 'numeric',\n  });\n}\n\nexport function formatRelativeDate(dateString: string): string {\n  if (!dateString) { return ''; }\n\n  const date = new Date(dateString);\n  const now = new Date();\n\n  if (isNaN(date.getTime())) { return ''; }\n\n  const diffMs = now.getTime() - date.getTime();\n\n  if (diffMs < 0) { return 'Just now'; }\n\n  const minute = 60 * 1000;\n  const hour = 60 * minute;\n  const day = 24 * hour;\n\n  const minutes = Math.floor(diffMs / minute);\n  const hours = Math.floor(diffMs / hour);\n\n  const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate());\n  const startOfDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());\n  const days = Math.floor((startOfToday.getTime() - startOfDate.getTime()) / day);\n\n  if (minutes < 1) { return 'Just now'; }\n  if (minutes < 60) { return `${minutes} min${minutes > 1 ? 's' : ''} ago`; }\n  if (days === 0) { return `${hours} hour${hours > 1 ? 's' : ''} ago`; }\n  if (days === 1) { return 'Yesterday'; }\n  if (days < 7) { return `${days} days ago`; }\n  if (days < 30) {\n    const weeks = Math.floor(days / 7);\n    return `${weeks} week${weeks > 1 ? 's' : ''} ago`;\n  }\n  if (days < 365) {\n    const months = Math.floor(days / 30);\n    return `${months} month${months > 1 ? 's' : ''} ago`;\n  }\n\n  const years = Math.floor(days / 365);\n  return `${years} year${years > 1 ? 's' : ''} ago`;\n}\n","export const appConstants = {\n  // apiHost: 'http://localhost:3000',\n  apiHost: '',\n  s3Url: 'https://sf-objects-s3.tilc.in/sf-objects/keystone-webapp/',\n\n  s3AccountsIconUrl: 'http://keystone-webapp.s3.ap-south-1.amazonaws.com/cloud-accounts/',\n  minIOBucketUrl:'https://sf-objects-s3.tilc.in/sf-objects/guardrail-assets/',\n  minIOBucketUrlAggreement:'https://sf-objects-s3.tilc.in/sf-objects',\n\n  LANDING_PAGE_URL: \"/dashboard/home\",\n  pagination: {\n    pageSize: 50,\n    pageSizeOptions: [5, 10, 20, 50, 100]\n  },\n  statusColorMapping: {\n    red: 'DOWN',\n    grey: 'FLAPPING',\n    yellow: 'DOWN',\n    green: 'RESOLVED'\n  },\n  health: {\n    1: 'Up',\n    2: 'Down'\n  },\n  location: {\n    1: 'Mumbai',\n    2: 'Chennai'\n  },\n  serverType: ['VM', 'Physical'],\n  vmStatus: ['MANAGED', 'UNMANAGED'],\n  binaryList : [\n    {value : 'yes', name : 'Yes'},\n    {value : 'no', name : 'No'}\n  ],\n  serverEnv: [\n    { value: 2, display: 'Prod', name: 'Production' },\n    { value: 3, display: 'PreProd', name: 'PreProd' },\n    { value: 1, display: 'Staging', name: 'Staging' },\n    { value: 4, display: 'QA', name: 'QA' },\n    { value: 5, display: 'DR', name: 'DR' }\n  ],\n  otherEnv: [\n    { value: 1, display: 'Prod', name: 'Production' },\n    { value: 2, display: 'PreProd', name: 'PreProd' },\n    { value: 3, display: 'Staging', name: 'Staging' },\n    { value: 4, display: 'QA', name: 'QA' },\n    { value: 5, display: 'DR', name: 'DR' }\n  ],\n  vmTemplate: ['Database', 'Application'],\n  osType: ['Centos', 'Ubuntu', 'Windows', 'RHEL'],\n  dateRangeOptions: [\n    { display: 'Last 30 Mins', value: 0.5, type: 'hours' },\n    { display: 'Last 1 Hr', value: 1, type: 'hours' },\n    { display: 'Last 3 Hrs', value: 3, type: 'hours' },\n    { display: 'Last 24 Hrs', value: 24, type: 'hours' },\n    { display: 'Last 7 Days',