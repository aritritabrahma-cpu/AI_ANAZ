data?.message\n\t\t\t\t|| \"Something went wrong. Please try again.\";\n\t\t\treturn throwError(() => message);\n\t\t}\n\n\t\tif(ERROR_400_EXCLUDE_PATHS.indexOf(url.pathname) >= 0 && error.status === 400){\n\t\t\treturn throwError({code: 400, message: error.error.message})\n\t\t}\n\n\t\t// If the user is not authorised or token has expired\n\t\tif (error.status && error.status == 401) {\n\t\t\tconst selectedAccountName = localStorage.getItem('SELECTED_ACCOUNT_NAME');\n\t\t\tlocalStorage.clear();\n\t\t\tlocalStorage.setItem('SELECTED_ACCOUNT_NAME', selectedAccountName);\n\t\t\twindow.location.href = window.location.origin;\n\t\t}\n\t\telse if (error.status && error.status == 404) {\n\t\t\treturn throwError('No data found')\n\t\t}\n\t\telse if (error.status && error.status == 403) {\n\t\t\treturn throwError(error.error.message || \"User doesn't have permission to access!!\")\n\t\t}\n\t\telse if (error.error && error.error.message) {\n\t\t\t// A client-side or network error occurred. Handle it accordingly.\n\t\t\treturn throwError(error.error.message);\n\t\t}\n\t\telse if (error.error && error.error.data) {\n\t\t\treturn throwError(error.error.data.message);\n\t\t}\n\t\telse {\n\t\t\t// The backend returned an unsuccessful response code.\n\t\t\t// The response body may contain clues as to what went wrong,\n\t\t\treturn throwError(error.statusText);\n\t\t}\n\n\t}\n\n\tgetHeaders(requestMethod, addUserInfo = true, file = false) {\n\t\tconst userInfoContent = localStorage.getItem(USER_INFO) || \"{}\";\n\t\tconst userInfo = JSON.parse(userInfoContent);\n\t\tconst headers = {};\n\t\tif (([\"POST\", \"PUT\", \"PATCH\"].indexOf(requestMethod) != -1) && !file) {\n\t\t\theaders[\"Content-Type\"] = \"application/json\";\n\t\t}\n\t\tif (addUserInfo) {\n\t\t\theaders['X-Email'] = userInfo.userprincipalname || \"\";\n\t\t\theaders['X-Token'] = localStorage.getItem(TOKEN_NAME) || \"\";\n\t\t}\n\t\treturn new HttpHeaders(headers);\n\t}\n\n\tmakeGetRequest(options: any, addUserInfo = true): Observable<any> {\n\t\toptions.headers = this.getHeaders(\"GET\", addUserInfo);\n\t\treturn this.http.get<any>(options.path, options).pipe(\n\t\t\ttimeout(180000),catchError(this.handleError)\n\t\t)\n\t}\n\n\tmakePostRequest(options: any, addUserInfo = true, file = false): Observable<any> {\n\t\tconst opt = {\n\t\t\theaders : this.getHeaders(\"POST\", addUserInfo, file)\n\t\t};\n\t\treturn this.http.post<any>(options.path, options.params, opt).pipe(\n\t\t\tcatchError(this.handleError)\n\t\t)\n\t}\n\n\tmakePutRequest(options: any, addUserInfo = true) {\n\t\tconst opt = {\n\t\t\theaders : this.getHeaders(\"PUT\", addUserInfo)\n\t\t};\n\t\treturn this.http.put<any>(options.path, options.params, opt).pipe(\n\t\t\ttimeout(180000),catchError(this.handleError)\n\t\t)\n\t}\n\n\tmakeDeleteRequest(options: any, addUserInfo = true): Observable<any> {\n\t\tconst opt: { headers: HttpHeaders; body?: any; params?: any } = {\n\t\t\theaders: this.getHeaders(\"DELETE\", addUserInfo),\n\t\t};\n\t\tif (options.body !== undefined) {\n\t\t\topt.body = options.body;\n\t\t}\n\t\tif (options.params !== undefined) {\n\t\t\topt.params = options.params;\n\t\t}\n\t\treturn this.http.delete<any>(options.path, opt).pipe(\n\t\t\ttimeout(180000),catchError(this.handleError)\n\t\t)\n\t}\n\n\tmakeZipPostRequest(options: any, addUserInfo = true, file = false) {\n\t\tconst opt = {\n\t\t\theaders : this.getHeaders(\"POST\", addUserInfo, file),\n\t\t\tresponseType: 'arraybuffer' as 'json'\n\t\t};\n\t\treturn this.http.post<ArrayBuffer>(options.path, options.params, opt).pipe(\n\t\t\tcatchError(this.handleError)\n\t\t)\n\t}\n}","// httpcancel.service.ts\nimport { Injectable } from '@angular/core';\nimport { Subject } from 'rxjs';\n\n@Injectable()\nexport class HttpCancelService {\n\n    private pendingHTTPRequests$ = new Subject<void>();\n\n  constructor() { }\n\n  // Cancel Pending HTTP calls\n  public cancelPendingRequests() {\n    this.pendingHTTPRequests$.next();\n  }\n\n  public onCancelPendingRequests() {\n    return this.pendingHTTPRequests$.asObservable();\n  }\n\n}","import { ErrorHandler, Injectable } from \"@angular/core\";\n\n@Injectable()\n\nexport class GlobalErrorHandler implements ErrorHandler{\n  handleError(error: any): void {\n    const chunkFailedMessage = /Loading chunk [\\d]+ failed/;\n    console.log(error)\n    if(chunkFailedMessage.test(error.message)) {\n      console.log(\"Loading chunk error occured\")\n           window.location.reload();\n    }\n  }\n}","import { Injectable } from '@angular/core';\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class CookieService {\n\n  get(name: string): string | null {\n    const match = document.cookie.match(new RegExp(`(?:^|; )${name.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')}=([^;]*)`));\n    return match ? decodeURIComponent(match[1]) : null;\n  }\n\n  set(name: string, value: string, days: number): void {\n    const expires = new Date();\n    expires.setTime(expires.getTime() + days * 24 * 60 * 60 * 1000);\n    document.cookie = `${name}=${encodeURIComponent(value)};expires=${expires.toUTCString()};path=/;SameSite=Lax`;\n  }\n\n  delete(name: string): void {\n    document.cookie = `${name}=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/;SameSite=Lax`;\n  }\n}\n","import { Injectable } from '@angular/core';\n\n@Injectable()\nexport class CsvDownloadService {\n\n\tconstructor(){\n\t}\n\n\ttextToCsv = (downloadText,filename) => {\n        let universalBOM = \"\\uFEFF\";\n      let encodedUri  = 'data:text/csv; charset=utf-8,' + encodeURIComponent(universalBOM+downloadText)\n        var link = document.createElement(\"a\");\n        link.setAttribute(\"href\", encodedUri);\n        link.setAttribute(\"download\", filename + '.csv');\n        document.body.appendChild(link); \n      \n        link.click();\n    }\n\n    downloadTextFile = (downloadText,filename)=>{\n        let dataUrl = \"data:text/plain;charset=utf-8,\" + encodeURIComponent(downloadText)\n        var link = document.createElement(\"a\");\n        link.setAttribute(\"href\", dataUrl);\n        link.setAttribute(\"download\", filename + '.txt');\n        document.body.appendChild(link); \n      \n        link.click();\n    }\n\n    zipDownload = (data, name)=> {\n      const blob = new Blob([data as BlobPart], {\n        type: 'application/zip'\n      });\n      let url = window.URL.createObjectURL(blob);\n      let link = document.createElement(\"a\");\n      link.setAttribute(\"href\", url);\n      link.setAttribute(\"download\", name + '.zip');\n      document.body.appendChild(link); \n    \n      link.click();\n    }\n}\n","import { Injectable } from '@angular/core';\nimport { Subject } from 'rxjs';\n\n@Injectable({\n    providedIn: 'root'\n  })\nexport class EventService {\n    // Observable string sources\n    private emitChangeSource = new Subject<any>();\n\n    // Observable string streams\n    changeEmitted$ = this.emitChangeSource.asObservable();\n\n    // Service message commands\n    emitChange(change: any) {\n        this.emitChangeSource.next(change);\n    }\n\n    clearChanges(){\n        this.emitChangeSource.next(undefined);\n    }\n\n}","import { Injectable } from '@angular/core';\nimport { Subject } from 'rxjs';\n\n@Injectable({\n  providedIn: 'root',\n})\nexport class HeaderPanelService {\n  private readonly closeSubject = new Subject<string>();\n  readonly close$ = this.closeSubject.asObservable();\n\n  requestClose(exceptPanelId = ''): void {\n    this.closeSubject.next(exceptPanelId);\n  }\n}\n","import { Injectable } from \"@angular/core\";\nimport {\n  ACCOUNT_INFO,\n  TOKEN_NAME,\n  SELECTED_ACCOUNT,\n  USER_INFO,\n} from \"../../../constants/local.storage\";\nimport { Router } from \"@angular/router\";\nimport { NoAccessComponent } from \"../../shared/no-access/no-access.component\";\nimport { MatDialog } from \"@angular/material/dialog\";\nimport { MessageDialogComponent } from \"src/app/shared/message-dialog/message-dialog.component\";\n\n@Injectable()\nexport class LocalStorageService {\n  constructor(\n    private router: Router,\n    public dialog: MatDialog,\n  ) {}\n\n  // get list of account ids\n  accountIdList = () => {\n    const accInfo = localStorage.getItem(ACCOUNT_INFO);\n    let accObj = {};\n    if (accInfo) {\n      accObj = JSON.parse(accInfo);\n    }\n    const accList = [];\n    for (const i in accObj) {\n      accList.push(accObj[i].account_id);\n    }\n    return accList;\n  };\n\n  // get list of accounts\n  accountsList = () => {\n    const accInfo = localStorage.getItem(ACCOUNT_INFO);\n    let accObj = {};\n    if (accInfo) {\n      accObj = JSON.parse(accInfo);\n    }\n    const accList = [];\n    for (const i in accObj) {\n      const obj = { id: accObj[i].account_id, name: accObj[i].account_name };\n      accList.push(obj);\n    }\n    return accList;\n  };\n\n  getUserDetails() {\n    const userInfo = localStorage.getItem(USER_INFO);\n    if (userInfo) {\n      return JSON.parse(userInfo);\n    }\n    return {};\n  }\n\n  getUserEmail() {\n    let userInfo = localStorage.getItem(USER_INFO);\n    let userEmail = null;\n    if (userInfo) {\n      userInfo = JSON.parse(userInfo);\n      userEmail = userInfo[\"email\"];\n    }\n    return userEmail;\n  }\n  getSelectedAccount() {\n    let selectedAccount: any = null;\n    const accountList = JSON.parse(localStorage.getItem(ACCOUNT_INFO)) || null;\n    // if not account_info found in - clear localstorage and redirect to login\n    if (!accountList || accountList.length === 0) {\n      if (this.dialog.openDialogs && this.dialog.openDialogs.length > 0)\n        return {};\n      else {\n        this.openDialog();\n        return {};\n      }\n    }\n    const accountIdlist = this.accountIdList();\n\n    const storedSelectedAccount = localStorage.getItem(SELECTED_ACCOUNT);\n    if (\n      storedSelectedAccount &&\n      storedSelectedAccount != \"undefined\" &&\n      storedSelectedAccount != \"null\"\n    ) {\n      const storedAccount = JSON.parse(storedSelectedAccount);\n      if (accountIdlist.includes(storedAccount.account_id)) {\n        selectedAccount = storedAccount;\n      } else {\n        selectedAccount = accountList ? accountList[0] : {};\n      }\n    } else {\n      selectedAccount = accountList[0];\n    }\n\n    return selectedAccount ? selectedAccount : {};\n  }\n  checkAccountAccess(obj) {\n    const selectedAccount = this.getSelectedAccount();\n    const account_access = selectedAccount.access_type;\n    //check account access\n    if (account_access == \"write\" || account_access == \"admin\") {\n      // return selectedAccount ? selectedAccount : {};\n      this.router.navigateByUrl(obj.link);\n    } else {\n      this.openMessageDialog(\"Write access of this account\");\n    }\n  }\n  openMessageDialog(accessMessage: string) {\n    this.dialog.open(MessageDialogComponent, {\n      panelClass: \"sm-dialog\",\n      width: \"600px\",\n      data: {\n        message: `You do not have ${accessMessage}. Please contact support.`,\n        heading: \"Access Required\",\n      },\n    });\n  }\n\n  openDialog(): void {\n    this.dialog.open(NoAccessComponent, {\n      panelClass: \"sm-dialog\",\n      width: \"600px\",\n      data: {},\n      disableClose: true,\n    });\n  }\n\n  // switch account\n  switchAccount(account_id) {\n    const accountList = JSON.parse(localStorage.getItem(ACCOUNT_INFO));\n    // if not account_info found in - clear localstorage and redirect to login\n    if (!accountList || accountList.length == 0) {\n      if (this.dialog.openDialogs && this.dialog.openDialogs.length > 0)\n        return {};\n      else {\n        this.openDialog();\n        return;\n      }\n    }\n    const idx = accountList.findIndex((obj) => obj.account_id == account_id);\n    if (idx != -1) {\n      const selected_acc = accountList[idx];\n      localStorage.setItem(\"SELECTED_ACCOUNT\", JSON.stringify(selected_acc));\n    }\n    return;\n  }\n\n  updateQueue(link) {\n    const queue = localStorage.getItem(\"QUEUE\");\n    if (queue) {\n      const recentlyViewed = JSON.parse(queue);\n      // check if already exist then return;\n      const index = recentlyViewed.indexOf(link);\n      if (index < 0) {\n        // queue already full then remove last\n        if (recentlyViewed.length >= 8) {\n          recentlyViewed.splice(8, 1);\n        }\n        // add link in queue\n        recentlyViewed.splice(0, 0, link);\n        localStorage.setItem(\"QUEUE\", JSON.stringify(recentlyViewed));\n      }\n    } else {\n      const recentlyViewed = [link];\n      localStorage.setItem(\"QUEUE\", JSON.stringify(recentlyViewed));\n    }\n  }\n\n  fetchQueue() {\n    let recentlyViewed: any[] = [];\n    const queue = localStorage.getItem(\"QUEUE\");\n    if (queue) {\n      recentlyViewed = JSON.parse(queue);\n    }\n    return recentlyViewed;\n  }\n}\n","import { Injectable } from '@angular/core';\n\nexport interface PaginationState {\n  pageIndex: number;\n  pageSize: number;\n}\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class NavigationStateService {\n\n  private pendingFilters: Record<string, any> = {};\n  private pendingPagination: Record<string, PaginationState> = {};\n\n  /** Store filters for a named route key before navigating */\n  setPendingFilter(key: string, filters: Record<string, any>): void {\n    this.pendingFilters[key] = filters;\n  }\n\n  consumePendingFilter(key: string): Record<string, any> | null {\n    const filters = this.pendingFilters[key] ?? null;\n    delete this.pendingFilters[key];\n    return filters;\n  }\n\n  hasPendingFilter(key: string): boolean {\n    return !!this.pendingFilters[key];\n  }\n  // handeled pagination state for the route\n\n  setPagination(key: string, state: PaginationState): void {\n    this.pendingPagination[key] = state;\n  }\n\n  getPagination(key: string): PaginationState | null {\n    return this.pendingPagination[key] ?? null;\n  }\n\n  clearPagination(key: string): void {\n    delete this.pendingPagination[key];\n  }\n\n  /**\n   * Serializes an appliedFilters object to a URL-safe JSON string.\n   * Uses cleanFilterObject to strip empty/null/undefined values before encoding.\n   * Returns null when nothing meaningful remains (so the queryParam can be removed).\n   */\n  serializeFiltersForUrl(filters: Record<string, any>): string | null {\n    if (!filters) { return null; }\n    const clean = this.cleanFilterObject(filters);\n    return Object.keys(clean).length > 0 ? JSON.stringify(clean) : null;\n  }\n\n  /**\n   * Parses the raw `filter` queryParam string back to an object.\n   * Returns null on missing, empty or malformed input.\n   */\n  parseFiltersFromUrl(param: string | null | undefined): Record<string, any> | null {\n    if (!param) { return null; }\n    try {\n      const parsed = JSON.parse(param);\n      return typeof parsed === 'object' && parsed !== null && !Array.isArray(parsed) ? parsed : null;\n    } catch {\n      return null;\n    }\n  }\n\n  /**\n   * Returns a copy of the filter object with all empty/meaningless keys removed\n   * so they are never sent to the API.\n   *\n   * Removed:\n   *  - Keys with undefined or null values\n   *  - Keys with empty arrays []\n   *  - Keys with empty objects {} (e.g. region/project/tags with no selections)\n   *  - Nested object keys that are undefined, null, or empty arrays\n   *    (the parent key is then dropped if nothing meaningful remains)\n   *\n   * Kept:\n   *  - Primitives (string, number, boolean) including false / 0\n   *  - Non-empty arrays\n   *  - Nested objects that have at least one meaningful value after cleaning\n   */\n  cleanFilterObject(filter: Record<string, any>): Record<string, any> {\n    const result: Record<string, any> = {};\n    for (const key of Object.keys(filter)) {\n      const val = filter[key];\n      if (val === undefined || val === null) { continue; }\n      if (Array.isArray(val)) {\n        if (val.length > 0) { result[key] = val; }\n      } else if (typeof val === 'object') {\n        const cleaned: Record<string, any> = {};\n        for (const nestedKey of Object.keys(val)) {\n          const nestedVal = val[nestedKey];\n          if (nestedVal === undefined || nestedVal === null) { continue; }\n          if (Array.isArray(nestedVal) && nestedVal.length === 0) { continue; }\n          cleaned[nestedKey] = nestedVal;\n        }\n        if (Object.keys(cleaned).length > 0) { result[key] = cleaned; }\n      } else {\n        result[key] = val;\n      }\n    }\n    return result;\n  }\n}\n","import { Injectable } from \"@angular/core\";\nimport { MatSnackBar, MatSnackBarConfig } from '@angular/material/snack-bar';\n\nexport type NotificationType = 'success' | 'error' | 'warning' | 'info' | 'default';\n\n@Injectable()\nexport class NotificationService {\n\n  private readonly BASE_CONFIG: MatSnackBarConfig = {\n    duration: 5000,\n    horizontalPosition: 'right',\n    verticalPosition: 'top',\n  };\n\n  constructor(private _snackBar: MatSnackBar) {}\n\n  // ── Existing method — untouched, all current call sites work as-is ──\n  notify(message: string): void {\n    const text = this.resolveMessage(message);\n    this._snackBar.open(text, 'Dismiss', {\n      ...this.BASE_CONFIG,\n      panelClass: ['snack-default'],\n    });\n  }\n\n  // ── Typed methods for new call sites ──────────────────────────────\n\n  success(message: string, duration = 4000): void {\n    this._snackBar.open(message, 'Dismiss', {\n      ...this.BASE_CONFIG,\n      duration,\n      panelClass: ['snack-success'],\n    });\n  }\n\n  error(message: string, duration = 6000): void {\n    const text = this.resolveMessage(message);\n    this._snackBar.open(text, 'Dismiss', {\n      ...this.BASE_CONFIG,\n      duration,\n      panelClass: ['snack-error'],\n    });\n  }\n\n  warning(message: string, duration = 5000): void {\n    this._snackBar.open(message, 'Dismiss', {\n      ...this.BASE_CONFIG,\n      duration,\n      panelClass: ['snack-warning'],\n    });\n  }\n\n  info(message: string, duration = 4000): void {\n    this._snackBar.open(message, 'Dismiss', {\n      ...this.BASE_CONFIG,\n      duration,\n      panelClass: ['snack-info'],\n    });\n  }\n\n  // ── Resolves error objects to a readable string ────────────────────\n  // notify() is called with raw error objects in many places.\n  // This keeps that working without changes at call sites.\n  private resolveMessage(message: any): string {\n    if (typeof message === 'string') return message;\n    if (message?.error?.message) return message.error.message;\n    if (message?.message) return message.message;\n    if (message?.error) return String(message.error);\n    return 'Something went wrong';\n  }\n}\n","import { Injectable, Injector } from '@angular/core';\nimport {\n  Overlay,\n  ConnectionPositionPair,\n  PositionStrategy,\n  OverlayConfig,\n} from '@angular/cdk/overlay';\nimport { PortalInjector, ComponentPortal } from '@angular/cdk/portal';\nimport { PopoverRef } from '../../popover/popover-ref';\nimport { PopoverComponent } from '../../popover/popover.component';\nimport { PopoverParams } from '../../popover/interface';\n\n@Injectable({\n  providedIn: 'root',\n})\nexport class Popover {\n  private activeRef: PopoverRef<unknown> | null = null;\n\n  constructor(private overlay: Overlay, private injector: Injector) {}\n\n  open<T>({\n    origin,\n    content,\n    data,\n    width,\n    height,\n    panelClass,\n  }: PopoverParams<T>): PopoverRef<T> {\n    this.closeActive();\n\n    const overlayRef = this.overlay.create(\n      this.getOverlayConfig({ origin, width, height, panelClass }),\n    );\n    const popoverRef = new PopoverRef<T>(overlayRef, content, data);\n\n    const injector = this.createInjector(popoverRef, this.injector);\n    overlayRef.attach(new ComponentPortal(PopoverComponent, null, injector));\n\n    this.activeRef = popoverRef as PopoverRef<unknown>;\n    popoverRef.afterClosed$.subscribe(() => {\n      if (this.activeRef === popoverRef) {\n        this.activeRef = null;\n      }\n    });\n\n    return popoverRef;\n  }\n\n  /** Closes the open popover, if any. Returns true when a popover was closed. */\n  closeActive(): boolean {\n    if (!this.activeRef) {\n      return false;\n    }\n    this.activeRef.close();\n    return true;\n  }\n\n  hasActive(): boolean {\n    return !!this.activeRef;\n  }\n\n  private getOverlayConfig({ origin, width, height, panelClass }): OverlayConfig {\n    return new OverlayConfig({\n      hasBackdrop: true,\n      width,\n      height,\n      backdropClass: 'popover-backdrop',\n      positionStrategy: this.getOverlayPosition(origin),\n      scrollStrategy: this.overlay.scrollStrategies.reposition(),\n      panelClass,\n      disposeOnNavigation: true,\n    });\n  }\n\n  private getOverlayPosition(origin: HTMLElement): PositionStrategy {\n    const positionStrategy = this.overlay\n      .position()\n      .flexibleConnectedTo(origin)\n      .withPositions(this.getPositions())\n      .withFlexibleDimensions(false)\n      .withPush(false);\n\n    return positionStrategy;\n  }\n\n  createInjector(popoverRef: PopoverRef, injector: Injector) {\n    const tokens = new WeakMap([[PopoverRef, popoverRef]]);\n    return new PortalInjector(injector, tokens);\n  }\n\n  private getPositions(): ConnectionPositionPair[] {\n    return [\n      {\n        originX: 'start',\n        originY: 'bottom',\n        overlayX: 'start',\n        overlayY: 'top',\n      },\n      {\n        originX: 'end',\n        originY: 'bottom',\n        overlayX: 'end',\n        overlayY: 'top',\n      },\n      {\n        originX: 'start',\n        originY: 'top',\n        overlayX: 'start',\n        overlayY: 'bottom',\n      },\n      {\n        originX: 'end',\n        originY: 'top',\n        overlayX: 'end',\n        overlayY: 'bottom',\n      },\n    ];\n  }\n}\n","import { Injectable } from '@angular/core';\nimport { BehaviorSubject } from 'rxjs';\n@Injectable({\n    providedIn: 'root',\n})\nexport class SharedDataService {\n\n    private dataSource = new BehaviorSubject('');\n\n    constructor() { }\n\n    changeData(data: string) {\n        this.dataSource.next(data)\n    }\n\n    getData() {\n        return this.dataSource.asObservable();\n      }\n    \n\n}","import { Injectable } from '@angular/core';\nimport { NavigationStart, Router } from '@angular/router';\nimport { filter } from 'rxjs/operators';\nimport { tabGroupPaginationKeys } from 'src/constants/url.constants';\nimport { getTabGroupKeyForUrl } from '../../_utils/tab-navigation.util';\nimport { NavigationStateService } from './navigation-state.service';\n\n@Injectable({ providedIn: 'root' })\nexport class TabPaginationNavigationService {\n  constructor(\n    private router: Router,\n    private navState: NavigationStateService,\n  ) {\n    this.router.events\n      .pipe(filter((event): event is NavigationStart => event instanceof NavigationStart))\n      .subscribe((event) => {\n        const fromGroup = getTabGroupKeyForUrl(this.router.url);\n        const toGroup = getTabGroupKeyForUrl(event.url);\n        if (fromGroup && fromGroup !== toGroup) {\n          (tabGroupPaginationKeys[fromGroup] ?? []).forEach((key) =>\n            this.navState.clearPagination(key),\n          );\n        }\n      });\n  }\n}\n","import { Injectable } from '@angular/core';\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class ThemeTransitionService {\n  private readonly transitionMs = 480;\n  private transitioning = false;\n\n  animate(from: 'light' | 'dark'): void {\n    if (this.transitioning || typeof document === 'undefined') {\n      return;\n    }\n\n    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {\n      return;\n    }\n\n    this.transitioning = true;\n\n    const overlay = document.createElement('div');\n    overlay.className = 'theme-transition-overlay';\n    overlay.dataset['from'] = from;\n    document.body.appendChild(overlay);\n\n    requestAnimationFrame(() => {\n      requestAnimationFrame(() => overlay.classList.add('is-active'));\n    });\n\n    let finished = false;\n    const finish = (): void => {\n      if (finished) {\n        return;\n      }\n      finished = true;\n      overlay.remove();\n      this.transitioning = false;\n    };\n\n    overlay.addEventListener('transitionend', finish, { once: true });\n    window.setTimeout(finish, this.transitionMs + 80);\n  }\n}\n","import { Injectable } from '@angular/core';\nimport { BehaviorSubject, Observable } from 'rxjs';\nimport { ThemeTransitionService } from './theme-transition.service';\n\nexport type Theme = 'light' | 'dark' | 'system';\n\n@Injectable({\n  providedIn: 'root'\n})\nexport class ThemeService {\n  private readonly THEME_STORAGE_KEY = 'app-theme';\n  private themeSubject: BehaviorSubject<Theme>;\n  public theme$: Observable<Theme>;\n  private mediaQuery: MediaQueryList;\n  private allowTransition = false;\n\n  constructor(private themeTransitionService: ThemeTransitionService) {\n    // Initialize media query for system theme detection\n    this.mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');\n    \n    // Initialize with stored theme or default to system\n    const storedTheme = this.getStoredTheme();\n    this.themeSubject = new BehaviorSubject<Theme>(storedTheme);\n    this.theme$ = this.themeSubject.asObservable();\n    \n    // Apply initial theme without transition animation\n    this.applyTheme(storedTheme);\n\n    // Enable transition animation after initial paint\n    requestAnimationFrame(() => {\n      this.allowTransition = true;\n    });\n    \n    // Listen for system theme changes\n    this.mediaQuery.addEventListener('change', this.handleSystemThemeChange.bind(this));\n  }\n\n  /**\n   * Get current theme value\n   */\n  getCurrentTheme(): Theme {\n    return this.themeSubject.value;\n  }\n\n  /**\n   * Toggle between light and dark theme (legacy support)\n   */\n  toggleTheme(): void {\n    const currentTheme = this.themeSubject.value;\n    let newTheme: Theme;\n    \n    if (currentTheme === 'system') {\n      // If system, toggle to opposite of current system preference\n      newTheme = this.getSystemTheme() === 'dark' ? 'light' : 'dark';\n    } else {\n      newTheme = currentTheme === 'light' ? 'dark' : 'light';\n    }\n    \n    this.setTheme(newTheme);\n  }\n\n  /**\n   * Set specific theme\n   */\n  setTheme(theme: Theme): void {\n    const currentEffectiveTheme = this.getEffectiveTheme(this.themeSubject.value);\n    const nextEffectiveTheme = this.getEffectiveTheme(theme);\n\n    if (\n      this.allowTransition &&\n      currentEffectiveTheme !== nextEffectiveTheme\n    ) {\n      this.themeSubject.next(theme);\n      this.applyTheme(theme);\n      this.storeTheme(theme);\n\n      this.themeTransitionService.animate(currentEffectiveTheme);\n      return;\n    }\n\n    this.themeSubject.next(theme);\n    this.applyTheme(theme);\n    this.storeTheme(theme);\n  }\n\n  /**\n   * Check if current theme is dark\n   */\n  isDarkTheme(): boolean {\n    const theme = this.themeSubject.value;\n    if (theme === 'system') {\n      return this.getSystemTheme() === 'dark';\n    }\n    return theme === 'dark';\n  }\n\n  /**\n   * Get the actual system theme preference\n   */\n  private getSystemTheme(): 'light' | 'dark' {\n    return this.mediaQuery.matches ? 'dark' : 'light';\n  }\n\n  /**\n   * Handle system theme changes when theme is set to 'system'\n   */\n  private handleSystemThemeChange(): void {\n    if (this.themeSubject.value === 'system') {\n      this.applyTheme('system');\n    }\n  }\n\n  private getEffectiveTheme(theme: Theme): 'light' | 'dark' {\n    if (theme === 'system') {\n      return this.getSystemTheme();\n    }\n    return theme;\n  }\n\n  /**\n   * Apply theme to document\n   */\n  private applyTheme(theme: Theme): void {\n    const htmlElement = document.documentElement;\n    const effectiveTheme = this.getEffectiveTheme(theme);\n\n    if (effectiveTheme === 'dark') {\n      htmlElement.setAttribute('data-theme', 'dark');\n    } else {\n      htmlElement.removeAttribute('data-theme');\n    }\n\n    htmlElement.style.colorScheme = effectiveTheme;\n    document.body.style.colorScheme = effectiveTheme;\n    this.updateMetaThemeColor(effectiveTheme);\n  }\n\n  private updateMetaThemeColor(theme: 'light' | 'dark'): void {\n    const meta = document.querySelector('meta[name=\"theme-color\"]');\n    if (!meta) {\n      return;\n    }\n    meta.setAttribute('content', theme === 'dark' ? '#0f172a' : '#f6f8f9');\n  }\n\n  /**\n   * Store theme preference in localStorage\n   */\n  private storeTheme(theme: Theme): void {\n    try {\n      localStorage.setItem(this.THEME_STORAGE_KEY, theme);\n    } catch (error) {\n      console.error('Failed to store theme preference:', error);\n    }\n  }\n\n  /**\n   * Retrieve stored theme from localStorage\n   */\n  private getStoredTheme(): Theme {\n    try {\n      const stored = localStorage.getItem(this.THEME_STORAGE_KEY);\n      return (stored === 'dark' || stored === 'light' || stored === 'system') ? stored : 'system';\n    } catch (error) {\n      console.error('Failed to retrieve theme preference:', error);\n      return 'system';\n    }\n  }\n}\n","import { Injectable } from '@angular/core';\nimport { Observable, Observer } from 'rxjs';\nimport { io as socketIo } from 'socket.io-client';\nimport { Socket } from './interface';\nimport { appConstants } from '../../../constants/app.constants';\nimport { TOKEN_NAME, USER_INFO } from '../../../constants/local.storage';\n\n@Injectable()\nexport class WebsocketService {\n\n  socket: Socket;\n  observer: Observer<number>;\n  socketHost : any = appConstants['apiHost'];\n\n\n  public getSocketConnection(path, params, requestKey, responseKey) : Observable<number> {\n    let email = this.getUserEmail();\n    let allparams = {...params,...email}\n    this.socket = socketIo((this.socketHost),{\n        path,\n        query : {\n          requestKey,\n          responseKey\n        },\n        transports: ['websocket']\n      });\n    this.socket.emit('request',allparams)\n    this.socket.on('response', (res) => {\n        this.observer.next(res);\n    });\n\n    return this.createObservable();\n  }\n\n  createObservable() : Observable<number> {\n      return new Observable<number>(observer => {\n        this.observer = observer;\n      });\n  }\n\n  getUserEmail(){\n    let userInfoContent = localStorage.getItem(USER_INFO) || \"{}\";\n    let userInfo = JSON.parse(userInfoContent);\n    // Support new JWT structure: userprincipalname or email\n    let email = userInfo.userprincipalname || userInfo.email || \"\";\n    return {email};\n  }\n\n  // to destry socket connection\n  public destroySocketConnection(){\n    this.socket.disconnect();\n  }\n\n}","import { tabLisiting } from 'src/constants/url.constants';\n\nexport interface TabListingEntry {\n  link: string;\n  createLink?: string;\n  detailsPageLink?: string;\n  dependencyGraph?: string;\n  /** In-module list/tab routes (e.g. VPC peering tab under vpc-view). */\n  childLinks?: string[];\n  /** Additional create flows beyond createLink. */\n  additionalCreateLinks?: string[];\n}\n\nfunction pathMatchesLink(path: string, link: string): boolean {\n  return path === link || path.includes(link);\n}\n\nexport function urlMatchesTabEntry(url: string, entry: TabListingEntry): boolean {\n  const path = url.split('?')[0];\n  return (\n    path.includes(entry.link) ||\n    (!!entry.createLink && path === entry.createLink) ||\n    (!!entry.detailsPageLink && path.includes(entry.detailsPageLink)) ||\n    (!!entry.dependencyGraph && path.includes(entry.dependencyGraph)) ||\n    (!!entry.childLinks?.some((link) => pathMatchesLink(path, link))) ||\n    (!!entry.additionalCreateLinks?.some((link) => path === link))\n  );\n}\n\nexport function getTabGroupKeyForUrl(url: string): string | null {\n  for (const [key, tabs] of Object.entries(tabLisiting)) {\n    if (tabs.some((entry) => urlMatchesTabEntry(url, entry))) {\n      return key;\n    }\n  }\n  return null;\n}\n","import { Component, OnDestroy } from '@angular/core';\nimport { MatDialog } from '@angular/material/dialog';\nimport { ActivatedRoute, NavigationEnd, Router } from '@angular/router';\nimport moment from 'moment';\nimport { CommentDialogComponent } from 'src/app/shared/comment-dialog/comment-dialog.component';\nimport { AdminService } from 'src/app/_services/all-requests/admin.service';\nimport { NotificationService } from 'src/app/_services/utility/notification.service';\n\n@Component({\n  selector: 'app-request-access-policy',\n  templateUrl: './request-access-policy.component.html',\n  styleUrls: ['./request-access-policy.component.scss'],\n  providers: [NotificationService, AdminService]\n})\nexport class RequestAccessPolicyComponent implements OnDestroy {\n\n  routerEvents: any;\n  routerParams: any = {};\n  reqData: any = {};\n  linkExp : boolean = false;\n  spin: any ={};\n\n  constructor(private router: Router,private activatedRoute: ActivatedRoute,\n    public dialog: MatDialog,private notificationService : NotificationService,\n    private adminService : AdminService) { \n    this.routerEvents = this.router.events.subscribe(event => {\n      if (event instanceof NavigationEnd) {\n        this.routerParams = this.activatedRoute.snapshot.queryParams;\n        let token = this.routerParams.key;\n        let data = atob(token.split('.')[1]);\n        this.reqData = JSON.parse(data);\n        \n        // check if link has expired\n        if(this.reqData.exp){\n          let currentDate = moment().unix();\n          if(currentDate > this.reqData.exp){\n            this.linkExp = true;\n          }\n        }\n      }\n    });\n  }\n\n  manageAccess(action,comment){\n    this.spin[action] = true;\n    if(this.reqData.project_id){\n      this.manageProjectAccess(action, comment);\n    }\n    else{\n      this.manageAccountAccess(action, comment);\n    }\n  }\n\n  openDialog(){\n    const dialogRef = this.dialog.open(CommentDialogComponent, {\n      panelClass: 'sm-dialog',\n      width: '600px',\n      data: {\n        title:'Reject Request',\n        heading : 'Enter Comment',\n      }\n    });\n\n    dialogRef.componentInstance.confirmAction.subscribe(res => {\n      this.manageAccess('reject', res);\n      this.dialog.closeAll();\n    });\n  }\n\n  manageProjectAccess(action, comment){\n    let params = {\n      account_id : this.reqData.account_id,\n      project_id : this.reqData.project_id,\n      requester_id : this.reqData.user_id,\n      access_policy_id : this.reqData.access_policy_id,\n      action : action,\n      comment : comment\n    }\n    this.adminService.manageProjectAccess(params).subscribe(data => {\n      if(data){\n        this.notificationService.notify(data['message']);\n      }\n      this.spin[action] = false;\n    },error => {\n      this.notificationService.notify(error);\n      this.spin[action] = false;\n    })\n  }\n\n  manageAccountAccess(action, comment){\n    let params = {\n      account_id : this.reqData.account_id,\n      requester_id : this.reqData.user_id,\n      access_policy_id : this.reqData.access_policy_id,\n      action : action,\n      comment : comment\n    }\n    this.adminService.manageAccountAccess(params).subscribe(data => {\n      if(data){\n        this.notificationService.notify(data['message']);\n      }\n      this.spin[action] = false;\n    },error => {\n      this.notificationService.notify(error);\n      this.spin[action] = false;\n    })\n  }\n\n  ngOnDestroy() {\n    // destroy router events\n    this.routerEvents.unsubscribe();\n  }\n\n}\n","<div class=\"req-container\">\n\t<div class=\"card\">\n        \n        <div class=\"access-content\" *ngIf=\"!linkExp\">\n            <h1>Approve Access Policy </h1>\n            <p class=\"note\">Request for attaching an access policy on the your project {{reqData.project_name}} of \n                account {{reqData.account_name}} has been recevied. Please review below details before approving the request.\n            </p>\n            <div class=\"flex details\">\n                <p>\n                    <strong>Account Name</strong>\n                    <span>{{reqData.account_name}}</span>\n                </p>\n                <p>\n                    <strong>Project Name</strong>\n                    <span>{{reqData.project_name}}</span>\n                </p>\n            </div>\n            <div class=\"flex details\">\n                <p>\n                    <strong>Current Access Policy</strong>\n                    <span>{{reqData.curr_access_policy_name || '-'}}</span>\n                </p>\n                <p>\n                    <strong>New Access Policy</strong>\n                    <span>{{reqData.access_policy_name || '-'}}</span>\n                </p>\n            </div>\n            <div class=\"flex details\">\n                <p>\n                    <strong>Requester Name</strong>\n                    <span class=\"break-word\">{{reqData.user_name}} ({{reqData.user_email || '-'}})</span>\n                </p>\n                <p>\n                    <strong>Access Policy Owner</strong>\n                    <span>{{reqData.access_policy_owner || '-'}}</span>\n                </p>\n            </div>\n            <div class=\"details\">\n                <p class=\"full-width\">\n                    <strong>Shell Groups</strong>\n                    <span>{{reqData.shell_groups || '-'}}</span>\n                </p>\n                <p class=\"full-width\">\n                    <strong>Write Groups</strong>\n                    <span>{{reqData.write_groups || '-'}}</span>\n                </p>\n                <p class=\"full-width\">\n                    <strong>Admin Groups</strong>\n                    <span>{{reqData.admin_groups || '-'}}</span>\n                </p>\n                <p class=\"full-width\">\n                    <strong>Super Admin Groups</strong>\n                    <span>{{reqData.superadmin_groups || '-'}}</span>\n                </p>\n            </div>\n            <div class=\"mt-20\">\n                <button [disabled]=\"spin['validate']\" mat-flat-button color=\"primary\" (click)=\"manageAccess('validate','')\"\n                    class=\"mr-10 create-btn\">\n                    Validate <mat-spinner *ngIf=\"spin['validate']\" [diameter]=\"20\"></mat-spinner>\n                </button>\n                <button [disabled]=\"spin['grant']\" mat-flat-button color=\"primary\" (click)=\"manageAccess('grant','')\"\n                    class=\"mr-10 create-btn\">\n                    Approve <mat-spinner *ngIf=\"spin['grant']\" [diameter]=\"20\"></mat-spinner>\n                </button>\n                <button [disabled]=\"spin['reject']\" mat-flat-button color=\"accent\" (click)=\"openDialog()\" class=\"create-btn\">\n                    Reject <mat-spinner *ngIf=\"spin['reject']\" [diameter]=\"20\"></mat-spinner>\n                </button>\n            </div>\n\n\n        </div>\n        <div *ngIf=\"linkExp\">Link has been Expired</div>\n    </div>\n</div>","import { Component, EventEmitter, OnInit, Output } from '@angular/core';\nimport { menuMap } from 'src/constants/url.constants';\nimport { Router, NavigationEnd, ActivatedRoute } from '@angular/router';\nimport { LocalStorageService } from 'src/app/_services/utility/localstorage.service';\n\n@Component({\n  selector: 'app-services-list',\n  templateUrl: './services-list.component.html',\n  styleUrls: ['./services-list.component.scss'],\n  providers: [LocalStorageService]\n})\nexport class ServicesListComponent implements OnInit {\n\n  @Output() itemSelected = new EventEmitter<void>();\n\n  componentTitle: string = 'Available Services'\n  descMain: string = 'All Featured Services'\n  selectedAccount:any;\n  servicesList: any = menuMap;\n\n  constructor(private router: Router,private lsService: LocalStorageService) {\n    this.selectedAccount = this.lsService.getSelectedAccount();\n  }\n\n  ngOnInit(): void {}\n\n  reDirectToService(element) {\n    if (element.link) {\n      this.itemSelected.emit();\n      this.router.navigateByUrl(element.link);\n    }\n  }\n\n  //  unallocated devices,nginx cluster are only visible to devops,SF and monitoring accounts && elastic search and kafka page currently not present in site.\n  checkValidation(element){\n    let service=element.name\n    if((!([76,77,79].includes(this.selectedAccount.account_id)) && (service=='Unallocated Devices' || service=='Nginx Cluster')) || service=='Elastic Search' || service=='Kafka'){\n      return true\n    }\n    return false;\n  }\n}\n","<div class=\"main-heading align-center\">\n    <app-sub-heading [main_title]=\"true\" [title_main]=\"componentTitle\" [desc_main]=\"descMain\"></app-sub-heading>\n</div>\n\n<div class=\"create-fullview\">\n    <div *ngFor=\"let name of servicesList | objectKeys\">\n        <h2 class=\"service-type\">{{name}}</h2>\n        <div class=\"services-main\">\n            <div *ngFor=\"let element of servicesList[name]\">\n                <div class=\"main-container\" [ngClass]=\"{'disable' : checkValidation(element)}\" (click)=\"reDirectToService(element)\">\n                    <span class=\"as-sprite {{element.mapCss}}\">Object Storage</span>\n                    <div class=\"services\">\n                        <div class=\"service-name\">{{element.name}}</div>\n                        <div class=\"service-desc\">{{element.desc}}</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>","import { NgModule } from '@angular/core';\nimport { Routes, RouterModule } from '@angular/router';\n\nimport { LoginComponent } from './login/login.component';\nimport { EmailVerificationComponent } from './extra-pages/email-verification/email-verification.component';\nimport { LayoutComponent } from './layout/layout.component';\nimport { RequestAccessPolicyComponent } from './admin/admin-tabs/projects/request-access-policy/request-access-policy.component';\n\nconst appRoutes: Routes = [\n  { path: '', redirectTo: '/dashboard/home', pathMatch: 'full' },\n  { path: 'login', component: LoginComponent },\n  { path: 'email-validation', component: EmailVerificationComponent },\n  { path: 'request-access-policy/view', component: RequestAccessPolicyComponent },\n  { path: 'dashboard', loadChildren: () => import('./layout/layout.module').then(mod => mod.LayoutModule)},\n  { path: 'network-graphs', loadChildren: () => import('./network-graphs/network-graphs.module').then(mod => mod.NetworkGraphsModule)},\n  { path: 'request-access', loadChildren: () => import('./request-access/request-access.module').then(mod => mod.RequestAccessModule)},\n  { path: 'aggrements', loadChildren: () => import('./static-page/static-page.module').then(mod => mod.StaticPageModule)},\n  { path: 'legal', loadChildren: () => import('./terms-and-conditions/static-page.module').then(mod => mod.StaticPageModule)},\n  { path: '**', component: LayoutComponent }\n];\n\n@NgModule({\n  imports: [\n    RouterModule.forRoot(appRoutes, {\n      scrollPositionRestoration: 'enabled',\n      anchorScrolling: 'enabled',\n    }),\n  ],\n  exports: [RouterModule]\n})\n\nexport class AppRoutingModule {}\n\n \n","import { Component, OnInit } from '@angular/core';\nimport { NavigationError, Router } from '@angular/router';\nimport { filter, map } from 'rxjs/operators';\nimport { TOKEN_NAME } from '../constants/local.storage';\n\n@Component({\n  selector: 'app-root',\n  providers: [],\n  templateUrl: './app.component.html',\n  styleUrls: ['./app.component.scss']\n})\nexport class AppComponent implements OnInit {\n\n  constructor(\n    private router: Router,\n  ) {\n    router.events\n      .pipe(\n        filter(evt => evt instanceof NavigationError),\n        map(evt => evt as NavigationError)\n      )\n      .subscribe(evt => {\n        console.log('in app component - router subscriber');\n        console.log(evt.error.name);\n        if (evt.error instanceof Error && evt.error.name == 'ChunkLoadError') {\n          window.location.assign(evt.url);\n        }\n      });\n  }\n\n  ngOnInit(): void {\n    const urlHit = window.location.pathname + window.location.search;\n    localStorage.setItem('urlHit', urlHit);\n\n    const authToken = localStorage.getItem(TOKEN_NAME);\n    const publicPaths = ['email-validation', 'aggrements', 'login'];\n    if (!publicPaths.some(p => window.location.href.includes(p))) {\n      if (!authToken) this.router.navigateByUrl('/login');\n    }\n  }\n}\n","<div class=\"cloud-main-content\">\n    <router-outlet></router-outlet>\n</div>\n","import { BrowserModule } from '@angular/platform-browser';\nimport { HttpClientModule } from '@angular/common/http';\nimport { NgModule, ErrorHandler} from '@angular/core';\n\nimport { AppRoutingModule } from './app-routing.module';\nimport { AppComponent } from './app.component';\nimport { NoopAnimationsModule } from '@angular/platform-browser/animations';\nimport { ApiRequestService } from './_services/api-request-utility/api-request.service';\nimport { WebsocketService } from './_services/websocket-utility/websocket.service';\nimport { LoginModule } from './login/login.module';\nimport { PipesModule } from './pipes/pipes.module';\n\nimport { HttpCancelService } from './_services/api-request-utility/httpcancel.service';\nimport { HTTP_INTERCEPTORS } from '@angular/common/http';\nimport { ManageHttpInterceptor } from './_interceptors/managehttp.interceptor';\nimport { ExtraPagesModule } from './extra-pages/extra-pages.module';\n\nimport { GlobalErrorHandler } from './_services/error-handling';\n\nimport { MatIconModule } from '@angular/material/icon';\nimport { MAT_TOOLTIP_DEFAULT_OPTIONS, MatTooltipModule } from '@angular/material/tooltip';\nimport { MatAutocompleteModule } from '@angular/material/autocomplete';\n\n@NgModule({\n  declarations: [\n    AppComponent,\n  ],\n  imports: [\n    BrowserModule,\n    AppRoutingModule,\n    NoopAnimationsModule,\n    HttpClientModule,\n    LoginModule,\n    PipesModule,\n    ExtraPagesModule,\n    MatIconModule,\n    MatTooltipModule,\n    MatAutocompleteModule\n  ],\n  providers: [ApiRequestService, WebsocketService, HttpCancelService,\n    { provide: HTTP_INTERCEPTORS, useClass: ManageHttpInterceptor, multi: true },\n    { provide: ErrorHandler, useClass: GlobalErrorHandler},\n    {\n      provide: MAT_TOOLTIP_DEFAULT_OPTIONS,\n      useValue: {\n        disableTooltipInteractivity: true // Makes tooltips ignore all pointer clicks\n      }\n    }],\n  bootstrap: [AppComponent]\n})\nexport class AppModule { }\n","import { Component, OnInit } from '@angular/core';\nimport { ExtraPagesService } from '../../_services/all-requests/extra-pages.service';\nimport { NotificationService } from '../../_services/utility/notification.service';\nimport { Router, ActivatedRoute } from '@angular/router';\nimport { finalize } from 'rxjs/operators';\n\n@Component({\n  selector: 'email-verification',\n  templateUrl: './email-verification.component.html',\n  styleUrls: ['./email-verification.component.scss'],\n  providers: [ExtraPagesService, NotificationService]\n})\nexport class EmailVerificationComponent implements OnInit {\n\n  showtext : string = \"Your Email Address is verified\";\n  routerParams : any = {};\n  loader : boolean = false;\n\n  constructor(private extraPagesService : ExtraPagesService,\n    private notificationService : NotificationService,\n    private router: Router,\n    private activatedRoute: ActivatedRoute) {\n      this.routerParams = this.activatedRoute.snapshot.queryParams;\n    }\n\n  ngOnInit(){\n    this.callValidation();\n  }\n\n  callValidation(){\n    this.loader = true;\n    let param = {\n      token : this.routerParams.token,\n      email_id : this.routerParams.email_id\n    }\n    this.extraPagesService.getEmailValidation(param).pipe(finalize(() => {\n      this.loader = false;\n      localStorage.setItem('urlHit','');\n    })).subscribe(response => {\n      if(response){\n        this.notificationService.notify(\"Redirecting to Home Page in 5 seconds\");\n\n        setTimeout(() => {\n          this.router.navigateByUrl(\"/dashboard\");\n        }, 5000);\n\n      }\n    },error =>{\n      this.showtext = error;\n      this.notificationService.notify(error);\n    })\n  }\n\n}\n","<div class=\"showText\">\n    <div class=\"load-spinner\" *ngIf=\"loader\">\n        <mat-spinner [diameter]=\"60\" ></mat-spinner>\n    </div>\n    <strong *ngIf=\"!loader\">{{showtext}}</strong>\n</div>","import { NgModule } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { EmailVerificationComponent } from './email-verification/email-verification.component';\nimport { MatProgressSpinnerModule } from '@angular/material/progress-spinner';\n\n\n\n@NgModule({\n  declarations: [EmailVerificationComponent],\n  imports: [\n    CommonModule,\n    MatProgressSpinnerModule\n  ]\n})\nexport class ExtraPagesModule { }\n","/** Child paths from layout-routing.module.ts (excluding switch-account). */\nconst LAYOUT_MODULES = new Set([\n  'home',\n  'server',\n  'device',\n  'volume',\n  'support',\n  'elb',\n  'admin',\n  'networking',\n  'email-services',\n  'cluster',\n  'autoscale',\n  'k8s-cluster',\n  'profile',\n  'elastic-lb',\n  'bucket',\n  'health-check',\n  'alerts',\n  'change-request',\n  'device-cluster',\n  'cdn-config',\n  'vpc',\n  'snapshot',\n  'alert-history',\n  'template-listing',\n  'zone-cluster',\n  'capacity-management',\n  'billing',\n  'device-inventory',\n  'ssl-certificate',\n  'domains',\n  'bare-metal',\n  'all-services',\n  'risk',\n  'risk-action',\n  'service-request',\n  'all-networks',\n  'network-link',\n]);\n\nexport function navigateAfterAccountSwitch(fallback = '/dashboard/home'): void {\n  const module = window.location.pathname.split('/')[2];\n  const target =\n    module && LAYOUT_MODULES.has(module) ? `/dashboard/${module}` : fallback;\n\n  if (window.location.pathname === target) {\n    window.location.reload();\n    return;\n  }\n  window.location.replace(target);\n}\n","import { Component, OnInit, ViewChild, Input, ElementRef, OnDestroy, HostListener } from '@angular/core';\nimport { Router, NavigationEnd, ActivatedRoute } from '@angular/router';\nimport { appConstants } from '../../../constants/app.constants';\nimport { urlMap, urlCreateMap } from 'src/constants/url.constants';\nimport { navigateAfterAccountSwitch } from '../account-switch-navigation';\nimport { navigation } from '../../../constants/nav.constants'\nimport { UntypedFormControl } from '@angular/forms';\nimport { MatAutocomplete, MatAutocompleteTrigger } from '@angular/material/autocomplete';\nimport { Observable, Subject } from 'rxjs';\nimport { takeUntil, debounceTime, distinctUntilChanged, filter } from 'rxjs/operators';\nimport { LocalStorageService } from '../../_services/utility/localstorage.service';\nimport { SupportService } from '../../_services/all-requests/support.service';\nimport { NotificationService } from '../../_services/utility/notification.service';\nimport { ConfirmDialogComponent } from '../../shared/confirm-dialog/confirm-dialog.component';\nimport { MatDialog } from '@angular/material/dialog';\nimport { ACCOUNT_INFO, FAVORITE_ACCOUNT_ID } from '../../../constants/local.storage'\nimport { CookieService } from '../../_services/utility/cookie.service';\nimport { MessageDialogComponent } from 'src/app/shared/message-dialog/message-dialog.component';\nimport { CommonService } from '../../_services/all-requests/common.service';\nimport { SwitchAccountDialogComponent } from '../sidenav/switch-account-dialog/switch-account-dialog.component';\nimport { MenuComponent } from '../menu/menu.component';\nimport { SharedDataService } from 'src/app/_services/utility/share-data.service';\nimport { AdminService } from 'src/app/_services/all-requests/admin.service';\nimport { ThemeService, Theme } from 'src/app/_services/utility/theme.service';\nimport { HeaderPanelService } from 'src/app/_services/utility/header-panel.service';\n//import { ServersService } from 'src/app/_services/all-requests/servers.service';\n//import { K8sClusterService } from 'src/app/_services/all-requests/k8s-cluster.service';\n//import { ElbService } from 'src/app/_services/all-requests/elb.service';\n\n@Component({\n  selector: 'app-header',\n  templateUrl: './header.component.html',\n  styleUrls: ['./header.component.scss'],\n  providers: [LocalStorageService, SupportService, NotificationService,\n    CommonService, AdminService]\n})\n\nexport class HeaderComponent implements OnInit, OnDestroy {\n\n  @Input() sidenavExpanded = false;\n\n  quickActions: any = [];\n  //+icon quick action list\n\n  searchType = \"Like\";\n  searchValue = '';\n  urlMapObj: any = urlMap;\n  urlMapObjValues: any = Object.values(urlMap);\n  landingPage: string;\n  navigation: any = navigation;\n  account_info: any;\n  inputformCtrl = new UntypedFormControl();\n  @ViewChild('auto') matAutocomplete: MatAutocomplete;\n  @ViewChild('searchInput') searchInput: ElementRef;\n  @ViewChild('allServiceWrapper') allServiceWrapper: ElementRef;\n  @ViewChild('accountSearchWrapper') accountSearchWrapper: ElementRef;\n  @ViewChild('accountAutoTrigger') accountAutoTrigger: MatAutocompleteTrigger;\n  @ViewChild('accountInput') accountInput: ElementRef<HTMLInputElement>;\n  filteredList: Observable<any>;\n  ipList: any = [];\n  selectedObj: any = {};\n  loader: boolean;\n  tempEmailList: any = appConstants['tempEmailList'];\n  routerParams: any = {};\n  typeConstants: {\n    freelbip: 'free_lb_ip',\n    alias: 'alias'\n  }\n  data: any;\n  selectedAccount: any;\n  showAccount= true;\n  accountInfo:any;\n  printAccounts : any = [];\n  search_value : string;\n  favoriteAccountIds: number[] = [];\n  allService: any = {link: urlMap.services};\n  selectiveHeader:any;\n  tabList: any = [];\n  fabOpen = false;\n  fabHover = false;\n  urlMap: any = urlMap;\n  urlCreateMap: any = urlCreateMap;\n  // Search collapse/expand state\n  isSearchExpanded = false;\n  searchCompleted = false;\n  private searchSubject = new Subject<string>();\n  \n  // FAB panel state\n  private fabHoverCloseTimeout: any;\n  \n  // Theme properties\n  currentTheme: Theme = 'system';\n  isHomeActive = false;\n  private destroy$ = new Subject<void>();\n  private readonly quickActionsPanelId = 'quick-actions';\n  private readonly allServicesPanelId = 'all-services';\n\n  \n  constructor(private router: Router,\n    //quickaction services \n   // // private k8sClusterService: K8sClusterService,\n    //private lbService: ElbService,\n   // private serversService: ServersService,\n\n    private activatedRoute: ActivatedRoute,\n    private lsService: LocalStorageService,\n    private supportService: SupportService,\n    private notificationService: NotificationService,\n    private dialog: MatDialog,\n    private commonService: CommonService,\n    private sharedDataService: SharedDataService,\n    private themeService: ThemeService,\n    private headerPanelService: HeaderPanelService,\n    private cookieService: CookieService) {\n    this.landingPage = appConstants['LANDING_PAGE_URL'];\n    this.accountInfo = JSON.parse(localStorage.getItem(ACCOUNT_INFO));\n    this.inputformCtrl.setValue('');\n    this.quickActions = [\n      { name: 'Create Server', css: 'cloud-server-create', link: this.urlCreateMap['create-server'], desc: 'in an existing project', access: 'project' },\n      { name: 'Create Load Balancer', css: 'elb-create', link: this.urlCreateMap['create-elb'], desc: 'in an existing project', access: 'project' },\n      { name: 'Create K8s Cluster', css: 'k8-create', link: this.urlCreateMap['create-kubernetes-cluster'], desc: 'in an existing project', access: 'account' },\n      { name: 'Create Database Cluster', css: 'db-create', link: this.urlCreateMap['create-database-cluster'], desc: 'in an existing project', access: 'project' }\n    ];\n  }\n\n  ngOnInit(): void {\n    this.themeService.theme$\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(theme => {\n        this.currentTheme = theme;\n      });\n\n    this.sharedDataService.getData()\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(data => {\n        if (data) {\n          this.data = data;\n        }\n      });\n\n    this.router.events.pipe(\n      filter((event): event is NavigationEnd => event instanceof NavigationEnd),\n      takeUntil(this.destroy$)\n    ).subscribe(event => this.onNavigationEnd(event));\n\n    this.onNavigationEnd();\n\n    this.searchSubject.pipe(\n      debounceTime(400),\n      takeUntil(this.destroy$)\n    ).subscribe(() => {\n      this.performSearch();\n    });\n\n    this.headerPanelService.close$\n      .pipe(takeUntil(this.destroy$))\n      .subscribe((exceptPanelId) => {\n        if (exceptPanelId !== this.quickActionsPanelId) {\n          this.fabOpen = false;\n        }\n        if (exceptPanelId !== this.allServicesPanelId) {\n          this.isAllServicesOpen = false;\n        }\n      });\n  }\n\n  ngOnDestroy(): void {\n    if (this.fabHoverCloseTimeout) {\n      clearTimeout(this.fabHoverCloseTimeout);\n    }\n    this.destroy$.next();\n    this.destroy$.complete();\n    this.searchSubject.complete();\n  }\n\n  private onNavigationEnd(event?: NavigationEnd): void {\n    if (event?.url === '/login' || (!event && this.router.url === '/login')) {\n      return;\n    }\n\n    this.isHomeActive = this.router.url.includes('dashboard/home');\n\n    this.selectedAccount = this.lsService.getSelectedAccount();\n    this.routerParams = this.activatedRoute.snapshot.queryParams;\n\n    if (this.routerParams['search']) {\n      this.searchValue = this.routerParams['search'];\n    } else {\n      this.searchValue = '';\n    }\n\n    this.inputformCtrl.setValue('');\n    this.ipList = [];\n    this.accountInfo = JSON.parse(localStorage.getItem('USER_ACCOUNTS'));\n    this.loadFavoriteAccountIds();\n    this.printAccounts = this.sortAccounts(this.accountInfo);\n    this.account_info = this.lsService.getSelectedAccount();\n\n    const acc_id = this.routerParams.account_id;\n    if (acc_id && (parseInt(acc_id, 10) !== this.account_info.account_id)) {\n      this.lsService.switchAccount(acc_id);\n      this.account_info = this.lsService.getSelectedAccount();\n    }\n  }\n\n  @HostListener('document:click', ['$event'])\n  onDocumentClick(event: MouseEvent): void {\n    const target = event.target as HTMLElement;\n    \n    \n    if (this.isAllServicesOpen && this.allServiceWrapper) {\n      const allServicesEl = this.allServiceWrapper.nativeElement;\n      const panelEl = allServicesEl.querySelector('.all-services-panel');\n      if (!allServicesEl.contains(target) && (!panelEl || !panelEl.contains(target))) {\n        this.isAllServicesOpen = false;\n      }\n    }\n    \n    if (this.fabOpen) {\n      const fabEl = document.querySelector('.quick-actions-fab');\n      if (fabEl && !fabEl.contains(target)) {\n        this.fabOpen = false;\n      }\n    }\n\n    if (!this.showAccount && this.accountSearchWrapper) {\n      const wrapper = this.accountSearchWrapper.nativeElement;\n      if (!wrapper.contains(target) && !target.closest('.cdk-overlay-pane')) {\n        this.closeAccountSearch();\n      }\n    }\n  }\n\n  @HostListener('document:keydown.escape')\n  onEscape(): void {\n    if (!this.showAccount) {\n      this.closeAccountSearch();\n      return;\n    }\n    this.headerPanelService.requestClose();\n  }\n  \n  onQuickAction(element: { link: string; access: 'project' | 'account' }): void {\n    this.fabOpen = false;\n    if (element.access === 'account') {\n      this.lsService.checkAccountAccess({ link: element.link });\n      return;\n    }\n    this.getProjectsAccess(element.link);\n  }\n\n  getProjectsAccess(link: string): void {\n    this.account_info = this.lsService.getSelectedAccount();\n    const account_id = this.account_info.account_id;\n    const params = {\n      account_id,\n      view_type: 'create'\n    };\n\n    this.commonService.getProjects(params).pipe(\n      takeUntil(this.destroy$)\n    ).subscribe(result => {\n      if (result && result.status) {\n        if (result.data && result.data[account_id] && result.data[account_id]['project_list']) {\n          this.router.navigateByUrl(link);\n        } else {\n          this.openMessageDialog('Admin access on any project of this account');\n        }\n      }\n    });\n  }\n  switchAccount() {\n    this.router.navigateByUrl('/dashboard/switch-account');\n  }\n\n  openMessageDialog(accessMessage: string) {\n    this.dialog.open(MessageDialogComponent, {\n      panelClass: 'sm-dialog',\n      width: '600px',\n      data: {\n        message: `You do not have ${accessMessage}. Please contact support.`,\n        heading: 'Access Required'\n      }\n    });\n  }\n\n  ipSearch() {\n    this.searchCompleted = false;\n    this.searchSubject.next(this.inputformCtrl.value);\n    if (!this.inputformCtrl.value || this.inputformCtrl.value.length < 3) {\n      this.ipList = [];\n    }\n  }\n\n  private performSearch() {\n    if (this.inputformCtrl.value && this.inputformCtrl.value.length >= 3) {\n      this.loader = true;\n      this.searchValue = this.inputformCtrl.value.trim();\n      const params = {\n        key: this.searchValue,\n        type: this.searchType\n      }\n      this.supportService.search(params).pipe(\n        takeUntil(this.destroy$)\n      ).subscribe(data => {\n        if (data && data.status == 1 && data.key == this.searchValue) {\n          this.ipList = data.data;\n        }\n        if(data && data.message){this.notificationService.notify(data.message);}\n        this.loader = false;\n        this.searchCompleted = true;\n      },\n        error => {\n          this.notificationService.notify(error);\n          this.loader = false;\n          this.searchCompleted = true;\n        })\n    }\n    else {\n      this.ipList = [];\n      this.searchCompleted = false;\n    }\n  }\n\n  // redirect to list selected from search dropdown\n  redirectToPage(iscloseDialog) {\n    if (this.selectedObj.type) {\n      const queryParams = {\n        search: this.searchValue.trim(),\n        type: this.selectedObj.type\n      }\n      const params = new URLSearchParams(queryParams).toString();\n      let url: string;\n      if (this.selectedObj.type == 'alias') {\n        url = this.urlMapObj['server'] + '?' + params;\n      }\n      else if (this.selectedObj.type == 'db-cluster') {\n        url = this.urlMapObj['cluster'] + '?' + params;\n      }\n      else if (this.selectedObj.type == 'elb') {\n        url = this.urlMapObj['elastic-loadbalancer'] + '?' + params;\n      }\n      else if (this.selectedObj.type == 'device_alias' || this.selectedObj.type == 'physical-server') {\n        url = this.urlMapObj['bare-metal'] + '?' + params;\n      }\n      else if (this.selectedObj.type == 'device') {\n        url = this.urlMapObj['device'] + '?' + params;\n      }\n      else if (this.selectedObj.type == 'domain') {\n        url = this.urlMapObj['domain'] + '?' + params;\n      }\n      else if (this.selectedObj.type == 'LB_NGINX') {\n        url = this.urlMapObj['nginx-cluster'] + '?' + params;\n      }\n      else {\n        url = this.urlMapObj[this.selectedObj.type] + '?' + params;\n      }\n      if (url == this.router.url) {\n        url = url.concat(\" \");\n      }\n      this.router.navigateByUrl('/dashboard/loader', { skipLocationChange: false }).then(() => {\n        this.router.navigateByUrl(url);\n      });\n    }\n    if (iscloseDialog) {\n      this.dialog.closeAll();\n    }\n  }\n\n  selected(obj) {\n    this.selectedObj = obj;\n    this.searchValue = this.inputformCtrl.value;\n\n    if (obj.account_id == this.account_info.account_id) { // is selected account is same\n      this.redirectToPage(false);\n      this.inputformCtrl.setValue(\"\");\n      this.ipList = [];\n    }\n    else { // if not open switch account confirm dialog\n      this.openConfirmAccountDialog(this.selectedObj);\n    }\n\n  }\n\n  openConfirmAccountDialog(data: any): void {\n    const dialogRef = this.dialog.open(ConfirmDialogComponent, {\n      panelClass: 'sm-dialog',\n      width: '600px',\n      data: { title: `Switch Account`, modalContent: `Your  Selected Account will be switched to ${data.account}` }\n    });\n\n    dialogRef.componentInstance.confirmAction.pipe(\n      takeUntil(this.destroy$)\n    ).subscribe(() => {\n      const accountIdlist = JSON.parse(localStorage.getItem(ACCOUNT_INFO));\n      const index = accountIdlist.findIndex(obj => obj.account_id == data.account_id);\n      const acc_obj = accountIdlist[index];\n      localStorage.setItem('SELECTED_ACCOUNT', JSON.stringify(acc_obj));\n\n      this.account_info = acc_obj;\n      this.ipList = [];\n      this.inputformCtrl.setValue('');\n      this.redirectToPage(true);\n    });\n  }\n\n  openDialog(): void {\n    this.dialog.open(SwitchAccountDialogComponent, {\n      panelClass: 'sm-dialog',\n      width: '850px',\n    });\n\n  }\n\n  onOverlayMenuClick(): void {\n    this.dialog.open(MenuComponent, {\n      panelClass: 'menu-dialog',\n      height: '95%',\n      width: '95%',\n      maxWidth: '90vw',\n      maxHeight: '90vh',\n    });\n\n  }\n\n  clearSearch() {\n    this.inputformCtrl.setValue(\"\");\n  }\n\n\n  \n\n  openSwitchAccountDialog(event: MouseEvent): void {\n    event.stopPropagation();\n    this.search_value = '';\n    this.showAccount = false;\n    this.printAccounts = this.sortAccounts(this.accountInfo);\n    setTimeout(() => {\n      this.accountInput?.nativeElement.focus();\n      this.accountAutoTrigger?.openPanel();\n    });\n  }\n\n  closeAccountSearch(): void {\n    this.search_value = '';\n    this.printAccounts = this.sortAccounts(this.accountInfo);\n    this.showAccount = true;\n    this.accountAutoTrigger?.closePanel();\n  }\n\n  searchAccount() {\n    let filtered: any[] = [];\n    if (this.search_value) {\n      const search = this.search_value.toLocaleLowerCase();\n      filtered = (this.accountInfo ?? []).filter((element: any) =>\n        element.account_name.toLowerCase().includes(search)\n      );\n    } else {\n      filtered = this.accountInfo ?? [];\n    }\n    this.printAccounts = this.sortAccounts(filtered);\n  }\n\n  private loadFavoriteAccountIds(): void {\n    const stored = this.cookieService.get(FAVORITE_ACCOUNT_ID);\n    if (!stored) {\n      this.favoriteAccountIds = [];\n      return;\n    }\n\n    let ids: number[] = [];\n    try {\n      const parsed = JSON.parse(stored);\n      ids = (Array.isArray(parsed) ? parsed : [parsed]).map(Number);\n    } catch {\n      ids = [Number(stored)];\n    }\n\n    const validIds = ids.filter((id) =>\n      !Number.isNaN(id) && (this.accountInfo ?? []).some((account: any) => account.account_id === id)\n    );\n    this.favoriteAccountIds = validIds;\n\n    if (validIds.length !== ids.length) {\n      this.saveFavoriteAccountIds();\n    }\n  }\n\n  private saveFavoriteAccountIds(): void {\n    if (!this.favoriteAccountIds.length) {\n      this.cookieService.delete(FAVORITE_ACCOUNT_ID);\n      return;\n    }\n    this.cookieService.set(FAVORITE_ACCOUNT_ID, JSON.stringify(this.favoriteAccountIds), 30);\n  }\n\n  private sortAccounts(accounts: any[]): any[] {\n    if (!accounts?.length) {\n      return [];\n    }\n\n    const favoriteSet = new Set(this.favoriteAccountIds);\n    return [...accounts]\n      .sort((a, b) => {\n        const aIndex = this.favoriteAccountIds.indexOf(a.account_id);\n        const bIndex = this.favoriteAccountIds.indexOf(b.account_id);\n        const aFavorite = aIndex !== -1;\n        const bFavorite = bIndex !== -1;\n        if (aFavorite && bFavorite) {\n          return aIndex - bIndex;\n        }\n        if (aFavorite) {\n          return -1;\n        }\n        if (bFavorite) {\n          return 1;\n        }\n        return a.account_name.localeCompare(b.account_name);\n      })\n      .map((account) => ({\n        ...account,\n        isFavorite: favoriteSet.has(account.account_id),\n      }));\n  }\n\n  toggleFavoriteAccount(account: any, event: MouseEvent): void {\n    event.stopPropagation();\n    event.preventDefault();\n    const index = this.favoriteAccountIds.indexOf(account.account_id);\n    if (index !== -1) {\n      this.favoriteAccountIds = this.favoriteAccountIds.filter((id) => id !== account.account_id);\n    } else {\n      this.favoriteAccountIds = [...this.favoriteAccountIds, account.account_id];\n    }\n    this.saveFavoriteAccountIds();\n    this.printAccounts = this.sortAccounts(this.printAccounts);\n  }\n\n\n  changeAccount(obj){\n    this.selectedAccount=obj\n    localStorage.setItem(\"SELECTED_ACCOUNT\",JSON.stringify(this.selectedAccount));\n    localStorage.setItem(\"SELECTED_ACCOUNT_NAME\", this.selectedAccount.account_name);\n    this.closeAccountSearch();\n    navigateAfterAccountSwitch(this.landingPage);\n  }\n\n    onClose(){\n      this.closeAccountSearch();\n    }\n\n    checkTempForView(tab){\n      const user_info = localStorage.getItem(\"USER_INFO\");\n      if(user_info && JSON.parse(user_info)){\n        const email = JSON.parse(user_info).email;\n        if(!this.tempEmailList.includes(email) && tab == 'Service Request New'){\n          return false;\n        }\n        else{\n          return true;\n        }\n      }\n    }\n    \n  \n\n    isAllServicesOpen = false;\n    panelLeft = 0;\n\n    toggleAllServices(event: MouseEvent): void {\n      event.stopPropagation();\n      this.headerPanelService.requestClose(this.allServicesPanelId);\n      if (!this.isAllServicesOpen && this.allServiceWrapper) {\n        const sidebarWidth = this.sidenavExpanded ? 200 : 55;\n        const panelWidth = Math.min(860, window.innerWidth - sidebarWidth - 10);\n        const maxLeft = window.innerWidth - panelWidth - 10;\n        const rect = this.allServiceWrapper.nativeElement.getBoundingClientRect();\n        this.panelLeft = Math.max(sidebarWidth + 4, Math.min(rect.left, maxLeft));\n      }\n      this.isAllServicesOpen = !this.isAllServicesOpen;\n    }\n\n    closeAllServicesPanel(): void {\n      this.isAllServicesOpen = false;\n    }\n    \n    \n    // ═══════════════════════════════════════════════════════════════\n    // DOCUMENTATION & FEEDBACK\n    // ═══════════════════════════════════════════════════════════════\n    \n    goToDocumentation(): void {\n      window.open('https://wiki.timesinternet.in/en/home/Guardrail/About', '_blank', 'noopener noreferrer');\n    }\n    \n    navigateToDashboard(): void {\n      this.router.navigateByUrl('/dashboard/home');\n    }\n    \n    // ═══════════════════════════════════════════════════════════════\n    // SEARCH COLLAPSE/EXPAND\n    // ═══════════════════════════════════════════════════════════════\n    \n    toggleSearch(): void {\n      this.isSearchExpanded = true;\n    }\n    \n    onSearchBlur(): void {\n      // Only collapse if input is empty\n      if (!this.inputformCtrl.value || this.inputformCtrl.value.trim() === '') {\n        this.isSearchExpanded = false;\n        this.ipList = [];\n      }\n    }\n\n    onSearchMouseLeave(): void {\n      const activeEl = document.activeElement;\n      const isInputFocused = activeEl === this.searchInput?.nativeElement;\n      if (!isInputFocused && (!this.inputformCtrl.value || this.inputformCtrl.value.trim() === '')) {\n        this.isSearchExpanded = false;\n        this.ipList = [];\n      }\n    }\n    \n    focusSearch(): void {\n      if (this.searchInput) {\n        this.searchInput.nativeElement.focus();\n      }\n    }\n    \n    closeSearch(): void {\n      this.isSearchExpanded = false;\n      this.inputformCtrl.setValue(\"\");\n      this.ipList = [];\n    }\n    \n\n    \n    \n    onFabHoverOpen(): void {\n   \n      this.fabOpen = true;\n    }\n    \n    toggleFab(event: MouseEvent): void {\n      event.stopPropagation();\n      this.headerPanelService.requestClose(this.quickActionsPanelId);\n      this.fabOpen = !this.fabOpen;\n    }\n    \n\n    checkAccount(): boolean {\n      return this.selectedAccount?.account_id !== 76;\n    }\n    \n    switchToSf(): void {\n      const target = this.accountInfo.find((u: any) => u.account_id === 76);\n      if (!target) { return; }\n      localStorage.setItem('SELECTED_ACCOUNT', JSON.stringify(target));\n      localStorage.setItem('SELECTED_ACCOUNT_NAME', target.account_name);\n      navigateAfterAccountSwitch(this.landingPage);\n    }\n}\n\n\n\n","<header class=\"cloud-main-header\" [class.sidenav-expanded]=\"sidenavExpanded\">\n  <div class=\"head\">\n    <div class=\"header-main\">\n      <!-- Logo Section -->\n      <div\n        class=\"header-logo\"\n        [class.active]=\"isHomeActive\"\n        (click)=\"navigateToDashboard()\"\n        role=\"button\"\n        tabindex=\"0\"\n        (keydown.enter)=\"navigateToDashboard()\"\n        (keydown.space)=\"navigateToDashboard()\"\n        matTooltip=\"Go to Dashboard\"\n        matTooltipPosition=\"below\"\n      >\n        <span\n          class=\"gr-sprite gr-sprite-gr-icons gr-sprite-logo\"\n          aria-hidden=\"true\"\n        ></span>\n        <span class=\"header-logo__text\">Guardrail</span>\n      </div>\n\n      <!-- Logo / All Services separator -->\n      <span class=\"header-separator\"></span>\n\n      <!-- All Services Icon -->\n      <div class=\"all-service-wrapper\" #allServiceWrapper>\n        <button\n          class=\"header-icon-btn all-service-btn\"\n          matTooltip=\"All Services\"\n          matTooltipPosition=\"below\"\n          type=\"button\"\n          aria-label=\"All Services\"\n          (click)=\"toggleAllServices($event)\"\n        >\n          <span\n            class=\"gr-sprite gr-sprite-gr-icons gr-sprite-all-services\"\n          ></span>\n        </button>\n\n        <!-- All Services Dropdown Panel -->\n        <div\n          class=\"all-services-panel\"\n          [class.all-services-panel--open]=\"isAllServicesOpen\"\n          [style.left.px]=\"panelLeft\"\n          (click)=\"$event.stopPropagation()\"\n        >\n          <app-services-list\n            (itemSelected)=\"closeAllServicesPanel()\"\n          ></app-services-list>\n        </div>\n      </div>\n\n      <!-- Search Section -->\n      <div\n        class=\"search-section\"\n        (mouseenter)=\"isSearchExpanded = true\"\n        (mouseleave)=\"onSearchMouseLeave()\"\n      >\n        <div class=\"search-wrapper\">\n          <input\n            type=\"text\"\n            class=\"search-input\"\n            [class.search-input--expanded]=\"isSearchExpanded\"\n            placeholder=\"Search by IP, hostname, or instance ID...\"\n            [formControl]=\"inputformCtrl\"\n            [matAutocomplete]=\"auto\"\n            (focus)=\"toggleSearch()\"\n            (blur)=\"onSearchBlur()\"\n            (keyup)=\"ipSearch()\"\n            #searchInput\n          />\n          <button class=\"search-icon-btn\" type=\"button\" (click)=\"focusSearch()\">\n            <mat-icon>search</mat-icon>\n          </button>\n          <mat-autocomplete #auto=\"matAutocomplete\" class=\"header-search\">\n            <div class=\"load-spinner\" *ngIf=\"loader\">\n              <mat-option class=\"border\">\n                <mat-spinner [diameter]=\"40\"></mat-spinner>\n              </mat-option>\n            </div>\n            <div *ngIf=\"!loader\">\n              <mat-option\n                *ngFor=\"let obj of ipList\"\n                [value]=\"obj?.resource\"\n                (onSelectionChange)=\"selected(obj)\"\n                [disabled]=\"obj?.type === 'free_lb_ip'\"\n              >\n                <div class=\"flex justify\" *ngIf=\"obj?.type !== 'free_lb_ip'\">\n                  <div>\n                    {{ obj?.count }} {{ obj?.type\n                    }}<span\n                      *ngIf=\"\n                        obj?.count > 1 &&\n                        obj?.type !== 'alias' &&\n                        obj?.type !== 'device_alias'\n                      \"\n                      >s</span\n                    ><span\n                      *ngIf=\"\n                        obj?.count > 1 &&\n                        (obj?.type === 'alias' || obj?.type === 'device_alias')\n                      \"\n                      >es</span\n                    >\n                    in {{ obj?.account }}\n                  </div>\n                </div>\n                <div class=\"flex justify\" *ngIf=\"obj?.type === 'free_lb_ip'\">\n                  <div>Free IP attached to {{ obj.resource }}</div>\n                </div>\n              </mat-option>\n            </div>\n            <mat-option\n              *ngIf=\"\n                ipList?.length === 0 &&\n                inputformCtrl.value?.length >= 3 &&\n                !loader &&\n                searchCompleted\n              \"\n              >No Data Found</mat-option\n            >\n          </mat-autocomplete>\n        </div>\n      </div>\n    </div>\n    <div class=\"cloud-right\">\n      <!--------Quick action + tab----------------->\n\n      <div class=\"align-center gap\">\n        <div class=\"quick-actions-fab\">\n          <div\n            class=\"fab-panel\"\n            [class.visible]=\"fabOpen\"\n            (click)=\"$event.stopPropagation()\"\n          >\n            <div class=\"fab-actions-list\">\n              <div\n                *ngFor=\"let element of quickActions\"\n                class=\"services\"\n                (click)=\"onQuickAction(element)\"\n              >\n                <span class=\"sprite-sc quick-icons {{ element.css }}\"></span>\n                <div class=\"service-text\">\n                  <div class=\"service-name\">{{ element.name }}</div>\n                  <div class=\"service-desc\">{{ element.desc }}</div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <button\n            class=\"header-icon-btn fab-btn\"\n            (click)=\"toggleFab($event)\"\n            matTooltip=\"Quick Actions\"\n            matTooltipPosition=\"below\"\n            aria-label=\"Quick Actions\"\n            type=\"button\"\n          >\n            <span\n              class=\"gr-sprite gr-sprite-gr-icons gr-sprite-quick-actions\"\n            ></span>\n          </button>\n        </div>\n        <!--+ tab closed here -->\n\n        <div #accountSearchWrapper class=\"account-search-wrapper\">\n        <div\n          *ngIf=\"showAccount\"\n          class=\"account-name-selected\"\n          matTooltip=\"Click to Switch  Account\"\n          (click)=\"openSwitchAccountDialog($event)\"\n        >\n          {{ selectedAccount.account_name }}\n        </div>\n        <div *ngIf=\"!showAccount\" class=\"account-search\">\n          <input\n            #accountInput\n            placeholder=\"Select Account\"\n            [matAutocomplete]=\"accountAuto\"\n            #accountAutoTrigger=\"matAutocompleteTrigger\"\n            (keyup)=\"searchAccount()\"\n            [(ngModel)]=\"search_value\"\n          />\n          <mat-icon aria-hidden=\"false\" aria-label=\"search\" class=\"searchicon\"\n            >search</mat-icon\n          >\n          <mat-autocomplete\n            #accountAuto=\"matAutocomplete\"\n            class=\"header-search\"\n          >\n            <div>\n              <mat-option\n                *ngFor=\"let obj of printAccounts\"\n                [value]=\"obj.account_name\"\n                (onSelectionChange)=\"changeAccount(obj)\"\n              >\n                <div class=\"account-option\">\n                  <mat-icon\n                    class=\"account-favorite-icon\"\n                    [class.account-favorite-icon--active]=\"obj.isFavorite\"\n                    (mousedown)=\"\n                      $event.preventDefault(); $event.stopPropagation()\n                    \"\n                    (click)=\"toggleFavoriteAccount(obj, $event)\"\n                    >{{ obj.isFavorite ? \"star\" : \"star_border\" }}</mat-icon\n                  >\n                  <span class=\"account-option__name\">{{\n                    obj.account_name\n                  }}</span>\n                </div>\n              </mat-option>\n            </div>\n          </mat-autocomplete>\n          <div class=\"divide-line\"></div>\n          <mat-icon class=\"close\" (click)=\"onClose()\" title=\"Close\"\n            >close</mat-icon\n          >\n        </div>\n        </div>\n\n        <!------------Support feature----------->\n        <app-contact></app-contact>\n        <!---support end here ---->\n\n        <!-- Documentation Icon -->\n        <button\n          class=\"header-icon-btn doc-icon-btn\"\n          (click)=\"goToDocumentation()\"\n          matTooltip=\"Documentation\"\n          matTooltipPosition=\"below\"\n          aria-label=\"Documentation\"\n          type=\"button\"\n        >\n          <span\n            class=\"gr-sprite gr-sprite-gr-icons gr-sprite-documentation\"\n          ></span>\n        </button>\n\n        <!-- What's New / Updates Icon -->\n        <app-new-updates></app-new-updates>\n\n        <!-- Switch to Platform Account -->\n        <button\n          *ngIf=\"checkAccount()\"\n          class=\"header-icon-btn platform-btn\"\n          (click)=\"switchToSf()\"\n          matTooltip=\"Switch to Platform Account\"\n          matTooltipPosition=\"below\"\n          aria-label=\"Switch to Platform Account\"\n          type=\"button\"\n        >\n          <span class=\"gr-sprite gr-sprite-gr-icons gr-sprite-platform\"></span>\n        </button>\n\n        <app-account-menu></app-account-menu>\n      </div>\n    </div>\n  </div>\n</header>\n","import { Component, OnInit } from '@angular/core';\nimport { Router} from '@angular/router';\nimport { TOKEN_NAME } from '../../constants/local.storage';\nimport { TabPaginationNavigationService } from '../_services/utility/tab-pagination-navigation.service';\n\n\n@Component({\n  selector: 'app-layout',\n  templateUrl: './layout.component.html',\n  styleUrls: ['./layout.component.scss']\n})\nexport class LayoutComponent implements OnInit {\n  \n  sidenavExpanded = false;\n\n  constructor(\n    private router: Router,\n    private _tabPaginationNav: TabPaginationNavigationService,\n  ) {}\n  \n  onSidenavExpandedChange(expanded: boolean) {\n    this.sidenavExpanded = expanded;\n  }\n\n  ngOnInit(): void {\n    const auth_token = localStorage.getItem(TOKEN_NAME);\n    if(!window.location.href.includes('aggrements')){\n      if(!auth_token) this.router.navigateByUrl(\"/login\");\n    }\n  }\n\n  isLandingPage() : boolean {\n    if (this.router.url.includes(\"dashboard/home\")) {\n      return true;\n    } else {\n      return false;\n    }\n  }\n\n}\n","<app-header [sidenavExpanded]=\"sidenavExpanded\"></app-header>\n<div class=\"cloud-main-content\" [class.sidenav-expanded]=\"sidenavExpanded\">\n    <app-topnav [sidenavExpanded]=\"sidenavExpanded\"></app-topnav>\n    <app-sidenav (sidenavExpandedChange)=\"onSidenavExpandedChange($event)\"></app-sidenav>\n    <div class=\"content-wrapper\" [ngClass]=\"isLandingPage() ? 'landing-page' : 'not-landing-page'\">\n        <router-outlet></router-outlet>\n    </div>\n</div>\n\n<app-shelf-shell></app-shelf-shell>\n","import { Component, Inject, Output, EventEmitter, OnInit } from '@angular/core';\nimport { MatDialog, MatDialogRef, MAT_DIALOG_DATA } from '@angular/material/dialog';\nimport { LocalStorageService } from '../../_services/utility/localstorage.service';\nimport { appConstants } from '../../../constants/app.constants';\nimport { Router } from '@angular/router';\nimport { allRoutesMap} from '../../../constants/url.constants';\n\n\nexport interface DialogData {\n  title: string;\n  modalContent: string;\n  onlyDisplay : boolean;\n} \n\n@Component({\n  selector: 'menu-dialog',\n  templateUrl: './menu.component.html',\n  styleUrls: ['./menu.component.scss'],\n  providers:[LocalStorageService]\n})\n\nexport class MenuComponent implements OnInit {\n\n  allRoutesMapObj : any = allRoutesMap;\n  menuMapObj : any;\n  queue : any;\n  tempEmailList : any = appConstants['tempEmailList'];\n  externalLinks: any = appConstants['externalLinks'];\n\n  constructor(\n    public dialogRef: MatDialogRef<MenuComponent>,\n    @Inject(MAT_DIALOG_DATA) public data: DialogData,\n    private lsService : LocalStorageService,private router : Router) {\n    }\n\n  ngOnInit(): void {\n    // this.checkTempForView()\n    this.queue = this.lsService.fetchQueue();\n\n  }\n\n  onCancel(): void {\n    this.dialogRef.close();\n  }\n\n  navigate(link){\n    this.router.navigateByUrl(link);\n    this.onCancel();\n  }\n\n  getKeyByValue(value) {\n    let obj = this.allRoutesMapObj;\n    return Object.keys(obj).find(key => obj[key] === value);\n  }\n\n  navigateToExternalLink(link){\n    window.open(link, \"_blank\");\n  }\n\n}\n","<div mat-dialog-title>\n    <mat-icon class=\"close close_pointer\" (click)=\"onCancel()\" title=\"Close\">close</mat-icon>\n</div>\n<div>\n    <h5 class=\"menu-head\">Recently Viewed</h5>\n    <div class=\"cards-container\">\n        <div *ngFor=\"let link of queue\" class=\"cards\" (click)=\"navigate(link)\">\n            <div [className]=\"'icon icons-menu ml-3 menu-icon-' + getKeyByValue(link)\"></div>\n            <p>{{getKeyByValue(link) | noUnderscoreString}}</p>\n        </div>\n    </div>\n    \n</div>\n\n<div>\n    <h5 class=\"menu-head\">Available Services</h5>\n</div>\n\n<div class=\"main-head service-card\">\n    <div class=\"menu-section\" *ngFor=\"let head of menuMapObj | objectKeys\">\n        <h5 class=\"service-head\">{{head}}</h5>\n        <div class=\"menu-links-container\">\n            <div *ngFor=\"let list of menuMapObj[head]\" class=\"menu-links\" (click)=\"navigate(list.link)\">\n                <div [className]=\"'icon icons-menu menu-icon-' + list.mapCss\"></div>\n                <div class=\"menu-details\">\n                    <p class=\"name\">{{list.name}}</p>\n                    <p class=\"desc\">{{list.desc}}</p>\n                </div>\n            </div>\n            <ng-container *ngFor=\"let list of externalLinks\">\n                <div *ngIf=\"head=='support'\" class=\"menu-links\" (click)=\"navigateToExternalLink(list.link)\">\n                    <div [className]=\"'icon icons-menu menu-icon-' + list.mapCss\"></div>\n                    <div class=\"menu-details\">\n                        <p class=\"name\">{{list.name}}</p>\n                        <p class=\"desc\">{{list.desc}}</p>\n                    </div>\n                </div>\n            </ng-container>\n            \n        </div>\n        \n    </div>\n</div>\n","import { Component, OnInit, OnDestroy, Output, EventEmitter } from '@angular/core';\nimport { tabLisiting } from '../../../constants/url.constants';\nimport { urlMatchesTabEntry } from 'src/app/_utils/tab-navigation.util';\nimport { Router, NavigationEnd } from '@angular/router';\nimport { Subject } from 'rxjs';\nimport { filter, takeUntil } from 'rxjs/operators';\nimport { EventService } from '../../_services/utility/event.service';\nimport { LocalStorageService } from '../../_services/utility/localstorage.service';\n\n@Component({\n  selector: 'app-sidenav',\n  templateUrl: './sidenav.component.html',\n  styleUrls: ['./sidenav.component.scss'],\n  providers: [LocalStorageService]\n})\nexport class SidenavComponent implements OnInit, OnDestroy {\n\n  @Output() sidenavExpandedChange = new EventEmitter<boolean>();\n\n  isFullscreen = false;\n  activeMenu = 0;\n  sideNavListing: string[] = [];\n  listTab = tabLisiting;\n  updatedData: any = {};\n\n  showToggleBtn = false;\n\n  private flag = true;\n  private _isExpanded = false;\n  private hideButtonTimeout: ReturnType<typeof setTimeout>;\n  private destroy$ = new Subject<void>();\n\n  get isExpanded(): boolean {\n    return this._isExpanded;\n  }\n\n  set isExpanded(value: boolean) {\n    this._isExpanded = value;\n    this.sidenavExpandedChange.emit(value);\n  }\n\n  constructor(\n    private router: Router,\n    private eventService: EventService,\n    private lsService: LocalStorageService\n  ) {\n    this.router.events.pipe(\n      filter((event): event is NavigationEnd => event instanceof NavigationEnd),\n      takeUntil(this.destroy$)\n    ).subscribe(() => this.onNavigationEnd());\n  }\n\n  ngOnInit(): void {\n    document.addEventListener('fullscreenchange', this.onFullscreenChange);\n    this.onNavigationEnd();\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n    document.removeEventListener('fullscreenchange', this.onFullscreenChange);\n    if (this.hideButtonTimeout) {\n      clearTimeout(this.hideButtonTimeout);\n    }\n  }\n\n  toggleSidenav(): void {\n    this.isExpanded = !this.isExpanded;\n  }\n\n  onSidenavMouseEnter(): void {\n    if (this.hideButtonTimeout) {\n      clearTimeout(this.hideButtonTimeout);\n    }\n    this.showToggleBtn = true;\n  }\n\n  onSidenavMouseLeave(): void {\n    this.hideButtonTimeout = setTimeout(() => {\n      this.showToggleBtn = false;\n    }, 500);\n  }\n\n  selectedTab(i: number): void {\n    this.activeMenu = i;\n    this.eventService.emitChange(this.sideNavListing[i]);\n  }\n\n  fullscreenClick(): void {\n    if (!document.fullscreenElement) {\n      document.documentElement.requestFullscreen().catch(() => {});\n    } else {\n      document.exitFullscreen().catch(() => {});\n    }\n  }\n\n  private onNavigationEnd(): void {\n    const selectedAccount = this.lsService.getSelectedAccount();\n\n    if (!([76, 77, 79, 92].includes(selectedAccount.account_id))) {\n      this.updatedData = JSON.parse(JSON.stringify(this.listTab));\n      delete this.updatedData['platform_services'];\n    } else {\n      this.updatedData = JSON.parse(JSON.stringify(this.listTab));\n    }\n\n    this.sideNavListing = Object.keys(this.updatedData);\n    this.updateActiveMenuFromRoute();\n  }\n\n  private updateActiveMenuFromRoute(): void {\n    this.flag = true;\n    const sidenavBarList = Object.values(this.updatedData);\n\n    sidenavBarList.forEach((ele: any, index: number) => {\n      ele.forEach((k: any) => {\n        if (urlMatchesTabEntry(this.router.url, k)) {\n          this.flag = false;\n          this.activeMenu = index;\n        }\n        if (\n          this.router.url.includes('dashboard/all-services/services-list') ||\n          this.router.url.includes('dashboard/profile/my-profile')\n        ) {\n          this.flag = true;\n        }\n      });\n    });\n\n    if (this.flag) {\n      this.activeMenu = 12;\n    }\n  }\n\n  private onFullscreenChange = (): void => {\n    this.isFullscreen = !!document.fullscreenElement;\n\n    const body = document.body;\n    if (this.isFullscreen) {\n      body.classList.add('fullscreen-enabled');\n      this.eventService.emitChange(true);\n    } else {\n      body.classList.remove('fullscreen-enabled');\n      this.eventService.clearChanges();\n    }\n  };\n}\n","<div class=\"navbar\"\n     [class.expanded]=\"isExpanded\"\n     (mouseenter)=\"onSidenavMouseEnter()\"\n     (mouseleave)=\"onSidenavMouseLeave()\">\n\n  <!-- TOGGLE BUTTON -->\n  <button class=\"toggle-btn\" \n          [class.visible]=\"showToggleBtn\"\n          [class.expanded]=\"isExpanded\"\n          (click)=\"toggleSidenav()\">\n    <mat-icon>{{ isExpanded ? 'chevron_left' : 'chevron_right' }}</mat-icon>\n  </button>\n\n  <!-- TOP MENU -->\n  <ul>\n    <li *ngFor=\"let name of sideNavListing; let i = index\">\n      <div class=\"nav-row\"\n           (click)=\"selectedTab(i)\"\n           [ngClass]=\"{'active': activeMenu == i}\"\n           matTooltip=\"{{ name | underscoreCapitalCheck }}\"\n           [matTooltipPosition]=\"'right'\"\n           [matTooltipDisabled]=\"isExpanded\">\n\n        <span class=\"gr-sprite gr-sprite-gr-icons gr-sprite-{{name}}\"></span>\n        <span class=\"nav-label\">{{ name | underscoreCapitalCheck }}</span>\n\n      </div>\n    </li>\n  </ul>\n\n  <!-- BOTTOM MENU -->\n  <ul class=\"nav-bottom\">\n\n    <li>\n      <div class=\"nav-row\" (click)=\"fullscreenClick()\">\n        <span class=\"gr-sprite gr-sprite-gr-icons\"\n                [ngClass]=\"{'gr-sprite-fullscreen': !isFullscreen, 'gr-sprite-exit-fullscreen': isFullscreen}\"></span>\n        <span class=\"nav-label\">{{ isFullscreen ? 'Exit Fullscreen' : 'Fullscreen' }}</span>\n      </div>\n    </li>\n\n  </ul>\n\n</div>","import { Component, Inject, Output, EventEmitter } from \"@angular/core\";\nimport {\n  MatDialog,\n  MatDialogRef,\n  MAT_DIALOG_DATA,\n} from \"@angular/material/dialog\";\nimport { LocalStorageService } from \"../../../_services/utility/localstorage.service\";\nimport { appConstants } from \"../../../../constants/app.constants\";\nimport { navigateAfterAccountSwitch } from '../../account-switch-navigation';\nimport { Router } from \"@angular/router\";\n\nexport interface DialogData {\n  title: string;\n  modalContent: string;\n  onlyDisplay: boolean;\n}\n\n@Component({\n  selector: \"switch-account-dialog\",\n  templateUrl: \"./switch-account-dialog.component.html\",\n  styleUrls: [\"./switch-account-dialog.component.scss\"],\n  providers: [LocalStorageService],\n})\nexport class SwitchAccountDialogComponent {\n  confirmAction = new EventEmitter<any>();\n  spin: boolean;\n  accountInfo: any;\n  accountsIconUrl: any;\n  selectedAccount: any;\n  activeImage: any = {};\n  displayText: any = {};\n  search_value: string;\n  printAccounts: any = [];\n\n  constructor(\n    public dialogRef: MatDialogRef<SwitchAccountDialogComponent>,\n    @Inject(MAT_DIALOG_DATA) public data: DialogData,\n    private lsService: LocalStorageService,\n    private router: Router,\n  ) {\n    this.accountInfo = JSON.parse(localStorage.getItem(\"USER_ACCOUNTS\"));\n    this.sortAccountInfo();\n    this.printAccounts = this.accountInfo;\n\n    if (!localStorage[\"SELECTED_ACCOUNT\"]) {\n      this.selectedAccount = this.accountInfo[0];\n      localStorage.setItem(\n        \"SELECTED_ACCOUNT\",\n        JSON.stringify(this.selectedAccount),\n      );\n    } else this.selectedAccount = lsService.getSelectedAccount();\n\n    this.accountsIconUrl = appConstants[\"s3AccountsIconUrl\"];\n    this.activeImage[this.selectedAccount.account_name] = true;\n  }\n\n  onCancel(): void {\n    this.dialogRef.close();\n  }\n\n  confirm() {\n    this.spin = true;\n    this.confirmAction.emit(true);\n  }\n\n  changeAccount(account: any) {\n    if (account == true) {\n      localStorage.setItem(\n        \"SELECTED_ACCOUNT\",\n        JSON.stringify(this.selectedAccount),\n      );\n      this.onCancel();\n      navigateAfterAccountSwitch();\n    } else {\n      this.selectedAccount = account;\n      this.activeImage = {};\n      this.activeImage[account.account_name] = true;\n    }\n  }\n\n  // sort accounts list by account_name\n  sortAccountInfo() {\n    function compare(a, b) {\n      // Use toUpperCase() to ignore character casing\n      const accA = a.account_name.toUpperCase();\n      const accB = b.account_name.toUpperCase();\n\n      let comparison = 0;\n      if (accA > accB) {\n        comparison = 1;\n      } else if (accA < accB) {\n        comparison = -1;\n      }\n      return comparison;\n    }\n\n    this.accountInfo.sort(compare);\n    this.changeIconName();\n  }\n\n  changeIconName() {\n    for (let i = 0; i < this.accountInfo.length; i++) {\n      this.accountInfo[i].icon = this.accountInfo[i].icon\n        ? this.accountInfo[i].icon.replace(/ +/g, \"\")\n        : \"\";\n    }\n    this.printAccounts = this.accountInfo;\n  }\n\n  // in case no image found\n  callOnErr(account) {\n    this.displayText[account.account_name] = true;\n  }\n\n  searchAccount() {\n    this.printAccounts = [];\n    if (this.search_value) {\n      const allAcounts = this.accountInfo;\n      allAcounts.map((element) => {\n        const accName = element.account_name.toLowerCase();\n        const includeAccount = accName.includes(\n          this.search_value.toLocaleLowerCase(),\n        );\n        if (includeAccount) {\n          this.printAccounts.push(element);\n        }\n      });\n    } else {\n      this.printAccounts = this.accountInfo;\n    }\n  }\n}\n","<div class=\"account-dialog\" mat-dialog-title>\n        <mat-icon class=\"close\" (click)=\"onCancel()\" title=\"Close\">close</mat-icon>\n        <h4>Choose Account</h4>\n        <p class=\"light-font\">Select the business name</p>\n    </div>\n    \n\n<!-- Search Account-->\n<div class=\"search-box\">\n    <input placeholder=\"Search Account\" [(ngModel)]=\"search_value\" type=\"search\" (keyup.enter)=\"searchAccount()\">\n    <button type=\"submit\" (click)=\"searchAccount()\">\n        <mat-icon aria-hidden=\"false\" aria-label=\"search\">search</mat-icon>\n    </button>\n</div>\n    \n    <div mat-dialog-content>\n        <div class=\"modal-content\">\n            <div class=\"row\">\n                <div class=\"col-2\" *ngFor=\"let account of printAccounts;\">\n                   <div class=\"box\" (click)=\"changeAccount(account)\" [ngClass]=\"{'activeBox': activeImage[account.account_name]}\">\n                        <img height=\"auto\"  (error)=\"callOnErr(account)\" *ngIf=\"!activeImage[account.account_name] && !displayText[account.account_name]\" width=\"auto\" src=\"{{accountsIconUrl + account.icon + '.webp'}}\"  alt=\"{{account.account_name}}\" >\n                        <img height=\"auto\"  (error)=\"callOnErr(account)\" width=\"auto\" *ngIf=\"activeImage[account.account_name] && !displayText[account.account_name]\" src=\"{{accountsIconUrl +  account.icon + '_active.webp'}}\"  alt=\"{{account.account_name}}\" >\n                        <span *ngIf=\"displayText[account.account_name]\" class=\"imagetxt\">{{account.account_name}}</span>\n                   </div>\n                </div>       \n            </div>\n            <div *ngIf=\"accountInfo?.length == 0\" class=\"noaccess-title\">\n                <div class=\"space-icon space-noaccess\"></div>\n                <div class=\"space-title\">\n                    You do not have access to any Business.\n                </div>\n            </div>  \n            <!-- no data image -->\n            <div *ngIf=\"printAccounts?.length == 0\">\n                <div class=\"space-icon space-nodata\">nodata</div>\n                <div class=\"space-title\">No Accounts Found</div>\n            </div>\n        </div>\n    \n    </div>\n\n    <div class=\"text-center mt\" mat-dialog-actions>\n     <button class=\"actions-btns cancel\" mat-flat-button (click)=\"onCancel()\"> Cancel </button>\n     <button *ngIf=\"printAccounts?.length > 0\" mat-flat-button class=\"actions-btns\" color=\"primary\" (click)=\"changeAccount(true)\"\n         cdkFocusInitial>Change\n         \n     </button>\n </div>\n   ","import { Component, OnInit, OnDestroy, Input } from '@angular/core';\nimport { Router, NavigationEnd, ActivatedRoute } from '@angular/router';\nimport { Subject } from 'rxjs';\nimport { takeUntil } from 'rxjs/operators';\nimport { LocalStorageService } from '../../_services/utility/localstorage.service';\nimport { EventService } from 'src/app/_services/utility/event.service';\nimport { tabLisiting } from '../../../constants/url.constants';\nimport { urlMatchesTabEntry } from 'src/app/_utils/tab-navigation.util';\n\n@Component({\n  selector: 'app-topnav',\n  templateUrl: './topnav.component.html',\n  styleUrls: ['./topnav.component.scss'],\n  providers: [LocalStorageService]\n})\nexport class TopnavComponent implements OnInit, OnDestroy {\n  @Input() sidenavExpanded:boolean = false;\n  listTab: any = tabLisiting;\n  updatedData: any = {};\n  optionTabs: any = [];\n  activeTab: any = 'Cloud Server';\n  selectedSideNav: any = 'server';\n  selectedAccount: any;\n  showTopNav: boolean = false;\n  flag: boolean = true;\n  \n  private destroy$ = new Subject<void>();\n\n  constructor(\n    private router: Router,\n    private activatedRoute: ActivatedRoute,\n    private lsService: LocalStorageService,\n    private eventService: EventService\n  ) {\n    this.router.events.pipe(takeUntil(this.destroy$)).subscribe(event => {\n      if (event instanceof NavigationEnd) {\n        this.updateTopNav();\n      }\n    });\n  }\n\n  ngOnInit(): void {\n    this.updateTopNav();\n    \n    // Listen to sidenav selection changes\n    this.eventService.changeEmitted$.pipe(takeUntil(this.destroy$)).subscribe((val: string) => {\n      if (typeof (val) == 'string') {\n        this.selectedSideNav = val;\n        this.getTabsList(this.selectedSideNav);\n        this.router.navigateByUrl(this.updatedData[this.selectedSideNav][0]['link']);\n      }\n    });\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  updateTopNav(): void {\n    this.selectedAccount = this.lsService.getSelectedAccount();\n    \n    // Platform services are only visible to devops, SF, minio and monitoring accounts\n    if (!([76, 77, 79, 92].includes(this.selectedAccount.account_id))) {\n      this.updatedData = JSON.parse(JSON.stringify(this.listTab));\n      delete this.updatedData[\"platform_services\"];\n    } else {\n      this.updatedData = JSON.parse(JSON.stringify(this.listTab));\n    }\n\n    // Check if current route should show topnav\n    if (this.router.url.includes(\"dashboard/home\") || \n        this.router.url.includes(\"dashboard/switch-account\") ||\n        this.router.url.includes(\"dashboard/profile/my-profile\") || \n        this.router.url.includes(\"dashboard/all-services/services-list\")) {\n      this.showTopNav = false;\n      return;\n    }\n\n    // Check if current route matches any tab\n    this.flag = true;\n    let sidenavBarList = Object.values(this.updatedData);\n    let navMenuList = Object.keys(this.updatedData);\n    \n    sidenavBarList.forEach((ele: any, index) => {\n      ele.forEach((k) => {\n        if (urlMatchesTabEntry(this.router.url, k)) {\n          this.flag = false;\n          this.selectedSideNav = navMenuList[index];\n          this.getTabsList(this.selectedSideNav);\n          this.activeTab = k.name;\n          this.showTopNav = true;\n        }\n      });\n    });\n\n    if (this.flag) {\n      this.showTopNav = false;\n    }\n  }\n\n  selectTab(obj: any): void {\n    this.activeTab = obj.name;\n    this.router.navigateByUrl(obj.link);\n  }\n\n  getTabsList(selected: string): void {\n    this.optionTabs = [];\n    this.listTab[selected].map((element) => {\n      this.optionTabs.push(element.name);\n    });\n  }\n}\n","<div\n  *ngIf=\"showTopNav\"\n  class=\"topnav-container\"\n  [class.sidenav-expanded]=\"sidenavExpanded\"\n>\n  <div class=\"topnav-tabs\">\n    <!-- First 4 tabs -->\n    <ng-container *ngFor=\"let tab of listTab[selectedSideNav] | slice: 0 : 4\">\n      <div\n        class=\"topnav-tab\"\n        [ngClass]=\"{ active: activeTab === tab.name }\"\n        (click)=\"selectTab(tab)\"\n      >\n        {{ tab.name }}\n      </div>\n    </ng-container>\n\n    <!-- More dropdown for remaining tabs -->\n    <div\n      class=\"topnav-tab\"\n      [ngClass]=\"{ active: (optionTabs | slice: 4)?.includes(activeTab) }\"\n      *ngIf=\"optionTabs.length - 4 > 0\"\n      [matMenuTriggerFor]=\"moreMenu\"\n    >\n      <span *ngIf=\"!(optionTabs | slice: 4)?.includes(activeTab)\">More</span>\n      <span *ngIf=\"(optionTabs | slice: 4)?.includes(activeTab)\">\n        {{ activeTab | noUnderscoreString }}\n      </span>\n      <mat-icon class=\"dropdown-icon\">arrow_drop_down</mat-icon>\n    </div>\n\n    <mat-menu #moreMenu=\"matMenu\" xPosition=\"after\" class=\"topnav-menu\">\n      <ng-container *ngFor=\"let tab of listTab[selectedSideNav] | slice: 4\">\n        <button\n          mat-menu-item\n          (click)=\"selectTab(tab)\"\n          [ngClass]=\"{ active: activeTab === tab.name }\"\n        >\n          {{ tab.name | noUnderscoreString }}\n        </button>\n      </ng-container>\n    </mat-menu>\n  </div>\n</div>\n","import { Component, OnInit, AfterViewInit, OnDestroy, ViewChild, NgZone } from '@angular/core';\nimport { Subscription } from 'rxjs';\nimport { Router } from '@angular/router';\nimport { UntypedFormControl, Validators, UntypedFormGroup } from '@angular/forms';\n\nimport { AuthenticationService } from '../_services/all-requests/authentication.service';\nimport { NotificationService } from '../_services/utility/notification.service';\nimport { appConstants } from '../../constants/app.constants';\nimport {\n  TOKEN_NAME,\n  USER_INFO,\n  ACCOUNT_INFO,\n  SELECTED_ACCOUNT,\n  SELECTED_ACCOUNT_NAME,\n} from '../../constants/local.storage';\nimport { ThemeService } from '../_services/utility/theme.service';\nimport { OtpInputComponent } from './otp-input/otp-input.component';\nimport {\n  clearOtpSession,\n  getOtpSession,\n  otpDestinationMessage,\n  setOtpSession,\n} from './otp-session';\n\ndeclare const google: any;\n\n@Component({\n  selector: 'app-login',\n  providers: [AuthenticationService, NotificationService],\n  templateUrl: './login.component.html',\n  styleUrls: ['./login.component.scss']\n})\nexport class LoginComponent implements OnInit, AfterViewInit, OnDestroy {\n  s3url: string;\n  minIOBucketUrl: string;\n  logoPath = '';\n  processing = false;\n  googleSigningIn = false;\n\n  otpFormDisplay = false;\n  destinationMessage = '';\n  reqId = '';\n  otpError = false;\n  resendCooldown = 0;\n\n  private themeSub?: Subscription;\n  private resendTimer: ReturnType<typeof setInterval> | null = null;\n  private googleOAuthClient: any;\n\n  loginFormControl = new UntypedFormGroup({\n    emailid: new UntypedFormControl('', [Validators.required, Validators.email]),\n    userpassword: new UntypedFormControl('')\n  });\n\n  otpFormControl = new UntypedFormGroup({\n    otp: new UntypedFormControl('', [\n      Validators.required,\n      Validators.minLength(6),\n      Validators.maxLength(6),\n    ]),\n  });\n\n  @ViewChild(OtpInputComponent) otpInput?: OtpInputComponent;\n\n  constructor(\n    private authenticationService: AuthenticationService,\n    private router: Router,\n    private notificationService: NotificationService,\n    private ngZone: NgZone,\n    private themeService: ThemeService,\n  ) {\n    this.s3url = appConstants['s3Url'];\n    this.minIOBucketUrl = appConstants['minIOBucketUrl'];\n    this.updateLogoPath();\n  }\n\n  get emailid() {\n    return this.loginFormControl.get('emailid');\n  }\n\n  getErrorMessage() {\n    if (this.loginFormControl.controls['emailid'].errors?.['required']) {\n      return 'You must enter a value';\n    }\n    return this.loginFormControl.controls['emailid'].errors?.['email'] ? 'Not a valid email' : '';\n  }\n\n  ngOnInit(): void {\n    const auth_token = localStorage.getItem(TOKEN_NAME);\n    if (auth_token && auth_token !== 'null' && auth_token !== 'undefined') {\n      this.router.navigateByUrl(appConstants.LANDING_PAGE_URL, { replaceUrl: true });\n      return;\n    }\n\n    const session = getOtpSession();\n    if (session?.req_id) {\n      this.enterOtpUi(session.req_id, session.mobile, session.email, true);\n    }\n\n    this.themeSub = this.themeService.theme$.subscribe(() => this.updateLogoPath());\n    this.otpFormControl.get('otp')?.valueChanges.subscribe(() => {\n      if (this.otpError) this.otpError = false;\n    });\n  }\n\n  ngOnDestroy(): void {\n    this.themeSub?.unsubscribe();\n    this.clearResendCooldown();\n  }\n\n  ngAfterViewInit(): void {\n    this.googleSignInSetup();\n  }\n\n  private updateLogoPath(): void {\n    this.logoPath = this.themeService.isDarkTheme()\n      ? 'assets/images/Guardrail-light.png'\n      : `${appConstants.minIOBucketUrl}guardraill-logo_login.webp`;\n  }\n\n  loginSubmit() {\n    if (!this.loginFormControl.valid) return;\n\n    this.processing = true;\n    this.authenticationService.userLogin({\n      email: this.loginFormControl.value.emailid,\n      password: this.loginFormControl.value.userpassword\n    }).subscribe(\n      data => {\n        this.processing = false;\n        this.handleLoginResponse(data);\n      },\n      err => {\n        this.loginFormControl.reset('');\n        this.processing = false;\n        this.notificationService.error(err);\n      },\n    );\n  }\n\n  private handleLoginResponse(data: any): void {\n    if (!data || data['status'] != 1) {\n      if (data?.['message']) this.notificationService.error(data['message']);\n      return;\n    }\n    if (data['verify_otp']) {\n      if (!data['req_id']) return;\n      setOtpSession({\n        req_id: data['req_id'],\n        mobile: data['mobile'] || '',\n        email: data['email'] || '',\n      });\n      if (data['message']) this.notificationService.success(data['message']);\n      this.enterOtpUi(data['req_id'], data['mobile'] || '', data['email'] || '', true);\n      return;\n    }\n    this.onLoginSuccess(data);\n  }\n\n  private enterOtpUi(reqId: string, mobile: string, email: string, startCooldown: boolean): void {\n    this.reqId = reqId;\n    this.destinationMessage = otpDestinationMessage(mobile, email);\n    this.otpFormDisplay = true;\n    this.otpError = false;\n    this.otpFormControl.reset();\n    this.otpFormControl.enable();\n    if (startCooldown) this.startResendCooldown();\n  }\n\n  backFromOtp(): void {\n    clearOtpSession();\n    this.otpFormDisplay = false;\n    this.reqId = '';\n    this.destinationMessage = '';\n    this.otpError = false;\n    this.otpFormControl.reset();\n    this.otpFormControl.enable();\n    this.otpInput?.clear();\n    this.processing = false;\n    this.googleSigningIn = false;\n    this.clearResendCooldown();\n  }\n\n  onOtpComplete(otp: string): void {\n    if (this.processing || !otp || otp.length !== 6) return;\n    this.verifyOtp(otp);\n  }\n\n  verifyOtp(otp?: string): void {\n    const code = otp || this.otpFormControl.value.otp;\n    if (!code || String(code).length !== 6 || this.processing) return;\n\n    this.processing = true;\n    this.otpError = false;\n    this.otpFormControl.disable();\n\n    this.authenticationService.grVerifyOtp({ req_id: this.reqId, otp: Number(code) }).subscribe(\n      data => {\n        if (data && data['status'] == 1 && data['token']) {\n          this.onLoginSuccess(data, true);\n        } else {\n          this.onOtpVerifyFailed(data?.['message']);\n        }\n      },\n      err => this.onOtpVerifyFailed(err),\n    );\n  }\n\n  private onOtpVerifyFailed(message: any): void {\n    this.processing = false;\n    this.otpError = true;\n    this.otpFormControl.enable();\n    if (message) this.notificationService.error(message);\n    setTimeout(() => this.otpInput?.focusLast(), 0);\n  }\n\n  resendOtp(): void {\n    if (this.processing || this.resendCooldown > 0) return;\n\n    this.processing = true;\n    this.otpError = false;\n    this.otpFormControl.disable();\n\n    this.authenticationService.grResendOtp({ req_id: this.reqId }).subscribe(\n      data => {\n        this.processing = false;\n        this.otpFormControl.enable();\n        if (data && data['status'] == 1) {\n          const prev = getOtpSession();\n          const req_id = data['req_id'] || this.reqId;\n          const mobile = data['mobile'] ?? prev?.mobile ?? '';\n          const email = data['email'] ?? prev?.email ?? '';\n          this.reqId = req_id;\n          setOtpSession({ req_id, mobile, email });\n          this.destinationMessage = otpDestinationMessage(mobile, email);\n          if (data['message']) this.notificationService.success(data['message']);\n          this.otpInput?.clear();\n          this.startResendCooldown();\n        } else if (data?.['message']) {\n          this.notificationService.error(data['message']);\n        }\n      },\n      err => {\n        this.processing = false;\n        this.otpFormControl.enable();\n        this.notificationService.error(err);\n      },\n    );\n  }\n\n  private startResendCooldown(seconds = 30): void {\n    this.clearResendCooldown();\n    this.resendCooldown = seconds;\n    this.resendTimer = setInterval(() => {\n      this.ngZone.run(() => {\n        this.resendCooldown -= 1;\n        if (this.resendCooldown <= 0) this.clearResendCooldown();\n      });\n    }, 1000);\n  }\n\n  private clearResendCooldown(): void {\n    if (this.resendTimer) {\n      clearInterval(this.resendTimer);\n      this.resendTimer = null;\n    }\n    this.resendCooldown = 0;\n  }\n\n  private onLoginSuccess(data: any, hardReload = false): void {\n    try {\n      clearOtpSession();\n      if (data?.['message']) this.notificationService.success(data['message']);\n\n      const token = data?.['token'];\n      if (!token) return;\n\n      const payload = token.split('.')[1];\n      const userInfo = atob(payload.replace(/-/g, '+').replace(/_/g, '/'));\n      const accounts = data['accounts'] || [];\n\n      localStorage.setItem(TOKEN_NAME, token);\n      localStorage.setItem(USER_INFO, userInfo);\n      localStorage.setItem(ACCOUNT_INFO, JSON.stringify(accounts));\n\n      const storedSelectedAccountName = localStorage.getItem(SELECTED_ACCOUNT_NAME);\n      const firstAccount = accounts[0];\n\n      if (!storedSelectedAccountName || storedSelectedAccountName === 'null' || storedSelectedAccountName === 'undefined') {\n        if (firstAccount) {\n          localStorage.setItem(SELECTED_ACCOUNT, JSON.stringify(firstAccount));\n          localStorage.setItem(SELECTED_ACCOUNT_NAME, firstAccount.account_name);\n        }\n      } else {\n        const selectAcc = accounts.find(i => i?.account_name === storedSelectedAccountName);\n        if (selectAcc) {\n          const idx = accounts.findIndex(i => i?.account_id === selectAcc.account_id);\n          localStorage.setItem(SELECTED_ACCOUNT, JSON.stringify(accounts[idx >= 0 ? idx : 0]));\n        } else if (firstAccount) {\n          localStorage.setItem(SELECTED_ACCOUNT, JSON.stringify(firstAccount));\n          localStorage.setItem(SELECTED_ACCOUNT_NAME, firstAccount.account_name);\n        }\n      }\n\n      const urlHit = localStorage.getItem('urlHit');\n      let urlTONavigate = appConstants.LANDING_PAGE_URL;\n      if (urlHit && urlHit.split('?')[0] !== '/login') {\n        urlTONavigate = urlHit;\n      }\n\n      if (hardReload) {\n        setTimeout(() => { window.location.replace(urlTONavigate); }, 1200);\n      } else {\n        this.router.navigateByUrl(urlTONavigate, { replaceUrl: true });\n      }\n    } catch (e) {\n      console.error('onLoginSuccess failed:', e);\n      this.processing = false;\n    }\n  }\n\n  googleSignInSetup() {\n    if (typeof google === 'undefined' || !google.accounts?.oauth2) return;\n    this.googleOAuthClient = google.accounts.oauth2.initCodeClient({\n      client_id: appConstants.googleAuthClientId,\n      scope: appConstants.googleAuthScopes.join(' '),\n      ux_mode: 'popup',\n      callback: (response) => this.ngZone.run(() => this.onGoogleSignIn(response)),\n      error_callback: (err) => this.ngZone.run(() => this.onGoogleSignInError(err)),\n    });\n  }\n\n  triggerGoogleSignIn() {\n    if (this.googleSigningIn || !this.googleOAuthClient) return;\n    this.googleSigningIn = true;\n    this.googleOAuthClient.requestCode();\n  }\n\n  private onGoogleSignIn(response: any) {\n    if (response.error) {\n      this.googleSigningIn = false;\n      this.notificationService.error(\n        response.error === 'access_denied' ? 'Google sign-in cancelled' : response.error\n      );\n      return;\n    }\n    this.authenticationService.grLogin({ code: response.code }).subscribe(\n      data => {\n        this.googleSigningIn = false;\n        this.handleLoginResponse(data);\n      },\n      err => {\n        this.googleSigningIn = false;\n        this.notificationService.error(err);\n      },\n    );\n  }\n\n  private onGoogleSignInError(err: { type?: string }) {\n    this.googleSigningIn = false;\n    if (err?.type === 'popup_closed') {\n      this.notificationService.error('Google sign-in cancelled');\n    } else if (err?.type === 'popup_failed_to_open') {\n      this.notificationService.error('Could not open Google sign-in. Allow popups and try again.');\n    } else {\n      this.notificationService.error('Google sign-in failed');\n    }\n  }\n}\n","<section class=\"signin-section\">\n  \n  <div class=\"row login-main\">\n    <div class=\"signin-form\">\n      <div class=\"incident-logo\">\n        <img [src]=\"logoPath\" alt=\"Guardrail Logo\" class=\"login-logo\">\n      </div>\n\n        <!-- Sign-In Form -->\n        <div *ngIf=\"!otpFormDisplay\">\n          <!-- login text -->\n        <div>\n          <h1 class=\"login-head\">Login to your Account</h1>\n          <div class=\"sub-text\">See how servers are performing for your users</div>\n        </div>\n        <!-- Google Sign-In button -->\n        <button type=\"button\" class=\"google-signin-btn mt-3\" (click)=\"triggerGoogleSignIn()\" [disabled]=\"googleSigningIn\">\n          <mat-spinner *ngIf=\"googleSigningIn\" class=\"google-signin-btn__spinner\" [diameter]=\"20\"></mat-spinner>\n          <div class=\"google-icon-wrapper\" *ngIf=\"!googleSigningIn\">\n            <svg width=\"18\" height=\"18\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\">\n              <path fill=\"#EA4335\" d=\"M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z\"/>\n              <path fill=\"#4285F4\" d=\"M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z\"/>\n              <path fill=\"#FBBC05\" d=\"M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z\"/>\n              <path fill=\"#34A853\" d=\"M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z\"/>\n            </svg>\n          </div>\n          <span>{{ googleSigningIn ? 'Signing in...' : 'Sign in with Google' }}</span>\n        </button>\n\n        <div class=\"signin-text\">------------- or Sign in with Email ------------- </div>\n\n          <!-- sign in with email -->\n        <form [formGroup]=\"loginFormControl\" (ngSubmit)=\"loginSubmit()\">\n          <div class=\"mt-3\">\n            <div class=\"sub-text\">Email</div>\n            <mat-form-field appearance=\"outline\" class=\"bgwhite-input full-width\">\n              <input matInput type=\"text\" formControlName=\"emailid\" placeholder=\"mail@abc.com\" required>\n              <mat-error *ngIf=\"emailid.invalid\">{{getErrorMessage()}}</mat-error>\n            </mat-form-field>\n          </div>\n\n          <div class=\"mt-3\">\n            <div class=\"sub-text\">Password</div>\n            <mat-form-field appearance=\"outline\" class=\"bgwhite-input full-width\">\n              <input matInput type=\"password\" formControlName=\"userpassword\" placeholder=\"*****************\" required>\n            </mat-form-field>\n          </div>\n          <button mat-flat-button [disabled]=\"processing\" type=\"submit\"\n            class=\"full-width-btn login-btn\"><span class=\"login-text\">Login</span></button>\n        </form>\n      </div>\n\n      <div *ngIf=\"otpFormDisplay\" class=\"gr-otp-form\">\n        <p><strong>Verify it's you</strong></p>\n        <p>{{ destinationMessage }}</p>\n        <form [formGroup]=\"otpFormControl\">\n          <app-otp-input\n            formControlName=\"otp\"\n            [config]=\"{ length: 6, allowNumbersOnly: true, placeholder: '0', disableAutoFocus: false }\"\n            [hasError]=\"otpError\"\n            (otpComplete)=\"onOtpComplete($event)\"\n          ></app-otp-input>\n        </form>\n        <div class=\"gr-otp-actions\">\n          <span class=\"gr-resend-timer\" *ngIf=\"resendCooldown > 0\">Resend OTP in {{ resendCooldown }} sec</span>\n          <button\n            *ngIf=\"resendCooldown === 0\"\n            type=\"button\"\n            mat-button\n            class=\"resend-btn\"\n            (click)=\"resendOtp()\"\n            [disabled]=\"processing\"\n          >Resend OTP</button>\n        </div>\n        <button type=\"button\" mat-button class=\"otp-back-btn\" (click)=\"backFromOtp()\" [disabled]=\"processing\">\n          <mat-icon>arrow_back</mat-icon>\n          Back\n        </button>\n      </div>\n    </div>\n  </div>\n</section>\n","import { NgModule } from '@angular/core';\nimport { CommonModule } from '@angular/common';\nimport { LoginComponent } from './login.component';\nimport { OtpInputComponent } from './otp-input/otp-input.component';\nimport { MatFormFieldModule } from '@angular/material/form-field';\nimport { FormsModule, ReactiveFormsModule } from '@angular/forms';\nimport { MatInputModule } from '@angular/material/input';\nimport { MatCardModule } from '@angular/material/card';\nimport { MatButtonModule } from '@angular/material/button';\nimport { BrowserModule } from '@angular/platform-browser';\nimport { BrowserAnimationsModule } from '@angular/platform-browser/animations';\nimport { MatSnackBarModule } from '@angular/material/snack-bar';\nimport { MatProgressSpinnerModule } from '@angular/material/progress-spinner';\nimport { MatDialogModule } from '@angular/material/dialog';\nimport { MatIconModule } from '@angular/material/icon';\nimport { DirectivesModule } from '../shared/directives/directives.module';\n\n@NgModule({\n  declarations: [LoginComponent, OtpInputComponent],\n  imports: [\n    BrowserModule,\n    BrowserAnimationsModule,\n    CommonModule,\n    MatFormFieldModule,\n    FormsModule,\n    ReactiveFormsModule,\n    MatInputModule,\n    MatCardModule,\n    MatButtonModule,\n    MatSnackBarModule,\n    MatProgressSpinnerModule,\n    MatDialogModule,\n    MatIconModule,\n    DirectivesModule,\n  ]\n})\nexport class LoginModule { }\n","import {\n  AfterViewInit,\n  Component,\n  ElementRef,\n  EventEmitter,\n  forwardRef,\n  Input,\n  Output,\n  QueryList,\n  ViewChildren,\n} from '@angular/core';\nimport {\n  ControlValueAccessor,\n  FormControl,\n  FormGroup,\n  NG_VALUE_ACCESSOR,\n} from '@angular/forms';\n\nexport interface OtpInputConfig {\n  length?: number;\n  allowNumbersOnly?: boolean;\n  disableAutoFocus?: boolean;\n  placeholder?: string;\n  isPasswordInput?: boolean;\n}\n\n@Component({\n  selector: 'app-otp-input',\n  templateUrl: './otp-input.component.html',\n  styleUrls: ['./otp-input.component.scss'],\n  providers: [{\n    provide: NG_VALUE_ACCESSOR,\n    useExisting: forwardRef(() => OtpInputComponent),\n    multi: true,\n  }],\n})\nexport class OtpInputComponent implements AfterViewInit, ControlValueAccessor {\n  @ViewChildren('otpBox') otpBoxes!: QueryList<ElementRef<HTMLInputElement>>;\n\n  @Input() set config(value: OtpInputConfig) {\n    this._config = {\n      length: 6,\n      allowNumbersOnly: true,\n      disableAutoFocus: false,\n      placeholder: '0',\n      ...value,\n    };\n    this.buildForm();\n  }\n  get config(): OtpInputConfig {\n    return this._config;\n  }\n\n  @Input() hasError = false;\n  @Output() otpComplete = new EventEmitter<string>();\n\n  private _config: OtpInputConfig = {\n    length: 6,\n    allowNumbersOnly: true,\n    disableAutoFocus: false,\n    placeholder: '0',\n  };\n\n  otpForm = new FormGroup({});\n  controlKeys: string[] = [];\n  private currentVal = '';\n  private onChange: (value: string) => void = () => {};\n  private onTouched: () => void = () => {};\n  private completeEmittedFor = '';\n\n  get inputType(): string {\n    if (this._config.isPasswordInput) return 'password';\n    return this._config.allowNumbersOnly ? 'tel' : 'text';\n  }\n\n  get inputMode(): string {\n    return this._config.allowNumbersOnly ? 'numeric' : 'text';\n  }\n\n  constructor() {\n    this.buildForm();\n  }\n\n  ngAfterViewInit(): void {\n    if (!this._config.disableAutoFocus) {\n      setTimeout(() => this.focusIndex(0), 50);\n    }\n  }\n\n  writeValue(value: string | null): void {\n    this.setValue(value, false);\n  }\n\n  registerOnChange(fn: (value: string) => void): void {\n    this.onChange = fn;\n  }\n\n  registerOnTouched(fn: () => void): void {\n    this.onTouched = fn;\n  }\n\n  setDisabledState(isDisabled: boolean): void {\n    if (isDisabled) {\n      this.otpForm.disable({ emitEvent: false });\n    } else {\n      this.otpForm.enable({ emitEvent: false });\n    }\n  }\n\n  onKeyDown(event: KeyboardEvent, index: number): void {\n    const key = event.key;\n    const len = this._config.length;\n\n    if (key === ' ') {\n      event.preventDefault();\n      return;\n    }\n\n    if (key === 'Backspace' || key === 'Delete') {\n      const hasValue = !!this.otpForm.get(this.controlName(index))?.value;\n      if (!hasValue && index > 0) {\n        this.clearIndex(index - 1);\n        this.focusIndex(index - 1);\n      } else {\n        this.clearIndex(index);\n      }\n      this.rebuildValue();\n      event.preventDefault();\n      return;\n    }\n\n    if (key === 'ArrowLeft') {\n      event.preventDefault();\n      if (index > 0) this.focusIndex(index - 1);\n      return;\n    }\n\n    if (key === 'ArrowRight') {\n      event.preventDefault();\n      if (index < len - 1) this.focusIndex(index + 1);\n      return;\n    }\n\n    // Full OTP — block further digit entry until backspace\n    if (this.currentVal.length >= len && /^[0-9a-zA-Z]$/.test(key)) {\n      event.preventDefault();\n      this.focusIndex(len - 1);\n    }\n  }\n\n  onInput(event: Event, index: number): void {\n    const input = event.target as HTMLInputElement;\n    const len = this._config.length;\n    const cleaned = this.sanitize(input.value || '');\n\n    if (!cleaned) {\n      this.clearIndex(index);\n      this.rebuildValue();\n      return;\n    }\n\n    // Full already — restore current box, ignore extra digits\n    if (this.currentVal.length >= len) {\n      input.value = this.otpForm.get(this.controlName(index))?.value || '';\n      this.focusIndex(len - 1);\n      return;\n    }\n\n    // Paste / autofill into incomplete OTP\n    if (cleaned.length > 1) {\n      this.setValue(cleaned.slice(0, len));\n      return;\n    }\n\n    this.otpForm.get(this.controlName(index))?.setValue(cleaned, { emitEvent: false });\n    input.value = cleaned;\n    this.rebuildValue();\n\n    if (index < len - 1) {\n      this.focusIndex(index + 1);\n    } else {\n      this.focusIndex(len - 1);\n    }\n  }\n\n  onPaste(event: ClipboardEvent): void {\n    event.preventDefault();\n    event.stopPropagation();\n    if (this.otpForm.disabled) return;\n\n    const cleaned = this.sanitize(event.clipboardData?.getData('text') || '');\n    if (!cleaned) return;\n    this.setValue(cleaned.slice(0, this._config.length));\n  }\n\n  onFocus(): void {\n    this.onTouched();\n  }\n\n  clear(focus = false): void {\n    this.completeEmittedFor = '';\n    this.setValue('', false, focus);\n  }\n\n  focusLast(): void {\n    this.focusIndex(this._config.length - 1);\n  }\n\n  setValue(value: string | null, emitComplete = true, allowAutoFocus = true): void {\n    this.otpForm.reset({}, { emitEvent: false });\n    if (value == null || String(value).trim() === '') {\n      this.syncDom();\n      this.rebuildValue(emitComplete);\n      if (allowAutoFocus && !this._config.disableAutoFocus) this.focusIndex(0);\n      return;\n    }\n\n    const cleaned = this.sanitize(String(value)).slice(0, this._config.length);\n    Array.from(cleaned).forEach((c, i) => {\n      this.otpForm.get(this.controlName(i))?.setValue(c, { emitEvent: false });\n    });\n    this.syncDom();\n    this.rebuildValue(emitComplete);\n\n    if (allowAutoFocus && !this._config.disableAutoFocus) {\n      const focusAt = Math.min(Math.max(cleaned.length - 1, 0), this._config.length - 1);\n      setTimeout(() => this.focusIndex(focusAt), 0);\n    }\n  }\n\n  private buildForm(): void {\n    this.otpForm = new FormGroup({});\n    this.controlKeys = [];\n    for (let i = 0; i < this._config.length; i++) {\n      const name = this.controlName(i);\n      this.controlKeys.push(name);\n      this.otpForm.addControl(name, new FormControl(''));\n    }\n  }\n\n  private controlName(index: number): string {\n    return `ctrl_${index}`;\n  }\n\n  private sanitize(value: string): string {\n    return this._config.allowNumbersOnly\n      ? value.replace(/\\D/g, '')\n      : value.replace(/[^a-zA-Z0-9]/g, '');\n  }\n\n  private clearIndex(index: number): void {\n    this.otpForm.get(this.controlName(index))?.setValue('', { emitEvent: false });\n    const el = this.otpBoxes?.get(index)?.nativeElement;\n    if (el) el.value = '';\n  }\n\n  private syncDom(): void {\n    this.otpBoxes?.forEach((box, i) => {\n      box.nativeElement.value = this.otpForm.get(this.controlName(i))?.value || '';\n    });\n  }\n\n  private focusIndex(index: number): void {\n    const el = this.otpBoxes?.get(index)?.nativeElement;\n    if (!el) return;\n    el.focus();\n    el.select();\n  }\n\n  private rebuildValue(emitComplete = true): void {\n    let val = '';\n    for (let i = 0; i < this._config.length; i++) {\n      const ctrlVal = this.otpForm.get(this.controlName(i))?.value;\n      if (ctrlVal) val += String(ctrlVal)[0];\n    }\n    if (this.currentVal !== val) {\n      this.currentVal = val;\n      this.onChange(val);\n    }\n\n    if (emitComplete && val.length === this._config.length && this.completeEmittedFor !== val) {\n      this.completeEmittedFor = val;\n      this.otpComplete.emit(val);\n    }\n\n    if (val.length < this._config.length) {\n      this.completeEmittedFor = '';\n    }\n  }\n}\n","<div\n  class=\"otp-input\"\n  [class.otp-input--error]=\"hasError\"\n  [formGroup]=\"otpForm\"\n  (paste)=\"onPaste($event)\"\n>\n  <input\n    #otpBox\n    *ngFor=\"let key of controlKeys; let i = index\"\n    class=\"otp-input__box\"\n    [attr.id]=\"'otp_' + i\"\n    [type]=\"inputType\"\n    [attr.inputmode]=\"inputMode\"\n    maxlength=\"1\"\n    autocomplete=\"one-time-code\"\n    [placeholder]=\"config.placeholder || '0'\"\n    [formControlName]=\"key\"\n    (keydown)=\"onKeyDown($event, i)\"\n    (input)=\"onInput($event, i)\"\n    (focus)=\"onFocus()\"\n  />\n</div>\n","const REQ_ID = 'GR_OTP_REQ_ID';\nconst MOBILE = 'GR_OTP_MOBILE';\nconst EMAIL = 'GR_OTP_EMAIL';\n\nexport interface OtpSession {\n  req_id: string;\n  mobile: string;\n  email: string;\n}\n\nexport function setOtpSession(data: { req_id: string; mobile?: string; email?: string }): void {\n  sessionStorage.setItem(REQ_ID, data.req_id);\n  sessionStorage.setItem(MOBILE, data.mobile || '');\n  sessionStorage.setItem(EMAIL, data.email || '');\n}\n\nexport function getOtpSession(): OtpSession | null {\n  const req_id = sessionStorage.getItem(REQ_ID);\n  if (!req_id) return null;\n  return {\n    req_id,\n    mobile: sessionStorage.getItem(MOBILE) || '',\n    email: sessionStorage.getItem(EMAIL) || '',\n  };\n}\n\nexport function clearOtpSession(): void {\n  sessionStorage.removeItem(REQ_ID);\n  sessionStorage.removeItem(MOBILE);\n  sessionStorage.removeItem(EMAIL);\n}\n\nexport function otpDestinationMessage(mobile: string, email: string): string {\n  if (mobile && email) {\n    return `We sent a verification code to ${mobile} and ${email}. Enter the code below.`;\n  }\n  if (mobile) {\n    return `We sent a verification code to ${mobile}. Enter the code below.`;\n  }\n  if (email) {\n    return `We sent a verification code to ${email}. Enter the code below.`;\n  }\n  return 'We sent a verification code. Enter the code below.';\n}\n","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n    name: 'currencyInr'\n})\n\nexport class CurrencyInrPipe implements PipeTransform {\n    transform(value: number) {\n        if (typeof value != 'number') {\n            return value;\n        }\n        return value.toLocaleString('en-IN',{ style: 'currency', currency: \"INR\",minimumFractionDigits:2,maximumFractionDigits:2 });\n    }\n\n\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n    name: 'KbToGb'\n})\n\nexport class KbToGbPipe implements PipeTransform {\n    transform(value: number) {\n        if (typeof value != 'number') {\n            return value;\n        }\n        return (value / (1024 * 1024)).toFixed(3);\n    }\n\n\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n\tname: 'lakhCrore'\n})\n\n\nexport class LakhCrore implements PipeTransform {\n\ttransform(value: number): string {\n\t\tif (value >= 1000) {\n\t\t\tvar sizevalueue = [1000, 100000, 10000000];\n\t\t\tvar abbrev = [\" k\", \" lakh\", \" Cr\"];\n\t\t\tfor (var i = abbrev.length - 1; i >= 0; i--) {\n\t\t\t\tif (sizevalueue[i] <= value) {\n\t\t\t\t\tvalue = Math.round(value * 100 / sizevalueue[i]) / 100;\n\t\t\t\t\tif ((value == 1000) && (i < abbrev.length - 1)) {\n\t\t\t\t\t\tvalue = 1;\n\t\t\t\t\t\ti++;\n\t\t\t\t\t}\n\t\t\t\t\tvar stringvalueue = value + abbrev[i];\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\treturn stringvalueue;\n\t\t}\n\t\telse\n\t\t\treturn value.toString();\n\t}\n}\n","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n  name: 'maskString'\n})\nexport class MaskStringPipe implements PipeTransform {\n\n  transform(value: string, unmaskStart: number = 3, unmaskEnd: number = 3, maskChar: string = '*'): string {\n    if (!value || value.length <= (unmaskStart + unmaskEnd)) {\n      return value; // No need to mask if the string length is less than or equal to the sum of unmasked parts\n    }\n\n    const start = value.slice(0, unmaskStart);\n    const end = value.slice(-unmaskEnd);\n    const middleSection = maskChar.repeat(value.length - (unmaskStart + unmaskEnd));\n\n    return `${start}${middleSection}${end}`;\n  }\n}\n","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n    name: 'underscoreCapitalCheck'\n})\n\nexport class underScoreCapitalPipe implements PipeTransform {\n    transform(value: string) {\n        if (typeof value != 'string') {\n            return value;\n        }\n        else{\n            const words = value.split(\"_\");\n            for (let i = 0; i < words.length; i++) {\n                words[i] = words[i][0].toUpperCase() + words[i].substr(1);\n            }\n            let word=words.join(\" \")\n            return word.replace(/[_]/g, \" \");\n        }\n    \n    }\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n    name: 'noUnderscoreString'\n})\n\nexport class NoUnderscoreStringPipe implements PipeTransform {\n    transform(value: string) {\n        if (typeof value != 'string') {\n            return value;\n        }\n        return value.replace(/[-_]/g, \" \");\n    }\n\n\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n    name: 'noUnderscoreAllCapitalCheck'\n})\n\nexport class noUnderScoreAllCapitalPipe implements PipeTransform {\n    transform(value: string) {\n        if (typeof value != 'string') {\n            return value;\n        }\n        else{\n            const words = value.replace(/[-_]/g, \" \");\n            return words.toUpperCase()\n        }\n    \n    }\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n  name: 'objectKeys',\n  pure: false\n})\n\nexport class ObjectKeysPipe implements PipeTransform {\n\ttransform(value) : any {\n      let keys = [];\n      if(typeof(value) == 'string') \n        return keys;\n      for (let key in value) {\n        keys.push(key);\n      }\n      return keys;\n    }\n}","import { NgModule } from '@angular/core';\n\nimport { TruncatePipe } from './truncate.pipe';\nimport { ObjectKeysPipe } from './objectKeys.pipe';\nimport { NoUnderscoreStringPipe } from './noUnderscore.pipe';\nimport { StrngToArrPipe } from './strngToArr.pipe';\nimport { FileSizePipe } from './size.pipe';\nimport { CurrencyInrPipe } from './currencyInr.pipe';\nimport {underScoreCapitalPipe} from './noUnderScoreCapital.pipe'\nimport {noUnderScoreAllCapitalPipe} from './noUnderscoreAllCapital.pipe'\nimport {KbToGbPipe} from './kbToGb.pipe'\nimport {secToMinHrPipe} from './secToMinHr.pipe'\nimport { LakhCrore } from './lakhCrore.pipe'\nimport {MaskStringPipe} from './maskString.pipe'\n\n@NgModule({\n  imports: [],\n  declarations: [\n    TruncatePipe,\n    ObjectKeysPipe,\n    NoUnderscoreStringPipe,\n    StrngToArrPipe, \n    FileSizePipe,\n    CurrencyInrPipe,\n    underScoreCapitalPipe,\n    noUnderScoreAllCapitalPipe,\n    KbToGbPipe,\n    secToMinHrPipe,\n    LakhCrore,\n    MaskStringPipe\n   ],\n  exports: [\n    TruncatePipe,\n    ObjectKeysPipe,\n    ObjectKeysPipe,\n    NoUnderscoreStringPipe,\n    StrngToArrPipe,\n    FileSizePipe,\n    CurrencyInrPipe,\n    underScoreCapitalPipe,\n    noUnderScoreAllCapitalPipe,\n    KbToGbPipe,\n    secToMinHrPipe,\n    LakhCrore,\n    MaskStringPipe\n   ]\n})\n\nexport class PipesModule { }","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n    name: 'secToMinHr'\n})\n\nexport class secToMinHrPipe implements PipeTransform {\n    transform(value: number) {\n        if (typeof value != 'number') {\n            return value;\n        }\n        else{\n            let conversion;\n            if(value>=3600){\n                let hr=Math.floor(value/3600)\n                let min=value % 3600\n                return String(hr)+ \".\" +String(min) + \" hr\" \n            }\n            else if(value>=60){\n                let min=Math.floor(value/60)\n                let sec=value % 60\n                return String(min)+ \".\" +String(sec) + \" mins\"\n            }\n            else{\n                return String(value) + \" sec\"\n            }\n        }\n    }\n\n\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n    name: 'fileSize'\n})\nexport class FileSizePipe implements PipeTransform {\n    private units = ['bytes', 'KB', 'MB', 'GB', 'TB', 'PB'];\n\n    transform(bytes: number = 0, precision: number = 2): string {\n        // tslint:disable-next-line:curly\n        if (isNaN(parseFloat(String(bytes))) || !isFinite(bytes)) return '?';\n\n        let unit = 0;\n\n        while (bytes >= 1000) {\n            bytes /= 1000;\n            unit++;\n        }\n\n        return bytes.toFixed(+precision) + ' ' + this.units[unit];\n    }\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n  name: 'strngToArr',\n  pure: false\n})\n\nexport class StrngToArrPipe implements PipeTransform {\n\ttransform(value) : any {\n        let arr = [];\n        if(value)\n            arr = value.split(','); \n        return arr;\n    }\n}","import { Pipe, PipeTransform } from '@angular/core';\n\n@Pipe({\n  name: 'truncate'\n})\n\n\nexport class TruncatePipe implements PipeTransform {\n\ttransform(value: string, limit: number, trailDots: boolean = false): string {\n\t\tif(!value) return;\n\t\tif (!limit || limit < 1) return value;\n\t\tif (trailDots)\n\t\t\treturn value.length > limit ? value.substring(0, limit).trim() + '...' : value;\n\t\treturn value.length > limit ? value.substring(0, limit).trim() : value;\n\t}\n}\n","import { ESCAPE } from '@angular/cdk/keycodes';\nimport { OverlayRef } from '@angular/cdk/overlay';\nimport { Subject, Subscription } from 'rxjs';\nimport { filter } from 'rxjs/operators';\nimport { PopoverCloseEvent, PopoverContent } from './interface';\n\nexport class PopoverRef<T = any> {\n  private afterClosed = new Subject<PopoverCloseEvent<T>>();\n  private actionPerformed = new Subject<any>();\n  private closed = false;\n  private escapeSub: Subscription;\n\n  afterClosed$ = this.afterClosed.asObservable();\n  actionPerformed$ = this.actionPerformed.asObservable();\n\n  constructor(\n    public overlay: OverlayRef,\n    public content: PopoverContent,\n    public data: T,\n  ) {\n    overlay.backdropClick().subscribe(() => {\n      this._close('backdropClick', null);\n    });\n\n    this.escapeSub = overlay\n      .keydownEvents()\n      .pipe(filter((event: KeyboardEvent) => event.keyCode === ESCAPE))\n      .subscribe(() => this.close());\n  }\n\n  action(data: T) {\n    this.actionPerformed.next(data);\n    this.actionPerformed.complete();\n  }\n\n  close(data?: T) {\n    this._close('close', data);\n  }\n\n  private _close(type: PopoverCloseEvent['type'], data?: T) {\n    if (this.closed) {\n      return;\n    }\n    this.closed = true;\n    this.escapeSub.unsubscribe();\n    this.overlay.dispose();\n    this.afterClosed.next({\n      type,\n      data,\n    });\n    this.afterClosed.complete();\n  }\n}\n","import { Component, OnInit, TemplateRef } from '@angular/core';\nimport { PopoverRef } from './popover-ref';\nimport { PopoverContent } from \"./interface\";\n\n@Component({\n  templateUrl: './popover.component.html',\n  styleUrls: ['./popover.component.scss']\n})\nexport class PopoverComponent implements OnInit {\n  renderMethod: 'template' | 'component' | 'text' = 'component';\n  content: PopoverContent;\n  context;\n\n  constructor(private popoverRef: PopoverRef) {\n  }\n\n  ngOnInit() {\n    this.content = this.popoverRef.content;\n\n    if (typeof this.content === 'string') {\n      this.renderMethod = 'text';\n    }\n\n    if (this.content instanceof TemplateRef) {\n      this.renderMethod = 'template';\n      this.context = {\n        close: this.popoverRef.close.bind(this.popoverRef)\n      }\n    }\n\n  }\n}","<div class=\"popover\">\n\t<ng-container [ngSwitch]=\"renderMethod\">\n\t\t<div *ngSwitchCase=\"'text'\" [innerHTML]=\"content\"></div>\n\t\t<ng-container *ngSwitchCase=\"'template'\">\n\t\t\t<ng-container *ngTemplateOutlet=\"content; context: context\"></ng-container>\n\t\t</ng-container>\n\t\t<ng-container *ngSwitchCase=\"'component'\">\n\t\t\t<ng-container *ngComponentOutlet=\"content\"></ng-container>\n\t\t</ng-container>\n\t</ng-container>\n</div>","import { Component, OnInit, OnDestroy, ElementRef, HostListener } from '@angular/core';\nimport { Router } from '@angular/router';\nimport { MatDialog } from '@angular/material/dialog';\nimport { Subject } from 'rxjs';\nimport { takeUntil } from 'rxjs/operators';\n\nimport { LocalStorageService } from 'src/app/_services/utility/localstorage.service';\nimport { ThemeService, Theme } from 'src/app/_services/utility/theme.service';\nimport { FeedbackModalComponent } from '../feedback-modal/feedback-modal.component';\nimport { USER_INFO, ACCOUNT_INFO } from 'src/constants/local.storage';\nimport { HeaderPanelService } from 'src/app/_services/utility/header-panel.service';\n\n@Component({\n  selector: 'app-account-menu',\n  templateUrl: './account-menu.component.html',\n  styleUrls: ['./account-menu.component.scss'],\n  providers: [LocalStorageService]\n})\nexport class AccountMenuComponent implements OnInit, OnDestroy {\n\n  userInfo: any = {};\n  selectedAccount: any = {};\n  accountInfo: any = [];\n\n  isOpen = false;\n\n  currentTheme: Theme = 'system';\n  private destroy$ = new Subject<void>();\n  private readonly panelId = 'account-menu';\n\n  constructor(\n    private router: Router,\n    private dialog: MatDialog,\n    private lsService: LocalStorageService,\n    private themeService: ThemeService,\n    private headerPanelService: HeaderPanelService,\n    private elRef: ElementRef\n  ) {\n    this.selectedAccount = this.lsService.getSelectedAccount();\n    this.accountInfo = JSON.parse(localStorage.getItem(ACCOUNT_INFO)) || [];\n  }\n\n  ngOnInit(): void {\n    this.loadUserInfo();\n    this.themeService.theme$\n      .pipe(takeUntil(this.destroy$))\n      .subscribe(theme => { this.currentTheme = theme; });\n    this.headerPanelService.close$\n      .pipe(takeUntil(this.destroy$))\n      .subscribe((exceptPanelId) => {\n        if (exceptPanelId !== this.panelId) {\n          this.isOpen = false;\n        }\n      });\n  }\n\n  ngOnDestroy(): void {\n    this.destroy$.next();\n    this.destroy$.complete();\n  }\n\n  // ── Outside-click / Escape ──────────────────────────────────────────────────\n\n  @HostListener('document:click', ['$event'])\n  onDocumentClick(event: MouseEvent): void {\n    if (!this.elRef.nativeElement.contains(event.target as Node)) {\n      this.isOpen = false;\n    }\n  }\n\n  @HostListener('document:keydown.escape')\n  onEscape(): void {\n    this.headerPanelService.requestClose();\n  }\n\n  // ── Dropdown open/close ─────────────────────────────────────────────────────\n\n  toggle(event: MouseEvent): void {\n    event.stopPropagation();\n    this.headerPanelService.requestClose(this.panelId);\n    this.isOpen = !this.isOpen;\n  }\n\n  // ── User info ───────────────────────────────────────────────────────────────\n\n  loadUserInfo(): void {\n    const raw = localStorage.getItem(USER_INFO);\n    if (raw) {\n      try {\n        this.userInfo = JSON.parse(raw);\n        if (!this.userInfo.displayName && this.userInfo.fullname) {\n          this.userInfo.displayName = this.userInfo.fullname;\n        }\n      } catch {\n        this.userInfo = {};\n      }\n    }\n  }\n\n  // ── Navigation / account actions ────────────────────────────────────────────\n\n  redirectToAccount(): void {\n    this.router.navigateByUrl('/dashboard/profile/my-profile');\n  }\n\n  onLogout(): void {\n    localStorage.clear();\n    sessionStorage.clear();\n    localStorage.setItem('SELECTED_ACCOUNT_NAME', this.selectedAccount.account_name);\n    this.router.navigateByUrl('/login');\n  }\n\n  // ── Theme ───────────────────────────────────────────────────────────────────\n\n  setTheme(theme: Theme): void {\n    this.themeService.setTheme(theme);\n  }\n\n  isThemeActive(theme: Theme): boolean {\n    return this.currentTheme === theme;\n  }\n\n  // ── Feedback ────────────────────────────────────────────────────────────────\n\n  openFeedback(): void {\n    this.isOpen = false;\n    this.dialog.open(FeedbackModalComponent, {\n      width: '500px',\n      maxWidth: '90vw',\n      panelClass: 'feedback-modal-dialog',\n      autoFocus: false,\n      restoreFocus: true\n    });\n  }\n}\n","<div class=\"account-wrapper\">\n  <button\n    class=\"account-trigger\"\n    [class.account-trigger--active]=\"isOpen\"\n    (click)=\"toggle($event)\"\n    matTooltip=\"Account\"\n    matTooltipPosition=\"below\"\n    aria-label=\"Account menu\"\n    [attr.aria-expanded]=\"isOpen\"\n    aria-haspopup=\"true\"\n    type=\"button\"\n  >\n    <div class=\"account-avatar-wrapper\">\n      <avatar [userInfo]=\"userInfo\" [showTooltip]=\"false\"></avatar>\n    </div>\n    <mat-icon class=\"account-arrow\">keyboard_arrow_down</mat-icon>\n  </button>\n\n  <!-- Account Dropdown -->\n  <div\n    class=\"account-dropdown\"\n    [class.account-dropdown--open]=\"isOpen\"\n    role=\"menu\"\n    (click)=\"$event.stopPropagation()\"\n  >\n    <!-- User Info — navigates to profile -->\n    <div\n      class=\"account-dropdown__user-info\"\n      (click)=\"redirectToAccount()\"\n      role=\"button\"\n      tabindex=\"0\"\n      (keydown.enter)=\"redirectToAccount()\"\n      (keydown.space)=\"redirectToAccount()\"\n    >\n      <div class=\"account-dropdown__user-avatar\">\n        <avatar [userInfo]=\"userInfo\" [showTooltip]=\"false\"></avatar>\n      </div>\n      <div class=\"account-dropdown__user-details\">\n        <div class=\"account-dropdown__user-name\">\n          {{ userInfo?.displayName || userInfo?.fullname || \"User\" }}\n        </div>\n        <div class=\"account-dropdown__user-email\">\n          {{ userInfo?.email || \"\" }}\n        </div>\n      </div>\n    </div>\n\n    <div class=\"account-dropdown__divider\"></div>\n\n    <!-- Theme Section -->\n    <div class=\"account-dropdown__section-title\">Theme</div>\n\n    <div class=\"theme-buttons\">\n      <button\n        class=\"theme-btn\"\n        [class.theme-btn--active]=\"isThemeActive('light')\"\n        type=\"button\"\n        matTooltip=\"Light\"\n        matTooltipPosition=\"below\"\n        (click)=\"setTheme('light')\"\n        aria-label=\"Light theme\"\n      >\n        <mat-icon>wb_sunny</mat-icon>\n      </button>\n\n      <button\n        class=\"theme-btn\"\n        [class.theme-btn--active]=\"isThemeActive('system')\"\n        type=\"button\"\n        matTooltip=\"System\"\n        matTooltipPosition=\"below\"\n        (click)=\"setTheme('system')\"\n        aria-label=\"System theme\"\n      >\n        <mat-icon>computer</mat-icon>\n      </button>\n\n      <button\n        class=\"theme-btn\"\n        [class.theme-btn--active]=\"isThemeActive('dark')\"\n        type=\"button\"\n        matTooltip=\"Dark\"\n        matTooltipPosition=\"below\"\n        (click)=\"setTheme('dark')\"\n        aria-label=\"Dark theme\"\n      >\n        <mat-icon>nightlight_round</mat-icon>\n      </button>\n    </div>\n\n    <div class=\"account-dropdown__divider\"></div>\n\n    <!-- Send Feedback -->\n    <button\n      class=\"account-dropdown__item\"\n      role=\"menuitem\"\n      type=\"button\"\n      (click)=\"openFeedback()\"\n    >\n      <mat-icon class=\"account-dropdown__item-icon\">feedback</mat-icon>\n      Send Feedback\n    </button>\n\n    <div class=\"account-dropdown__divider\"></div>\n\n    <button\n      class=\"account-dropdown__item account-dropdown__item--logout\"\n      role=\"menuitem\"\n      type=\"button\"\n      (click)=\"onLogout()\"\n    >\n      <mat-icon class=\"account-dropdown__item-icon\">logout</mat-icon>\n      Log Out\n    </button>\n  </div>\n</div>\n","import { Component, Input, OnChanges, SimpleChanges, ChangeDetectionStrategy, ChangeDetectorRef } from '@angular/core';\n\n@Component({\n  selector: 'avatar',\n  templateUrl: './avatar.component.html',\n  styleUrls: ['./avatar.component.scss'],\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class AvatarComponent implements OnChanges {\n\n  @Input() userInfo : any = {}; \n  @Input() size : any = 'large';\n  @Input() showTooltip : boolean = true; // New input - true by default\n  initial : any = 'A';\n  @Input() userName : any;\n  tooltipName: string = '';\n  hasImage: boolean = false;\n  imageUrl: string = '';\n  imageLoadError: boolean = false;\n\n  constructor(private cdr: ChangeDetectorRef) { \n  }\n  \n  ngOnChanges(changes: SimpleChanges): void {\n    if (changes['userInfo'] || changes['userName']) {\n      this.imageLoadError = false;\n      this.updateAvatar();\n    }\n  }\n\n  private updateAvatar(): void {\n    const displayName = this.resolveDisplayName();\n    const imageUrl = this.resolveImageUrl();\n\n    this.hasImage = !!imageUrl;\n    if (this.hasImage) {\n      this.imageUrl = imageUrl;\n      this.tooltipName = displayName || 'User';\n      this.cdr.markForCheck();\n      return;\n    }\n\n    this.createAvatar(displayName || this.userName || 'User');\n    this.cdr.markForCheck();\n  }\n\n  private resolveDisplayName(): string {\n    if (typeof this.userInfo === 'string') {\n      return this.userInfo.trim();\n    }\n\n    if (this.userInfo && typeof this.userInfo === 'object') {\n      return (\n        this.userInfo.name ||\n        this.userInfo.displayName ||\n        this.userInfo.fullname ||\n        ''\n      ).trim();\n    }\n\n    return '';\n  }\n\n  private resolveImageUrl(): string {\n    if (!this.userInfo || typeof this.userInfo === 'string') {\n      return '';\n    }\n\n    return this.userInfo.avatar || this.userInfo.image || this.userInfo.user_image || '';\n  }\n\n  public createAvatar(username: any): void {\n    const name = (typeof username === 'string' ? username : '') || 'Unassigned';\n    this.tooltipName = name;\n\n    const matches = name.match(/\\b(\\w)/g);\n    this.initial = matches ? matches.slice(0, 2).join('') : name.charAt(0).toUpperCase();\n  }\n\n  onImageError(): void {\n    this.imageLoadError = true;\n    this.hasImage = false;\n    this.createAvatar(this.resolveDisplayName() || this.userName || 'User');\n    this.cdr.markForCheck();\n  }\n\n}\n","<span *ngIf=\"!hasImage && !userName\" [matTooltip]=\"showTooltip ? tooltipName : ''\" class=\"user-icon-{{size}}\">\n    {{initial || 'U'}}\n</span>\n<span class=\"square-icon\" *ngIf=\"userName && !hasImage\">{{initial || 'U'}}</span>\n<img *ngIf=\"hasImage && !imageLoadError && imageUrl\" \n     class=\"user-icon-{{size}}\" \n     width=\"100%\" \n     [matTooltip]=\"showTooltip ? tooltipName : ''\"\n     [src]=\"imageUrl\" \n     (error)=\"onImageError()\"\n     alt=\"{{tooltipName}}\"\n     referrerpolicy=\"no-referrer\" />\n\n","import { Component, Inject, EventEmitter } from '@angular/core';\nimport { MatDialogRef, MAT_DIALOG_DATA } from '@angular/material/dialog';\nimport { CommonService } from '../../_services/all-requests/common.service';\nimport { LocalStorageService } from '../../_services/utility/localstorage.service';\n\nexport interface DialogData {\n  title: string;\n  heading: string;\n  validateRegex? : any;\n  errorMessage?: string;\n  validationMessage?: string;\n  showProjects?:boolean;\n}\n\n@Component({\n  selector: 'comment-dialog',\n  templateUrl: './comment-dialog.component.html',\n  styleUrls: ['./comment-dialog.component.scss'],\n  providers:[CommonService,LocalStorageService]\n})\nexport class CommentDialogComponent{\n\n  spinBtn : boolean = false;\n  confirmAction = new EventEmitter<any>();\n  myComment : any;\n  isValid = false;\n  showError : boolean = false;\n  projectList:any;\n  account_id:any=null;\n  loader : any ={\n    project: false\n  }\n  projectId:any;\n\n  constructor( public dialogRef: MatDialogRef<CommentDialogComponent>,\n    @Inject(MAT_DIALOG_DATA) public data: DialogData, private commonService:CommonService,\n    private lsService:LocalStorageService) {\n        // get selected account\n    let selectedAccount = this.lsService.getSelectedAccount();\n    this.account_id = selectedAccount.account_id;\n    if(data.showProjects){\n      this.getProjectsList();\n    }\n   \n     }\n\n  onCommentChange(value: string): void {\n    this.myComment = value;\n    if (!value) {\n      this.isValid = false;\n      this.showError = false;\n      return;\n    }\n    this.isValid = this.data?.validateRegex ? this.data.validateRegex.test(value) : true;\n    this.showError = !!this.data?.validateRegex && !this.isValid;\n  }\n\n  add() {\n    this.showError = false;\n    let params;\n    if(this.data.showProjects){\n      params={\n        myComment:this.myComment,\n        project_id:this.projectId\n      }\n    }\n    \n    if(this.data && this.data.validateRegex && this.data.validateRegex['test']) {\n      if(this.data.validateRegex.test(this.myComment)) {\n        this.spinBtn = true;\n        if(this.data.showProjects){\n          this.confirmAction.emit(params);\n        }\n        else{\n          this.confirmAction.emit(this.myComment);\n        }\n        \n      } \n      else {\n        this.showError = true;\n      }\n    } \n    else {\n      this.spinBtn = true;\n      if(this.data.showProjects){\n        this.confirmAction.emit(params);\n      }\n      else{\n        this.confirmAction.emit(this.myComment);\n      }\n    }\n    \n  }\n\n  getProjectsList(){\n    this.loader['project'] = true;\n    let params = {\n      account_id : this.account_id\n    }\n    this.commonService.getProjects(params).subscribe(result =>{\n      if(result && result.status){\n        if(result.data && result.data[this.account_id]){\n          this.projectList = result.data[this.account_id]['project_list'];\n        }\n      }\n      this.loader['project'] = false;\n    },error => {\n      this.loader['project'] = false;\n    });\n  }\n\n  onNoClick(){\n    this.showError = false;\n    this.dialogRef.close();\n  }\n\n}\n","<div mat-dialog-title>\n    <mat-icon class=\"close\" (click)=\"onNoClick()\" title=\"Close\">close</mat-icon>\n    <h4>{{data.title}}</h4>\n\n</div>\n\n<div mat-dialog-content>\n    <div class=\"modal-content\">\n        <div class=\"create-section-row\">\n            <div class=\"create-main-title\">\n                <h1>{{data.heading}}<span class=\"clr-red\">*</span></h1>\n            </div>\n            <mat-form-field appearance=\"outline\" class=\"bgwhite-input full-width\">\n                <input *ngIf=\"!data?.validateRegex\" matInput placeholder=\"Here...\" [ngModel]=\"myComment\" (ngModelChange)=\"onCommentChange($event)\">\n                <input *ngIf=\"data?.validateRegex\" matInput placeholder=\"Here...\" noLeadingSpaceOff\n                    [ngModel]=\"myComment\" (ngModelChange)=\"onCommentChange($event)\">\n            </mat-form-field>\n\n          \n\n                  <div class=\"create-section-row\" *ngIf=\"data?.showProjects\">\n                        <div class=\"create-main-title\">\n                            <h1>Select Project&nbsp;<span>*</span></h1>\n                            \n                        </div>\n                        <div class=\"load-spinner\" *ngIf=\"loader.project\"><mat-spinner [diameter]=\"30\" ></mat-spinner></div>\n                        <mat-form-field *ngIf=\"!loader.project\" appearance=\"outline\" class=\"select-filter bgwhite-select full-width\">\n                            <mat-label>Select Project {{projectId}}</mat-label>\n                            <mat-select [(ngModel)]=\"projectId\">\n                              <mat-option *ngFor=\"let item of projectList\" [value]=\"item.id\">{{item.name}}</mat-option>\n                            </mat-select>\n                        </mat-form-field>\n                    </div>\n\n            <div *ngIf=\"showError && data?.validationMessage\" class=\"error-color\">*{{data.validationMessage}}</div>\n            <div *ngIf=\"data?.errorMessage\" class=\"error-color\">*{{data.errorMessage}}</div>\n        </div>\n    </div>\n</div>\n\n<div mat-dialog-actions>\n    <button class=\"actions-btns cancel\" mat-flat-button (click)=\"onNoClick()\"> Cancel </button>\n   \n\n    <button  [disabled]=\"spinBtn || !isValid || (data?.showProjects && !projectId)\" mat-flat-bu