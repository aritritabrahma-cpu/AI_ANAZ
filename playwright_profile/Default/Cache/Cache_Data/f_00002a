" appearance=\"outline\"\n                                class=\"select-filter kvm-host-select bgwhite-select full-width\">\n                                <mat-label>Select KVM Host</mat-label>                           \n                                <mat-select [(ngModel)]=\"selectedKvmHost\">\n                                    <mat-select-trigger>\n                                        {{\n                                          selectedKvmHost === 'auto_select'\n                                            ? 'Auto Select'\n                                            : selectedKvmHost?.ip\n                                        }}\n                                    </mat-select-trigger>                     \n                                    <mat-option value=\"auto_select\">\n                                        Auto Select\n                                    </mat-option>                            \n                                    <mat-option *ngFor=\"let host of kvmHosts\" [value]=\"host\">                            \n                                        <div class=\"host-option\">                            \n                                            <div class=\"host-option__header\">\n                                                <span class=\"host-status-dot\" [ngClass]=\"getMemoryBadgeClass(host?.usage_data?.memory)\"></span>                            \n                                                <span class=\"host-ip\">\n                                                    {{ host.ip }}\n                                                </span>\n                                            </div>                            \n                                            <div *ngIf=\"host?.usage_data\" class=\"host-option__details\">                            \n                                                <span>\n                                                    Memory Utilisation: {{ host.usage_data.memory }}%\n      