sError = this.data.migrationData.hostsError || '';\n    }\n  }\n\n  toggleAdvancedOptions() {\n    this.showAdvancedOptions = !this.showAdvancedOptions;\n  }\n    \n    onNoClick(): void {\n      if(this.showComment){\n        this.commentAction.emit(null)\n      }\n      this.dialogRef.close();\n  }\n\n  confirm() {\n    this.spin = true;\n    if(this.showComment){\n      this.commentAction.emit(this.displayComment)\n    }\n    else{\n      // For migration, emit the migration data\n      if (this.data.isMigration) {\n        // Determine migration type based on advanced options and host selection\n        const hasSelectedHost = this.selectedKvmHost && this.selectedKvmHost !== \"auto_select\";\n        \n        const migrationPayload = {\n          migrationType: hasSelectedHost ? 'custom' : 'random',\n          selectedHost: hasSelectedHost ? this.selectedKvmHost : null\n        };\n        this.confirmAction.emit(migrationPayload);\n      } else {\n        this.confirmAction.emit(true);\n      }\n    }\n  }\n\n  download(){\n    this.csvDownloadService.downloadTextFile(this.data.modalContent,'credentials')\n    \n  }\n\n  getMemoryBadgeClass(memory: number): string {\n    if (memory > 70) {\n      return 'status-critical';\n    }\n  \n    if (memory >= 40) {\n      return 'status-warning';\n    }\n  \n    return 'status-good';\n  }\n\n}\n","<div class=\"heading-main\">\n    \n    <!-- <mat-icon class=\"close\" (click)=\"onNoClick()\" title=\"Close\">close</mat-icon> -->\n    <span class=\"heading-close-dialog\">{{data.title}}</span>\n    <span class=\"material-icons-outlined close\" (click)=\"onNoClick()\" title=\"Close\">cancel</span>\n\n</div>\n\n<div mat-dialog-content>\n    <div class=\"modal-content\">\n        <div class=\"float-left warning\" *ngIf=\"!data.onlyDisplay\">\n            <mat-icon class=\"warning-icon \" title=\"Close\">warning</mat-icon>\n        </div>\n        <div class=\"float-left content\">\n            <div class=\"modal-content-main